/*
 * Characterisation test for ParamUtils.validateAddCycle's --outdir/--prior_outdir
 * guard, plus (fix round 1) the add_cycle branch's unknown-column warning.
 *
 * add_cycle writes csv/registered.csv via collectFile(storeDir:), which OVERWRITES.
 * If a user pointed --outdir at the very directory named by --prior_outdir, that
 * write would clobber the prior run's complete registered.csv with add_cycle's
 * partial one, while csv/postprocessed.csv (untouched by add_cycle) survives
 * untouched -- leaving --prior_outdir internally inconsistent and the prior run
 * unrecoverable. docs/add_cycle.md has always said to use a fresh --outdir; nothing
 * enforced it until now.
 *
 * The check compares CANONICAL paths, not raw strings, so it must still fire when
 * the two flags spell the same directory differently (trailing slash, a `.`
 * segment) -- a bare string compare would miss exactly that case.
 *
 * This is also the only nf-test file that runs `main.nf` end to end with
 * mode='add_cycle' under -stub (tests/subworkflows/add_cycle.nf.test targets the
 * ADD_CYCLE subworkflow directly, so it never reaches workflows/mirage.nf's
 * add_cycle branch at all) -- which is why the unknown-column warning case below
 * lives here rather than in a file whose name suggests it, despite being a
 * different concern from the --outdir/--prior_outdir guard above.
 *
 * Tagged "stub" because CI's blocking gate is `nf-test test --tag stub`.
 */

nextflow_pipeline {

    name "add_cycle: --outdir must not equal --prior_outdir"
    script "main.nf"

    tag "pipeline"
    tag "add_cycle_validation"

    test("Should reject --outdir == --prior_outdir (same path, different spelling)") {
        tag "stub"
        options "-stub"

        when {
            params {
                input        = "$projectDir/tests/testdata/new_cycle.csv"
                // Same directory as prior_outdir, spelled with a trailing '/.' --
                // proves the comparison is canonical, not a raw string compare.
                outdir       = "$projectDir/tests/testdata/prior_run/."
                mode         = 'add_cycle'
                prior_outdir = "$projectDir/tests/testdata/prior_run"
            }
        }

        then {
            def report = (workflow.stdout + workflow.stderr).join('\n') + (workflow.errorReport ?: '') + (workflow.errorMessage ?: '')
            assertAll(
                { assert workflow.failed },
                { assert report.contains("--outdir") },
                { assert report.contains("--prior_outdir") }
            )
        }
    }

    test("Should accept --outdir != --prior_outdir") {
        tag "stub"
        options "-stub"

        when {
            params {
                input        = "$projectDir/tests/testdata/new_cycle.csv"
                outdir       = "$outputDir"
                mode         = 'add_cycle'
                prior_outdir = "$projectDir/tests/testdata/prior_run"
            }
        }

        then {
            assert workflow.success
        }
    }

    test("Should warn, naming an unknown column, on a new-cycle samplesheet") {
        tag "stub"
        options "-stub"

        // new_cycle_extra_column.csv is new_cycle.csv plus one unknown column,
        // `operator` (generate_complete_testdata.py section 3f). Before fix round
        // 1, workflows/mirage.nf's add_cycle branch called
        // CsvUtils.validateInputCSV(params.input,
        // ParamUtils.requiredColumnsForStep('preprocessing')) exactly like the
        // linear path, but nothing after it warned -- warnUnknownColumns was
        // wired into the linear start/stop path only. A mistyped column in a
        // new-cycle samplesheet stayed silent on this path specifically.
        when {
            params {
                input        = "$projectDir/tests/testdata/new_cycle_extra_column.csv"
                outdir       = "$outputDir"
                mode         = 'add_cycle'
                prior_outdir = "$projectDir/tests/testdata/prior_run"
            }
        }

        then {
            // The message is a log.warn, emitted from workflows/mirage.nf before
            // INPUT_CHECK ever runs. nf-test launches Nextflow with -quiet unless
            // nf-test itself is run with --verbose, and under -quiet Nextflow 25
            // AND 26 drop log.warn from the console streams entirely -- so this
            // reads the run log too, exactly as tests/main.nf.test's
            // "Should name the trace path it looked for..." case does:
            // <launchDir>/meta/nextflow.log carries the line even when
            // workflow.stdout/stderr do not.
            def runLog = new File("${launchDir}/meta/nextflow.log")
            def said = workflow.stdout + workflow.stderr +
                       (runLog.exists() ? runLog.readLines() : [])
            assertAll(
                { assert workflow.success },
                { assert said.any { it.contains('operator') },
                    "the run did not name the unknown column: " + said.join(' | ') }
            )
        }
    }
}
