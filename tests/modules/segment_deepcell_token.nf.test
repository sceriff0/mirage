nextflow_process {

    name "Test SEGMENT does not leak DEEPCELL_ACCESS_TOKEN into .command.run"
    script "modules/local/segment.nf"
    process "SEGMENT"

    tag "modules"
    tag "modules_local"
    tag "segment"
    // Not tagged "stub": it needs `-profile test,singularity`, and Nextflow rejects a
    // duplicate `-profile`, so CI's `--tag stub --profile test` sweep cannot run it.
    // Run explicitly:
    //   DEEPCELL_ACCESS_TOKEN=dummy-token-value nf-test test \
    //     tests/modules/segment_deepcell_token.nf.test --profile test,singularity
    tag "security"

    test("Should forward DEEPCELL_ACCESS_TOKEN by name only under Singularity - stub") {

        // The Singularity containerOptions branch of `withName: 'SEGMENT'` must forward the
        // secret by name (singularity.envWhitelist), never interpolate its value into
        // .command.run, which is group-readable on a shared filesystem and kept across -resume.
        // Needs DEEPCELL_ACCESS_TOKEN in the environment launching nf-test and
        // seg_method='cellsam', or the branch is never reached and this asserts nothing.

        options "-stub -c ${projectDir}/tests/modules/segment_deepcell_token_singularity.config"

        when {
            params {
                seg_method = 'cellsam'
                seg_gpu    = false
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            assert System.getenv('DEEPCELL_ACCESS_TOKEN'),
                "DEEPCELL_ACCESS_TOKEN must be set in the environment for this test to " +
                "reach the guarded branch -- run as: " +
                "DEEPCELL_ACCESS_TOKEN=dummy-token-value nf-test test " +
                "tests/modules/segment_deepcell_token.nf.test --profile test,singularity"

            // The task fails afterwards (no singularity binary to exec), but .command.run is
            // written before that, which is all this test needs.
            def commandRunFiles = new File(new File(outputDir).parentFile, 'work')
                .listFiles()
                .collectMany { shard -> shard.listFiles()?.toList() ?: [] }
                .collect { new File(it, '.command.run') }
                .findAll { it.exists() }

            assert commandRunFiles.size() == 1
            def commandRunText = commandRunFiles[0].text
            def tokenValue = System.getenv('DEEPCELL_ACCESS_TOKEN')

            assertAll(
                { assert commandRunText.contains('singularity exec') },
                // The secret's value must never be written to disk. Not a check for
                // 'DEEPCELL_ACCESS_TOKEN=': envWhitelist legitimately renders
                // `SINGULARITYENV_DEEPCELL_ACCESS_TOKEN="$DEEPCELL_ACCESS_TOKEN"`, a shell reference.
                { assert !commandRunText.contains(tokenValue) },
                // Forwarded by name, like Docker's `-e VAR`: the value is read from the shell
                // environment at run time.
                { assert commandRunText.contains('SINGULARITYENV_DEEPCELL_ACCESS_TOKEN="$DEEPCELL_ACCESS_TOKEN"') },
                // No value interpolation from containerOptions (`--env DEEPCELL_ACCESS_TOKEN=<value>`
                // without the SINGULARITYENV_ prefix).
                { assert !commandRunText.contains("--env DEEPCELL_ACCESS_TOKEN=") }
            )
        }
    }
}
