nextflow_process {

    name "Test MERGE_AND_PYRAMID process"
    script "modules/local/merge_and_pyramid.nf"
    process "MERGE_AND_PYRAMID"

    tag "modules"
    tag "modules_local"
    tag "merge_and_pyramid"

    test("Should create pyramidal OME-TIFF - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                pixel_size = 0.325
                pyramid_resolutions = 8
                pyramid_scale = 2
                tilex = 512
                compression = 'zstd'
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    [
                        file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_PANCK.tif', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_SMA.tif', checkIfExists: true)
                    ],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.pyramid },
                { assert process.out.versions },
                { with(process.out.pyramid) {
                    assert size() == 1
                    assert get(0).get(0).patient_id == 'P001'
                    assert get(0).get(1).toString().endsWith('pyramid.ome.tiff')
                }}
            )
        }
    }

    test("Should handle multi-channel input - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                pixel_size = 0.325
                pyramid_resolutions = 8
                pyramid_scale = 2
                tilex = 512
                compression = 'zstd'
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    [
                        file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_PANCK.tif', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_SMA.tif', checkIfExists: true)
                    ],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.pyramid }
            )
        }
    }

    test("Should preserve metadata through process - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                pixel_size = 0.325
                pyramid_resolutions = 8
                pyramid_scale = 2
                tilex = 512
                compression = 'zstd'
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P002',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK'],
                        custom_field: 'preserved'
                    ],
                    [
                        file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_PANCK.tif', checkIfExists: true)
                    ],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { with(process.out.pyramid) {
                    assert get(0).get(0).patient_id == 'P002'
                    assert get(0).get(0).channels == ['DAPI', 'PANCK']
                    assert get(0).get(0).custom_field == 'preserved'
                }}
            )
        }
    }

    test("Should emit versions.yml with tifffile/numpy - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                pixel_size = 0.325
                pyramid_resolutions = 8
                pyramid_scale = 2
                tilex = 512
                compression = 'zstd'
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    [
                        file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_PANCK.tif', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_SMA.tif', checkIfExists: true)
                    ],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.versions },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("Should render the five pyramid tunables and no --masks-dir - rendered command") {

        // No options "-stub": stub mode never evaluates script:, so this is the only
        // tag-"stub" case that reaches the rendered command. Uses this file's own
        // three-channel stub input, with masks empty.
        tag "stub"

        when {
            params {
                outdir = "$outputDir"
                pixel_size = 0.325
                pyramid_resolutions = 8
                pyramid_scale = 2
                tilex = 512
                compression = 'zstd'
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    [
                        file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_PANCK.tif', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_SMA.tif', checkIfExists: true)
                    ],
                    []
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('merge_channels_pyramid.py'))
                    rendered << f.text
            }

            assertAll(
                { assert rendered.size() >= 1 },
                { assert rendered.every { it.contains('--physical-size-x 0.325') && it.contains('--physical-size-y 0.325') }, rendered.join(' --- ') },
                { assert rendered.every { it.contains('--pyramid-resolutions 8') }, rendered.join(' --- ') },
                { assert rendered.every { it.contains('--pyramid-scale 2') }, rendered.join(' --- ') },
                { assert rendered.every { it.contains('--tile-size 512') }, rendered.join(' --- ') },
                { assert rendered.every { it.contains('--compression zstd') }, rendered.join(' --- ') },
                { assert rendered.every { it.contains('--input-dir channels') && it.contains('--output pyramid.ome.tiff') }, rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--masks-dir') }, "no masks in -> no --masks-dir: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should render --masks-dir when a mask file is staged - rendered command") {

        tag "stub"

        when {
            params {
                outdir = "$outputDir"
                pixel_size = 0.325
                pyramid_resolutions = 8
                pyramid_scale = 2
                tilex = 512
                compression = 'zstd'
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    [
                        file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_PANCK.tif', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_SMA.tif', checkIfExists: true)
                    ],
                    [
                        file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('merge_channels_pyramid.py'))
                    rendered << f.text
            }

            assertAll(
                { assert rendered.size() >= 1 },
                { assert rendered.every { it.contains('--masks-dir masks') }, rendered.join(' --- ') }
            )
        }
    }

    test("Should create pyramidal OME-TIFF from 3 channels - real") {

        tag "real"
        tag "slow"

        when {
            params {
                outdir = "$outputDir"
                pixel_size = 0.325
                pyramid_resolutions = 3
                pyramid_scale = 2
                tilex = 128
                compression = 'zstd'
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    [
                        file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_PANCK.tif', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_SMA.tif', checkIfExists: true)
                    ],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.pyramid },
                { assert process.out.versions },
                // Meta preservation
                { assert process.out.pyramid.get(0).get(0).patient_id == 'P001' },
                { assert process.out.pyramid.get(0).get(0).is_reference == true },
                { assert process.out.pyramid.get(0).get(0).channels == ['DAPI', 'PANCK', 'SMA'] },
                // Output file is non-trivial and has correct name
                { assert file(process.out.pyramid.get(0).get(1)).size() > 1000 },
                { assert file(process.out.pyramid.get(0).get(1)).name.endsWith('pyramid.ome.tiff') }
            )
        }
    }

    test("Should accept a ONE-channel group - stub") {

        // conf/modules.config's memory closure calls
        // `split_channels.collect { it.size() }`. With one file in the group,
        // Nextflow binds `split_channels` to a bare Path rather than a List --
        // and `.collect{}` on a Path iterates its NAME ELEMENTS, so `it.size()`
        // went looking for a file literally called "channels" and the run
        // ABORTED with "No such file or directory: channels".
        //
        // A one-channel patient is an ordinary input, not a pathological one:
        // subworkflows/local/quantify_markers.nf groups one-tiff-per-marker
        // entries per patient, and a panel with a single marker produces a
        // group of one. Every other test in this file passes 2 or 3 files,
        // which is why the whole suite was green.
        //
        // This test only reaches the defect because nf-test.config sets
        // configFile = "nextflow.config", so conf/modules.config's withName
        // block -- and therefore the closure -- is actually evaluated here.

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                pixel_size = 0.325
                pyramid_resolutions = 8
                pyramid_scale = 2
                tilex = 512
                compression = 'zstd'
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI']
                    ],
                    [
                        file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true)
                    ],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.pyramid },
                { with(process.out.pyramid) {
                    assert size() == 1
                    assert get(0).get(0).channels == ['DAPI']
                }}
            )
        }
    }

    test("Should produce pyramid file significantly larger than sum of inputs - regression") {

        tag "real"
        tag "slow"
        tag "regression"

        when {
            params {
                outdir = "$outputDir"
                pixel_size = 0.325
                pyramid_resolutions = 3
                pyramid_scale = 2
                tilex = 128
                compression = 'zstd'
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    [
                        file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_PANCK.tif', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_SMA.tif', checkIfExists: true)
                    ],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // Pyramid should contain multiple resolution levels (multi-resolution OME-TIFF)
                // File should be substantial — at least 10KB for 128x128 with 3 channels + 3 pyramid levels
                {
                    def pyramidSize = file(process.out.pyramid.get(0).get(1)).size()
                    assert pyramidSize > 10_000, "Pyramid OME-TIFF should be > 10KB, got ${pyramidSize} bytes"
                },
                // Size log should have been generated with non-zero input size
                {
                    def sizeLogFile = process.out.size_log.get(0)
                    def content = path(sizeLogFile).text
                    assert content.contains('MERGE_AND_PYRAMID'), "Size log should reference process name"
                    assert content.contains('P001'), "Size log should reference patient ID"
                }
            )
        }
    }
}
