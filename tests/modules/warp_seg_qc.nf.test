nextflow_process {

    name "Test WARP_SEG_QC process"
    script "modules/local/warp_seg_qc.nf"
    process "WARP_SEG_QC"

    tag "modules"
    tag "modules_local"
    tag "warp_seg_qc"

    test("Should emit a staged seg-qc JSON with a stage checkpoint - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                // [meta, method, transform, ref_slide, moving_slide, ref_geojson, moving_geojson, stage_checkpoint]
                input[0] = [
                    [ patient_id: 'P001' ],
                    'valis',
                    file('$projectDir/tests/testdata/single_sample.csv', checkIfExists: true),
                    'P001_ref_corrected',
                    'P001_mov1_corrected',
                    file('$projectDir/tests/testdata/sample_contours.json', checkIfExists: true),
                    file('$projectDir/tests/testdata/sample_merged_quant.csv', checkIfExists: true),
                    file('$projectDir/tests/testdata', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.metrics
            assert process.out.versions
            with(process.out.metrics) {
                assert size() == 1
                assert get(0).get(0).patient_id == 'P001'
                assert get(0).get(1).toString().endsWith('_seg_qc.json')
            }
        }
    }

    test("Should run without a stage checkpoint - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                // An empty list is how an absent checkpoint reaches the process: REGISTER only
                // emits one at reg_qc >= 2, and a failed snapshot must cost the run one stage,
                // not remove the patient from the QC. See ch_ckpt_by_patient in registration.nf.
                // The tiled backend also reaches this same shape -- it never has a checkpoint.
                input[0] = [
                    [ patient_id: 'P001' ],
                    'valis',
                    file('$projectDir/tests/testdata/single_sample.csv', checkIfExists: true),
                    'P001_ref_corrected',
                    'P001_mov1_corrected',
                    file('$projectDir/tests/testdata/sample_contours.json', checkIfExists: true),
                    file('$projectDir/tests/testdata/sample_merged_quant.csv', checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.metrics
            with(process.out.metrics) {
                assert size() == 1
                assert get(0).get(1).toString().endsWith('_seg_qc.json')
            }
        }
    }

    test("Should dispatch the tiled backend - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ patient_id: 'P001' ],
                    'tiled',
                    file('$projectDir/tests/testdata/single_sample.csv', checkIfExists: true),
                    'P001_ref_corrected',
                    'P001_mov1_corrected',
                    file('$projectDir/tests/testdata/sample_contours.json', checkIfExists: true),
                    file('$projectDir/tests/testdata/sample_merged_quant.csv', checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.metrics
            with(process.out.metrics) {
                assert size() == 1
                assert get(0).get(1).toString().endsWith('_seg_qc.json')
            }
        }
    }

    test("Should render backend-specific flags in the real command, not the stub - rendered command") {

        // Tagged `stub` so CI's blocking `nf-test test --tag stub` gate runs it, but
        // deliberately WITHOUT `options "-stub"` -- same shape as
        // tests/modules/seg_qc_geojson.nf.test's "rendered command" case (Group C Task 3).
        // `-stub` never evaluates a `script:` block, so no stub run can observe a rendered
        // command at all -- and this task made the rendered command METHOD-DEPENDENT for
        // the first time (container, flags, versionTools all come from
        // lib/WarpBackends.groovy keyed on the `method` input), which is exactly the
        // change `-stub` is blind to.
        //
        // No container engine is active under `--profile test` (docker.enabled is only
        // true in the `docker` profile, which this suite is told never to combine with
        // `test` on this arm64 machine), so this runs warp_seg_qc.py directly on the host
        // and it will fail for unrelated environmental reasons (no such binary on PATH,
        // possibly missing VALIS/scikit-image). That is fine: like
        // seg_qc_geojson.nf.test's rendered-command case, the assertions read the
        // rendered .command.sh rather than the process outcome.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [ patient_id: 'P001' ],
                    'valis',
                    file('$projectDir/tests/testdata/single_sample.csv', checkIfExists: true),
                    'P001_ref_corrected',
                    'P001_mov1_corrected',
                    file('$projectDir/tests/testdata/sample_contours.json', checkIfExists: true),
                    file('$projectDir/tests/testdata/sample_merged_quant.csv', checkIfExists: true),
                    file('$projectDir/tests/testdata', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('warp_seg_qc.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered WARP_SEG_QC .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--micro-reg') },
                    "valis rendered command missing --micro-reg: " + rendered.join(' --- ') },
                // the frame REGISTER writes the slides in; never left to warp_seg_qc's default
                { assert rendered.every { it.contains('--crop reference') },
                    "valis rendered command missing --crop reference: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains("--checkpoint-dir") },
                    "valis rendered command missing --checkpoint-dir: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--method') },
                    "valis rendered command must not carry --method (tiled-only flag): " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('valis: $(python -c "import valis;') },
                    "valis rendered versions.yml missing the valis probe row: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should render --method tiled and no VALIS-only flags for the tiled backend - rendered command") {

        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [ patient_id: 'P001' ],
                    'tiled',
                    file('$projectDir/tests/testdata/single_sample.csv', checkIfExists: true),
                    'P001_ref_corrected',
                    'P001_mov1_corrected',
                    file('$projectDir/tests/testdata/sample_contours.json', checkIfExists: true),
                    file('$projectDir/tests/testdata/sample_merged_quant.csv', checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('warp_seg_qc.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered WARP_SEG_QC .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--method tiled') },
                    "tiled rendered command missing --method tiled: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--micro-reg') },
                    "tiled rendered command must not carry --micro-reg (valis-only flag): " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--checkpoint-dir') },
                    "tiled rendered command must not carry --checkpoint-dir (valis-only flag): " + rendered.join(' --- ') },
                // --jvm-heap-gb is VALIS's own JVM-heap knob (the tiled container is
                // JVM-free); it must be structurally impossible to leak here regardless of
                // params.registration_method, not merely absent by default -- see
                // lib/WarpBackends.groovy's class header for why this used to be an
                // ext.args ternary keyed on the global param instead of the `method` input.
                { assert rendered.every { !it.contains('--jvm-heap-gb') },
                    "tiled rendered command must not carry --jvm-heap-gb (valis-only flag): " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('valis: $(python') },
                    "tiled rendered versions.yml must not carry the valis probe row: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should render the pairing flags from ext.args - rendered command") {

        // Tagged `stub` for CI's blocking gate, deliberately WITHOUT `options "-stub"`:
        // a stub run never evaluates `script:`, so it cannot observe an ext.args change at
        // all. Same shape as the two rendered-command tests above. The task will fail for
        // environmental reasons (no container engine under `--profile test`); the
        // assertions read .command.sh, not the process outcome.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [ patient_id: 'P001' ],
                    'valis',
                    file('$projectDir/tests/testdata/single_sample.csv', checkIfExists: true),
                    'P001_ref_corrected',
                    'P001_mov1_corrected',
                    file('$projectDir/tests/testdata/sample_contours.json', checkIfExists: true),
                    file('$projectDir/tests/testdata/sample_merged_quant.csv', checkIfExists: true),
                    file('$projectDir/tests/testdata', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('warp_seg_qc.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered WARP_SEG_QC .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--pairing lsa') },
                    "rendered command missing --pairing lsa: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--match-radius-factor 1.5') },
                    "rendered command missing --match-radius-factor 1.5: " + rendered.join(' --- ') }
            )
        }
    }
}
