                ])
                input[6] = Channel.fromList([
                    [[patient_id: 'P001'], file('$projectDir/tests/testdata/sample_reg_qc.json')]
                ])
                input[7] = Channel.fromList([
                    [[patient_id: 'P001'], file('$projectDir/tests/testdata/sample_reg_residuals.csv')]
                ])
                input[8] = ParamUtils.compartmentMode(params)
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert !workflow.trace.tasks().any { it.name.contains('EXPORT_SPATIALDATA') },
