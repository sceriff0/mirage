    test("Should reject an unknown seg_method rather than silently run StarDist - stub") {

        // Stub is sufficient here, unusually: the throw comes from SegBackends.of() in
        // the `container` DIRECTIVE, which Nextflow evaluates for every task whichever
        // block runs. The stub block itself never touches SegBackends, so what this case
        // pins is the directive, not the script.
        tag "stub"
        options "-stub"

        when {
            params {
                // A plausible typo. The old nested `container` ternary treated anything
                // that was not 'cellsam' or 'instantseg' as StarDist, so this ran a
                // different segmenter than asked for -- either dying later on StarDist's
                // channel-0 check with an error naming the wrong problem, or succeeding
                // with the wrong algorithm. seg_method has no schema enum, so
                // SegBackends.of() is the only place the typo can be caught.
                seg_method = 'instaseg'
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            assert process.failed
        }
    }

    test("Should enforce the CONFIGURED nuclear marker, not the literal DAPI - real") {

        // Real (not stub): like its sibling above, the channel-0 hard check lives in the
        // script block, which a stub does not execute. It exits before Python runs, so
        // this costs a container start and nothing else.
        tag "real"
        tag "slow"

        when {
            params {
                // The inversion that proves the literal 'DAPI' is gone. Channel 0 IS
                // DAPI, which the old hardcoded check accepted unconditionally -- but
                // DAPI is not one of the CONFIGURED markers here, so StarDist would be
                // pointed at the wrong channel and must refuse.
                //
                // This is the site that turned Task 3's relaxed launch validation into a
                // later, less legible failure in the other direction too: a
                // CELLTOX-configured sheet passed validation, CONVERT_IMAGE correctly
                // moved CELLTOX to channel 0, and then SEGMENT rejected it for not
                // being DAPI.
                nuclear_markers = ['CELLTOX']
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            assert process.failed
            assert process.exitStatus == 1
        }
    }

    test("Should detect cells in synthetic image with DAPI signal - regression") {

        tag "real"
        tag "slow"
        tag "regression"

        // Segments P001_seg_nuclei.ome.tiff, NOT the P001_ref.ome.tiff the rest of
        // this file uses. P001_ref's DAPI channel is 40 gaussian blobs of radius
        // 6-13 packed into 128x128 and merged with np.maximum: measured on the
        // generated file, 37.7% of the frame is foreground and it forms exactly ONE
        // connected component. There are no separate nuclei in it to find, so
        // StarDist's 2D_versatile_fluo returned nothing and this case got a 145-byte
        // (all-zero) mask on nightly 33633986188. That density is deliberate -- it is
        // what gives VALIS the shared texture the REGISTER cases need -- so
        // segmentation got its own image instead (generate_complete_testdata.py
        // section 10: 45 nuclei, 10-18 px across, none touching, asserted at
        // generation time).
        //
        // `seg_model` was set here and is not a parameter this pipeline has -- the
        // model name comes from `segmentation_model`, which conf/test.config already
        // pins to the same built-in. The line selected nothing; it is spelled
        // correctly now so the case says what it runs on.
        when {
            params {
                segmentation_model = "2D_versatile_fluo"
                seg_gpu = false
                seg_n_tiles_y = 1
                seg_n_tiles_x = 1
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_seg_nuclei.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // Cell mask should have non-trivial size (actual segmentation, not empty)
                {
                    def maskSize = file(process.out.cell_mask.get(0).get(1)).size()
                    assert maskSize > 1000, "Cell mask should be > 1KB (got ${maskSize} bytes), indicating actual segmentation"
                },
                // Nuclei mask should also be non-trivial
                {
                    def maskSize = file(process.out.nuclei_mask.get(0).get(1)).size()
                    assert maskSize > 1000, "Nuclei mask should be > 1KB (got ${maskSize} bytes)"
                },
                // Size log should have been generated
                { assert process.out.size_log }
            )
        }
    }

    test("Should render the backend's versions.yml probes, not a seg_method row - rendered command") {

        // Tagged `stub` so CI's blocking `nf-test test --tag stub` gate runs it, but
        // deliberately WITHOUT `options "-stub"`. That is the entire point of this case:
        // `-stub` never evaluates a `script:` block, so the stub cases above -- however
        // thorough -- say nothing about the versions.yml a REAL run writes. The heredoc
        // this task replaced lived only in `script:`, which means every assertion that
        // could see it had to be a rendered-command assertion. Same shape and same reason
        // as tests/modules/generate_qc_report.nf.test's `-rendered command` case.
        //
        // SEGMENT is not runnable without its container, and that is fine: the assertions
        // read the rendered .command.sh, which Nextflow writes before it executes
        // anything, so this case holds whether the task succeeds or dies importing
        // tensorflow. It asserts nothing about process outcome for exactly that reason.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            // Nextflow lays tasks out as <workDir>/<2 hex>/<30 hex>/.command.sh.
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('.SEGMENT.size.csv')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered SEGMENT .command.sh found under the task work dir" },

                // The `test` profile pins seg_method='stardist', so the rendered command
                // must carry StarDist's one probe -- the row ProcessEnvelope built from
                // SegBackends' versionTools list, byte-for-byte what the hand-written
                // heredoc used to contain. `deepcell` was removed from that list
                // 2026-09-02 (it was a phantom -- no image installs it, and StarDist has
                // nothing to do with DeepCell); its absence is asserted below, alongside
                // `torch`, as one of the "negative with teeth" checks.
                { assert rendered.every {
                    it.contains('tensorflow: $(python -c "import tensorflow; print(tensorflow.__version__)" 2>/dev/null || echo "unknown")') },
                    "rendered command: " + rendered.join(' --- ') },

                // The shared `python:` row ProcessEnvelope prepends, with a BARE `$(`.
                // `<<-END_VERSIONS` is an unquoted heredoc, so bash command-substitutes a
                // bare `$(...)` and prints an escaped `\$(...)` as literal text -- the
                // over-escaping bug that once wrote shell commands into every published
                // versions.yml, invisibly, because -stub never runs script:.
                { assert rendered.every { it.contains('python: $(python --version 2>&1 | sed \'s/Python //\')') },
                    "rendered command: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('\\$(python') },
                    "versions probe is escaped, so bash prints it instead of running it: " + rendered.join(' --- ') },

                // And the heredoc is still a heredoc: one open, one terminator.
                { assert rendered.every { it.contains('cat <<-END_VERSIONS > versions.yml') },
                    "rendered command: " + rendered.join(' --- ') },

                // The negative with teeth. `seg_method` is not a tool and no real run ever
                // reported it -- it existed ONLY in the stub heredoc. Its appearance in a
                // rendered command means the two blocks are being maintained separately
                // again. Likewise the other backends' tools: exactly one backend runs.
                { assert rendered.every { !it.contains('seg_method:') },
                    "rendered command carries the stub-only seg_method row: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('import torch') },
                    "StarDist run reports a torch version it never loaded: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('import deepcell') },
                    "StarDist run reports a deepcell version -- a phantom no image " +
                    "installs and StarDist has nothing to do with: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should render the inlined StarDist flag string, in order - rendered command") {

        // Tagged `stub` so CI's blocking `nf-test test --tag stub` gate runs it, but
        // deliberately WITHOUT `options "-stub"` -- `-stub` never evaluates a `script:`
        // block, and ext.args is only interpolated there, so no stub run can observe
        // these flags at all. Same shape and same reason as the versions.yml case above.
        //
        // THIS IS THE CASE THAT PINS THE INLINING. The StarDist flag list used to be a
        // `def starDistCommonFlags(params)` at the top of conf/modules.config; Nextflow
        // 26's strict (v2) parser rejects a function declaration in a config file, so the
        // list was inlined into the `withName: 'SEGMENT'` ext.args closure. Nothing about
        // that move is observable from a stub run, from `nextflow config` (which prints a
        // closure's SOURCE, not its evaluation), or from the process outputs -- only from
        // the rendered command. The assertion is the whole string, contiguous, so a
        // dropped flag AND a reordered one both fail.
        //
        // Values are the `test` profile's (conf/test.config): seg_method='stardist',
        // segmentation_model='2D_versatile_fluo', seg_n_tiles_y/x=2, seg_prob_thresh=0.3,
        // seg_gpu=false, segmentation_model_dir=null; seg_expand_distance=10,
        // seg_pmin=1.0, seg_pmax=99.8 from nextflow.config. A profile change is a test diff.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('.SEGMENT.size.csv')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered SEGMENT .command.sh found under the task work dir" },

                // The flag string, whole and contiguous. Order is part of the contract
                // only because preserving it byte-for-byte is what makes the inlining a
                // no-op; segment.py itself does not care.
                { assert rendered.every { it.contains(
                    '--model-name 2D_versatile_fluo --n-tiles 2 2 --expand-distance 10 ' +
                    '--pmin 1.0 --pmax 99.8 --prob-thresh 0.3') },
                    "rendered StarDist flags changed: " + rendered.join(' --- ') },

                // The two conditional branches, in their false state under this profile.
                { assert rendered.every { !it.contains('--model-dir') },
                    "segmentation_model_dir is null but --model-dir was rendered: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--use-gpu') },
                    "seg_gpu is false but --use-gpu was rendered: " + rendered.join(' --- ') },

                // Another backend's vocabulary in a stardist run means the ext.args map
                // lost its keying on params.seg_method.
                { assert rendered.every { !it.contains('--pixel-size') && !it.contains('--bbox-threshold') },
                    "rendered command carries a non-StarDist backend's flags: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should render the CellSAM knobs - rendered command") {

        // Copy of "Should render the inlined StarDist flag string, in order", switched
        // to seg_method='cellsam' to name seg_cellsam_bbox_threshold, seg_cellsam_overlap
        // and seg_cellsam_use_wsi (conf/modules.config:1047-1056). `stub` tag but NO
        // `options "-stub"` -- ext.args is only interpolated in script:, invisible to -stub.
        tag "stub"

        when {
            params {
                seg_method = 'cellsam'
                seg_cellsam_bbox_threshold = 0.42
                seg_cellsam_overlap = 0.25
                seg_cellsam_use_wsi = true
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('.SEGMENT.size.csv')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered SEGMENT .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--bbox-threshold 0.42') },
                    "rendered command missing --bbox-threshold: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--overlap 0.25') },
                    "rendered command missing --overlap: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--use-wsi') },
                    "rendered command missing --use-wsi despite seg_cellsam_use_wsi=true: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should render the InstanSeg batch-size knob - rendered command") {

        // Copy of "Should render the inlined StarDist flag string, in order", switched
        // to seg_method='instantseg' to name seg_instantseg_batch_size
        // (conf/modules.config:1033-1045). `stub` tag but NO `options "-stub"`.
        tag "stub"

        when {
            params {
                seg_method = 'instantseg'
                seg_instantseg_batch_size = 7
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('.SEGMENT.size.csv')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered SEGMENT .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--batch-size 7') },
                    "rendered command missing --batch-size: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should omit --use-wsi when seg_cellsam_use_wsi is false - rendered command") {

        // Third CellSAM case: seg_cellsam_use_wsi's shipped default (nextflow.config) is
        // `true`, so the positive case above only shows it explicitly named at the
        // default value -- this is the case that actually flips the ternary
        // (conf/modules.config:1054, `params.seg_cellsam_use_wsi ? '--use-wsi' : ''`).
        tag "stub"

        when {
            params {
                seg_method = 'cellsam'
                seg_cellsam_use_wsi = false
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('.SEGMENT.size.csv')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered SEGMENT .command.sh found under the task work dir" },
                { assert rendered.every { !it.contains('--use-wsi') },
                    "rendered command carries --use-wsi despite seg_cellsam_use_wsi=false: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should render --model-dir and drop --prob-thresh when configured so - rendered command") {

        // The other state of both conditionals, which the case above cannot reach: the
        // inlined list keeps `params.segmentation_model_dir ? ... : ''` and
        // `params.seg_prob_thresh != null ? ... : ''`, and a rewrite that flattened either
        // into an unconditional flag would still pass the case above.
        //
        // Same tagging rationale: `stub` for CI's gate, no `options "-stub"`.
        tag "stub"

        when {
            params {
                segmentation_model_dir = '/opt/models/stardist'
                seg_prob_thresh        = null
                seg_gpu                = true
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('.SEGMENT.size.csv')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered SEGMENT .command.sh found under the task work dir" },
                // --model-dir leads the list, and --use-gpu is appended once AFTER the
                // backend's own flags -- it is shared by all three backends, so it is not
                // part of the StarDist list itself.
                { assert rendered.every { it.contains(
                    '--model-dir /opt/models/stardist --model-name 2D_versatile_fluo ' +
                    '--n-tiles 2 2 --expand-distance 10 --pmin 1.0 --pmax 99.8 --use-gpu') },
                    "rendered StarDist flags changed: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--prob-thresh') },
                    "seg_prob_thresh is null but --prob-thresh was rendered: " + rendered.join(' --- ') }
            )
        }
    }
}
