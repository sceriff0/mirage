nextflow_workflow {

    name "Test ADD_CYCLE subworkflow (stub)"
    script "subworkflows/local/add_cycle.nf"
    workflow "ADD_CYCLE"

    /*
     * ADD_CYCLE takes the new-cycle sample channel and rebuilds the prior run's
     * reusable assets from --prior_outdir's checkpoint CSVs. tests/testdata/prior_run/
     * is a minimal stand-in for a completed run (generate_complete_testdata.py).
     *
     * input[1] is compartment_mode. The two compartments-off tests pass a literal map
     * that conflicts with params (left at the true default), proving ADD_CYCLE honours
     * the argument; the "compartment path runs" test keeps them in agreement.
     */

    test("folds a new cycle: emits combined geojson, merged csv, and pyramid") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                // New cycle: one non-reference slide with DAPI + a new marker.
                input[0] = Channel.of([
                    [ id: 'P001_cycle2', patient_id: 'P001', is_reference: false,
                      channels: ['DAPI','CD8'], images_count: 1, channels_count: 2 ],
                    file('tests/testdata/P001_image.tiff')
                ])
                input[1] = [compartments: false, expanded: false, embedMasks: false]
                """
            }
            params {
                // quantify_compartments left at its true default; input[1] is a
                // literal with compartments: false, proving ADD_CYCLE honours the
                // argument (which gates whether EXTRACT_NUCLEI_PROPERTIES runs).
                outdir = "$outputDir"
                mode = 'add_cycle'
                prior_outdir = "$projectDir/tests/testdata/prior_run"
                reg_qc = 1
            }
        }

        then {
            assert workflow.success
            assert workflow.out.geojson
            assert workflow.out.merged_csv
            assert workflow.out.pyramid
        }
    }

    test("reg_qc=2 + expanded quantification: seg_qc emitted, compartment path runs") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'P001_cycle2', patient_id: 'P001', is_reference: false,
                      channels: ['DAPI','CD8'], images_count: 1, channels_count: 2 ],
                    file('tests/testdata/P001_image.tiff')
                ])
                input[1] = [compartments: true, expanded: true, embedMasks: false]
                """
            }
            params {
                // The positive path: input[1] agrees with params on purpose.
                outdir = "$outputDir"
                mode = 'add_cycle'
                prior_outdir = "$projectDir/tests/testdata/prior_run"
                reg_qc = 2
                quantify_compartments = true
                expanded_quantification = true
            }
        }

        then {
            assert workflow.success
            assert workflow.out.geojson
            assert workflow.out.pyramid
            assert workflow.out.seg_qc   // reg_qc=2 -> WARP_SEG_QC metrics present
        }
    }

    test("reuses the PRIOR reference: the prior run's checkpoint drives registration") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'P001_cycle2', patient_id: 'P001', is_reference: false,
                      channels: ['DAPI','CD8'], images_count: 1, channels_count: 2 ],
                    file('tests/testdata/P001_image.tiff')
                ])
                input[1] = [compartments: false, expanded: false, embedMasks: false]
                """
            }
            params {
                // quantify_compartments left at its true default; input[1] is a
                // literal with compartments: false, as in the first test.
                outdir = "$outputDir"
                mode = 'add_cycle'
                prior_outdir = "$projectDir/tests/testdata/prior_run"
                reg_qc = 1
                // ADD_CYCLE passes the literal 'valis' to REGISTER_PATIENT, never
                // params.registration_method. Calling ADD_CYCLE directly bypasses
                // workflows/mirage.nf's tiled rejection, so it is pinned here too;
                // register_patient.nf.test proves the core honours its argument.
                registration_method = 'tiled'
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Set to 'tiled' above and still not tiled: the literal wins.
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('TILED_') }.size() == 0 },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('REGISTER') }.size() == 1 },
                // The reusable masks come from the prior PYRAMID's embedded mask
                // series, not from postprocessed.csv's cell_mask column: this pins
                // that EXTRACT_MASK_SERIES really runs inside ADD_CYCLE.
                // Exactly one patient in the prior run -> one extraction, one merge.
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('EXTRACT_MASK_SERIES') }.size() == 1 },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('MERGE_QUANT_CSVS') }.size() == 1 },
                // Cell QC folds the new round onto the prior table: one retention task
                // for the one contributing new slide, one CELL_QC for the one patient.
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('NUCLEAR_RETENTION') }.size() == 1 },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('CELL_QC') }.size() == 1 },
                // tests/testdata/prior_run predates the rounds manifest: nothing is
                // staged as the prior manifest (the `[]` branch).
                {
                    def priorDirs = []
                    new File("$workDir").eachFileRecurse { f ->
                        if (f.isDirectory() && f.name == 'prior') priorDirs << f
                    }
                    assert priorDirs.isEmpty() :
                        "a prior run without <pid>_rounds.json staged ${priorDirs*.listFiles().flatten()*.name}"
                }
            )
        }
    }

    /*
     * The prior run's rounds manifest reaches CELL_QC. A copy of tests/testdata/prior_run
     * (its checkpoint CSVs carry absolute paths, so copying csv/ is enough) gains
     * P001/quantification/P001_rounds.json where CELL_QC publishes it; add_cycle.nf must
     * find it there and stage it as CELL_QC's 6th input (stageAs 'prior/*'). The same
     * task must also have staged the new slide's retention CSV -- the round join keyed on
     * [patient_id, id] matched.
     */
    test("hands the prior run's rounds manifest to CELL_QC - stub") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'P001_cycle2', patient_id: 'P001', is_reference: false,
                      channels: ['DAPI','CD8'], images_count: 1, channels_count: 2 ],
                    file('tests/testdata/P001_image.tiff')
                ])
                input[1] = [compartments: false, expanded: false, embedMasks: false]
                """
            }
            params {
                def prior = new File("$outputDir/prior_with_manifest")
                new File(prior, 'csv').mkdirs()
                ['postprocessed.csv', 'registered.csv'].each { n ->
                    new File(prior, "csv/${n}").text =
                        new File("$projectDir/tests/testdata/prior_run/csv/${n}").text
                }
                def q = new File(prior, 'P001/quantification')
                q.mkdirs()
                new File(q, 'P001_rounds.json').text =
                    '[{"round_id": "P001_old", "is_reference": false, "markers": ["PD1"]}]\n'
                outdir = "$outputDir/out"
                mode = 'add_cycle'
                prior_outdir = prior.absolutePath
                reg_qc = 1
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                {
                    def priorDirs = []
                    new File("$workDir").eachFileRecurse { f ->
                        if (f.isDirectory() && f.name == 'prior') priorDirs << f
                    }
                    assert priorDirs.size() == 1 :
                        "expected CELL_QC to stage the prior manifest once, found ${priorDirs.size()}"
                    def staged = priorDirs[0].listFiles()*.name
                    assert staged == ['P001_rounds.json']
                    def retention = new File(priorDirs[0].parentFile, 'retention').listFiles()*.name
                    assert retention == ['P001_cycle2_nuclear_retention.csv'] :
                        "CELL_QC staged retention ${retention}: the [patient_id, id] round join did not match"
                }
            )
        }
    }

    /*
     * Pins the native-image join: ch_for_qc pairs the new cycle's native image
     * (ch_new_pre) with its registered file via `.join(..., by: 0)` on meta.id. With one
     * new slide per patient a wrong key cannot cross-pair; the failure mode is join()
     * silently dropping the pair, so GENERATE_REGISTRATION_QC emits nothing while the
     * run succeeds. Finding the staged native/ file proves the join matched; its being
     * the new cycle's preprocessed output proves which slide matched.
     */
    test("Should pair the new cycle's own native image with its registered file - stub") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'P001_cycle2', patient_id: 'P001', is_reference: false,
                      channels: ['DAPI','CD8'], images_count: 1, channels_count: 2 ],
                    file('tests/testdata/P001_image.tiff')
                ])
                input[1] = [compartments: false, expanded: false, embedMasks: false]
                """
            }
            params {
                outdir = "$outputDir"
                mode = 'add_cycle'
                prior_outdir = "$projectDir/tests/testdata/prior_run"
                reg_qc = 1
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                {
                    def taskDirs = []
                    new File("$workDir").eachFileRecurse { f ->
                        if (f.isDirectory() && f.name == 'native') {
                            taskDirs << f.parentFile
                        }
                    }
                    assert taskDirs.size() == 1 :
                        "expected 1 GENERATE_REGISTRATION_QC task dir, found ${taskDirs.size()} " +
                        "-- a dropped join (wrong meta.id key on either side) leaves this at 0"

                    def nativeFiles = new File(taskDirs[0], 'native').listFiles()
                    assert nativeFiles.size() == 1 :
                        "expected exactly one staged native file, found ${nativeFiles*.name}"
                    // The staged native file is the new cycle's own preprocessed
                    // output, not the frozen prior reference (meta.id 'P001_reference').
                    assert nativeFiles[0].name.contains('P001_cycle2') :
                        "staged native file was '${nativeFiles[0].name}', expected the new " +
                        "cycle's own preprocessed output (named from meta.id 'P001_cycle2')"

                    def registeredFiles = taskDirs[0].listFiles()
                        .findAll { it.name.endsWith('_registered.ome.tiff') }
                    assert registeredFiles.size() == 1
                    assert registeredFiles[0].name.contains('CD8') :
                        "registered file staged alongside it was '${registeredFiles[0].name}', " +
                        "expected the new cycle's own DAPI_CD8 channel set"
                }
            )
        }
    }

}
