nextflow_workflow {

    name "Test POSTPROCESSING subworkflow"
    script "subworkflows/local/postprocess.nf"
    workflow "POSTPROCESSING"

    tag "subworkflow"
    tag "postprocessing"

    // POSTPROCESSING no longer runs SEGMENT / EXTRACT_CELL_PROPERTIES /
    // EXTRACT_NUCLEI_PROPERTIES itself (Task 1, arch-B-split: they moved to
    // subworkflows/local/segmentation.nf, its own resumable step). Its take:
    // grew from 3 inputs (ch_registered, ch_reg_qc, ch_reg_residuals) to 9:
    // ch_registered, ch_cell_mask, ch_nuclei_mask, ch_contours,
    // ch_nucleus_contours, ch_morphology, ch_reg_qc, ch_reg_residuals,
    // compartment_mode. Every test below now feeds pre-made mask/contours/
    // morphology fixtures for input[1..5] instead of relying on this workflow
    // to derive them, and input[8] = ParamUtils.compartmentMode(params) --
    // Task 4's seam for --quantify_compartments / --expanded_quantification /
    // --embed_masks, resolved once by workflows/mirage.nf in production and
    // threaded down the same way here.
    //
    // input[8] stays a live ParamUtils.compartmentMode(params) call rather than a
    // literal map on purpose: none of the 7 tests below overrides
    // --quantify_compartments / --expanded_quantification / --embed_masks, so there
    // is no "off" case here that a literal map would exercise any differently.
    //
    // UNVERIFIED LOCALLY: nf-test resolves -profile test,docker and hangs
    // under qemu on this host (see CLAUDE.md's "Verification reality"). Updated
    // to match the new interface but not run.

    test("Should run full postprocessing - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                seg_gpu = false
                pixel_size = 0.325
                pyramid_resolutions = 8
                pyramid_scale = 2
                tilex = 512
                compression = 'zstd'
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                input[1] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001', is_reference: true],
                     file('$projectDir/tests/testdata/P001_cell_mask.tif')]
                ])
                input[2] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001', is_reference: true],
                     file('$projectDir/tests/testdata/P001_nuclei_mask.tif')]
                ])
                input[3] = Channel.fromList([
                    ['P001', file('$projectDir/tests/testdata/sample_contours.json')]
                ])
                input[4] = Channel.fromList([
                    ['P001', file('$projectDir/tests/testdata/sample_contours.json')]
                ])
                input[5] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001', is_reference: true],
                     file('$projectDir/tests/testdata/sample_morphology.csv')]
                ])
                // Non-empty ch_reg_qc / ch_reg_residuals, shaped like
                // REGISTRATION.out.seg_qc / .out.seg_residuals ([meta, file] tuples
                // from WARP_SEG_QC), to exercise the EXPORT_SPATIALDATA fold-in path
                // in postprocess.nf (the normal full-pipeline path, not the
                // --start postprocessing shortcut covered by the other tests below).
                input[6] = Channel.fromList([
                    [[patient_id: 'P001'], file('$projectDir/tests/testdata/sample_reg_qc.json')]
                ])
                input[7] = Channel.fromList([
                    [[patient_id: 'P001'], file('$projectDir/tests/testdata/sample_reg_residuals.csv')]
                ])
                input[8] = ParamUtils.compartmentMode(params)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.checkpoint_csv },
                { assert workflow.out.postprocess_qc.size() >= 1,
                    "the QC PNG list is emitted at defaults" },
                { assert workflow.trace.tasks().any { it.name.contains('EXPORT_SPATIALDATA') } }
            )
        }
    }

    test("Should emit postprocess_qc at defaults and drop it under skip_postprocessing_qc - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                outdir = "$outputDir"
                seg_gpu = false
                pixel_size = 0.325
                skip_postprocessing_qc = true
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                input[1] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001', is_reference: true],
                     file('$projectDir/tests/testdata/P001_cell_mask.tif')]
                ])
                input[2] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001', is_reference: true],
                     file('$projectDir/tests/testdata/P001_nuclei_mask.tif')]
                ])
                input[3] = Channel.fromList([
                    ['P001', file('$projectDir/tests/testdata/sample_contours.json')]
                ])
                input[4] = Channel.fromList([
                    ['P001', file('$projectDir/tests/testdata/sample_contours.json')]
                ])
                input[5] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001', is_reference: true],
                     file('$projectDir/tests/testdata/sample_morphology.csv')]
                ])
                input[6] = Channel.fromList([
                    [[patient_id: 'P001'], file('$projectDir/tests/testdata/sample_reg_qc.json')]
                ])
                input[7] = Channel.fromList([
                    [[patient_id: 'P001'], file('$projectDir/tests/testdata/sample_reg_residuals.csv')]
                ])
                input[8] = ParamUtils.compartmentMode(params)
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.postprocess_qc.size() == 0,
                    "skip_postprocessing_qc=true must leave the QC emit empty: " + workflow.out.postprocess_qc },
                { assert !workflow.trace.tasks().any { it.name.contains('GENERATE_POSTPROCESSING_QC') },
                    "the QC process must not be instantiated at all" },
                { assert workflow.out.seg_eval_metrics.size() == 0,
                    "skip_seg_quality_eval ships true, so CSE metrics are empty at defaults" }
            )
        }
    }

