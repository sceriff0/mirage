/*
========================================================================================
    MIRAGE WSI Processing Pipeline - Main Configuration
========================================================================================
    Author: mirage team
    Version: 1.0.0
========================================================================================
*/


// Plugins. Pinned to an exact version, never a range: a range would let a
// future plugin release change parameter validation under a rerun of an
// already-published analysis. 2.5.1 is the newest nf-schema whose `requires`
// (>=25.04.0) matches this pipeline's own manifest.nextflowVersion; 2.6.0+
// need Nextflow >=25.10.0.
//
// The plugin is downloaded from the Nextflow plugin registry on first use. On
// an air-gapped cluster it must be pre-provisioned — see docs/usage.md,
// "Offline / air-gapped execution".
plugins {
    id 'nf-schema@2.5.1'
}

validation {
    // A typo'd --my_param used to be accepted silently and read as null. The
    // static guard in tests/check_param_consistency.py catches typos in the
    // SOURCE; this catches them on the COMMAND LINE, which no test can see.
    //
    // `validation.failUnrecognisedParams` -- the boolean option this task's
    // brief was written against -- does not exist on the pinned nf-schema@2.5.1
    // (confirmed by decompiling ValidationConfig.class: no such field, and
    // setting it throws groovy.lang.MissingPropertyException at plugin-load
    // time, aborting every run). This version's real knob is the
    // `validation.logging.unrecognisedParams` log LEVEL (one of skip/debug/
    // info/warn/error; default warn) -- 'error' promotes it from a warning to
    // a validation error, which fails the launch. Do not "fix" this back to
    // `failUnrecognisedParams` without re-checking the pinned plugin version.
    logging {
        unrecognisedParams = 'error'
    }

    // params/*.json preset files use a "_comment_<section>" key as a poor-man's
    // JSON comment (plain JSON has no comment syntax), documenting each block
    // for a human reading the preset. Loaded via `-params-file`, each becomes a
    // real entry in the merged params map, so strict validation rejects them
    // unless explicitly ignored. This is every `_comment_*` key across
    // params/*.json today (tests/test_param_consistency_rule.py's sibling
    // check_param_consistency.py does not cover params/*.json, so this list is
    // hand-maintained -- add a name here when a new preset adds a new section).
    ignoreParams = [
        '_comment_io',
        '_comment_output',
        '_comment_preproc',
        '_comment_reg_common',
        '_comment_reg_valis',
        '_comment_resources',
        '_comment_seg',
        '_comment_seg_method',
        '_comment_trace',
        '_comment_workflow',
    ]
}

// Pipeline metadata
manifest {
    name            = 'mirage'
    description     = 'WSI processing pipeline (preprocessing, registration, segmentation, quantification, GeoJSON export)'
    author          = 'Valerio Fassi, Yinxiu Zhan'
    version         = '1.0.0'
    nextflowVersion = '>=25.04.0'
    mainScript      = 'main.nf'
}


/*
========================================================================================
    Pipeline Parameters
========================================================================================
*/

params {
    // Input/output
    input              = null
    outdir             = null

    // Workflow control
    start          = 'preprocessing'  // preprocessing | registration | segmentation | postprocessing
    stop           = null            // null = run to end; or: preprocessing | registration | segmentation | postprocessing
    dry_run        = false
    debug_channels = false

    // Config profile metadata. Set only by conf/test.config and conf/test_full.config
    // (never read by pipeline code) to label which profile produced a run; declared
    // here so the strict `validation.logging.unrecognisedParams = 'error'` check below
    // does not reject those profiles' own params on launch.
    config_profile_name        = null
    config_profile_description = null

    // Cluster options
    slurm_partition = null
    slurm_account   = null
    slurm_qos       = null
    // GRES string for GPU jobs, rendered as `--gres=gpu:${gpu_type}` by
    // conf/modules.config's SEGMENT block when seg_gpu is true. Bare `1` means
    // "any one GPU" and is accepted by virtually every SLURM with GPUs; a typed
    // string like 'nvidia_h200:1' is NOT -- it fails outright on a cluster with
    // different hardware. This default used to name one site's H200s, which made
    // the shipped pipeline unrunnable elsewhere without an override. Sites that
    // need a specific type set it in their own gitignored site config
    // (conf/site.config.template) -- see `sinfo -o "%G"` for the local string.
    gpu_type        = '1'

    // Preprocessing (BaSiC illumination correction, via nf-core's BASICPY module)
    // Three knobs, deliberately: an on/off switch, what BaSiC is NOT applied to, and the
    // tile size it fits on. Everything else uses BASICPY's own upstream defaults
    // (get_darkfield=False — no darkfield is estimated or removed, unlike mirage's prior
    // in-process BaSiCPy correction — no autotune, non-overlapping FOVs) and the process
    // CPU allocation — those were parameters that nothing tuned, so they are gone rather
    // than shipped as dead knobs.
    skip_preprocessing        = true   // DEFAULT ON since 2026-09-10: CONVERT_IMAGE only, no BaSiC
                                       // correction. Set false (in a -params-file or profile;
                                       // never on the CLI) to run the illumination correction.
                                       // conf/test.config pins false so the suite keeps covering it.
    preproc_skip_nuclear      = true   // nuclear/fiducial channels (params.nuclear_markers)
                                       // bypass BaSiC — correcting the registration and
                                       // segmentation fiducial changes what both consume
    preproc_tile_size         = 1950   // BaSiC FOV tile size (px)
    preprocess_qc_scale_factor = 0.25
    skip_preprocess_qc         = false

    // Nuclear/fiducial channel — ordered preference of marker names. The first marker
    // present (resolved from channel metadata, never the filename) is moved to channel 0
    // by CONVERT_IMAGE and then drives BOTH cell segmentation and the registration
    // fiducial. Fails fast if none is present (single-channel images excepted).
    nuclear_markers      = ['DAPI', 'CELLTOX']

    // Registration (common)
    registration_method  = 'valis'         // 'valis' | 'tiled' (STARE: fully-parallel, JVM-free. NOT laptop-sized
                                           //           at the shipped tier — COARSE's DISK matcher asks ~48 GB
                                           //           at reg_tiled_mode=high; use 'low' (~5 GB) on a workstation)
    skip_registration_qc = false
    reg_qc               = 2                // staged registration QC on by default (DAPI overlay +
                                            // segmentation-overlap dice/displacement); 0=none, 1=overlay only
    qc_scale_factor      = 0.25

    // reg_qc=2 cell correspondence. 'lsa' = optimal one-to-one assignment within the match
    // radius (exact, solved per connected component); 'mutual_nn' = the older greedy rule.
    seg_qc_pairing             = 'lsa'
    // Match radius in median nuclear radii, for BOTH pairing methods. 1.5 suits 'lsa', which
    // resolves contention globally; tighten toward 1.0 if you select 'mutual_nn'.
    seg_qc_match_radius_factor = 1.5

    // Registration (tiled / STARE) — only used when registration_method='tiled'
    // Cost/accuracy tier: 'high' | 'medium' | 'low' | 'custom'. The table is
    // lib/RegPresets.groovy (RegPresets.STARE). 'high' is the shipped behaviour and holds exactly
    // the literals the tier-owned knobs below used to carry. 'custom' starts from 'high' and takes
    // whichever per-knob overrides you set. Setting an override under any tier OTHER than 'custom'
    // is rejected up front by ParamUtils, so a contradictory run fails before any process starts.
    reg_tiled_mode             = 'high'

    // Nuclear/fiducial channel index used to estimate the transform. null = RESOLVE it
    // from the slide's channel metadata against params.nuclear_markers (MarkerUtils),
    // the same rule SEGMENT's CellSAM backend uses. A fixed 0 here duplicated an
    // invariant CONVERT_IMAGE already guarantees, and named it after one marker;
    // set an integer only to override the resolved index.
    reg_tiled_nuclear_index    = null

    // --- Tier-owned knobs. null = take this value from reg_tiled_mode's row in RegPresets.STARE.
    // They are null-declared rather than carrying literals because Nextflow evaluates this params
    // block BEFORE merging CLI arguments, so a preset lookup written here could never observe
    // `--reg_tiled_mode low` (verified empirically, not assumed). null-declaration is also the only
    // shape tests/test_no_duplicate_param_defaults.py permits a `?:` fallback for -- the same
    // "null means derive at runtime" contract reg_jvm_heap_gb uses. Shipped behaviour is unchanged:
    // the bracketed value is what each line declared before, and it is the 'high' row.
    reg_tiled_tile             = null             // tile core size (px); also the mesh grid resolution      [high: 2048]
    reg_tiled_halo             = null             // tile read halo (px) for per-tile registration context   [high:  256]
    reg_tiled_upsample         = null             // phase-correlation sub-pixel upsample factor (per-tile)  [high:   10]
    reg_tiled_out_tile         = null             // streaming stitch write-tile size (px), gigapixel-safe   [high: 1024]
    reg_tiled_coarse_max_dim   = null             // COARSE anchor thumbnail: longest side (px). The MEMORY knob
                                                  // for TILED_COARSE: its DISK matcher is a U-Net, so peak is
                                                  // linear in thumbnail AREA -- GB ~= 1.1 + 7.3 * Mpx (3.03 GB
                                                  // at 512 px, 8.78 GB at 1024 px, measured). conf/modules.config
                                                  // derives the memory request from this. Lower = cheaper,
                                                  // coarser M0; the residual it leaves must stay well inside
                                                  // reg_tiled_halo. A 256 px FLOOR is enforced at launch by
                                                  // ParamUtils.validateRegPresets: anything below it -- 0 included,
                                                  // which used to mean "no decimation" -- aborts the run.  [high: 2048]

    // --- Gating / quality knobs. Deliberately NOT tier-owned: they decide what counts as an
    // acceptable control point, which is a correctness question rather than a cost/accuracy trade.
    // A user asking only to use less memory must not silently get a different mesh.
    reg_tiled_gate_tre         = 1.0              // refine only tiles whose rigid-stage TRE (px) exceeds this
    reg_tiled_max_error        = 0.99             // CONFIDENCE gate: drop a control point whose phase-correlation
                                                  // error exceeds this (0 = perfect match, ~1 = no shared structure).
                                                  // This, not displacement magnitude, is what keeps background and
                                                  // section-edge tiles out of the mesh — those produce plausibly
                                                  // SMALL displacements. Measured on the synthetic tiles in
                                                  // tests/test_tile_residual_confidence.py: real tissue 0.041,
                                                  // background 0.9995, section edge 0.99996, empty crop NaN.
    reg_tiled_max_disp         = null             // RANGE gate: drop a control point whose |displacement| (px) is at
                                                  // or beyond this — the match was never inside the read window, so
                                                  // the peak is an artefact. null = use reg_tiled_halo, the
                                                  // physically-motivated bound. A cheap secondary net only.

    // Registration (VALIS)
    // Cost/accuracy tier: 'high' | 'medium' | 'low' | 'custom'. The table is
    // bin/utils/valis_config.py (MEMORY_PRESETS). It lives on the PYTHON side, not in
    // lib/RegPresets.groovy with STARE's, because its rows hold Python objects -- a
    // feature_detectors.SuperPointFD class and a SuperGlueMatcher() instance -- which cannot be
    // expressed in Groovy. Splitting only its numeric half into Groovy would create exactly the
    // two-homes drift RegPresets exists to prevent. 'high' is the shipped behaviour; 'custom'
    // starts from 'high' and takes whichever per-knob overrides you set below.
    memory_mode                = 'high'

    // --- Tier-owned VALIS knobs. null = take this value from memory_mode's preset row.
    // Only legal to set when memory_mode='custom'; ParamUtils rejects them under any other tier
    // rather than letting a run silently contradict the tier it claims to use.
    reg_valis_max_processed_dim = null            // feature detection/matching working size (px)
                                                  // [high: 2048, medium: 1024, low: 512]
    reg_valis_max_non_rigid_dim = null            // non-rigid registration size (px)
    // NOT tier-owned: legal under any memory_mode. null = VALIS's own ceiling (20000 keypoints
    // per image, what every run has used). SuperGlue's cost is quadratic in it, so the tma
    // profile lowers it; lowering it changes which matches exist, i.e. the registration, so it
    // is a per-cohort decision, not a memory tweak. One home: valis_config.MAX_KEYPOINTS.
    reg_valis_max_keypoints     = null            // keypoints kept per image (SuperPoint + SuperGlue)
                                                  // [high: 2048, medium: 1024, low: 512]
                                                  // Must be SMALLER than every slide's full resolution:
                                                  // VALIS 1.0.0-1.2.0 reads a slide no larger than this
                                                  // at pyramid level -1 and kills its JVM, and its own
                                                  // clamp does not prevent it (bin/utils/valis_preflight.py
                                                  // has the chain). REGISTER refuses such input at start.
                                                  // Lower it below the smallest slide, with a margin, on
                                                  // small-format input (e.g. TMA cores).
    // NOTE: MEMORY_PRESETS also carries `num_features` (and `tile_wh`/`tile_buffer` on the 'low'
    // row), but build_registrar_kwargs() never passes them to Valis(...) -- they are dead keys, so
    // there is deliberately no param for them. Wiring them would change registration behaviour and
    // belongs in its own change, not in a preset refactor.

    reg_micro_reg_fraction     = 0.125
    reg_max_image_dim          = 4000
    reg_micro_reg              = 1                // micro-registration depth (default 1): 0=none,
                                                  // 1=micro-rigid only (refines slide.M) [default],
                                                  // 2=+micro non-rigid (register_micro). At >=1 the
                                                  // QC 'rigid' stage means affine ∘ micro-rigid.
    // JVM heap (GiB) for VALIS/Bio-Formats in REGISTER. null = derive from
    // task.memory at runtime (register.nf). Declared so it is not an
    // "undefined parameter" warning / nf-core lint finding.
    reg_jvm_heap_gb            = null

    // Distributed/tiled low-memory registration params archived 2026-07-24
    // (git tag archive/tiled-valis-2026-07-24): reg_distributed_tiling, reg_dist_*,
    // reg_max_non_rigid_dim, reg_warp_tile_*, reg_mem_budget_gb, reg_compare.

    // Segmentation
    // Default is 'instantseg': it is the only backend that runs on a fresh clone.
    // The 'stardist' path needs a trained model supplied via segmentation_model_dir
    // (the shipped segmentation_model name is not a StarDist built-in, so segment.py
    // raises FileNotFoundError without it — see conf/ieo.config). InstanSeg is also
    // Apache-2.0 with unencumbered weights, whereas CellSAM/Cellpose/Mesmer weights
    // are gated or non-commercial.
    seg_method             = 'instantseg' // 'stardist' | 'instantseg' | 'cellsam'
    seg_gpu                = true
    seg_pmin               = 1.0
    seg_pmax               = 99.8
    // StarDist detection probability threshold. null = use the model's built-in
    // default (production). Lower it (e.g. test profile) to detect fainter nuclei.
    seg_prob_thresh        = null
    seg_n_tiles_y          = 16
    seg_n_tiles_x          = 16
    seg_expand_distance    = 10
    segmentation_model_dir = null
    segmentation_model     = 'stardist_full_e200_lr00001_aug1_seed10_es50p0.001_rlr0.5p50'

    // Segmentation (InstanSeg backend; only used when seg_method='instantseg')
    seg_instantseg_model      = 'fluorescence_nuclei_and_cells'
    // 'all_outputs' is the only accepted value, and nextflow_schema.json's enum
    // now says so. 'cells' and 'nuclei' each return a SINGLE label map;
    // bin/segment_instantseg.py used to replicate it into both the nuclei and the
    // cell mask, which made Cytoplasm = Cell - Nucleus empty for every cell and
    // every cytoplasmic measurement silently zero. The reader refuses it now, and
    // the narrowed enum moves that refusal to launch time rather than spending a
    // segmentation task to discover it.
    seg_instantseg_target     = 'all_outputs'
    // Tiled inference via eval_medium_image. tile_size is in pixels at the
    // model's working pixel size; batch_size is the number of tiles pushed
    // through the model per forward pass. Bump batch_size on large GPUs
    // (e.g. 16-32 on H200/H100); keep low on small GPUs to avoid OOM.
    seg_instantseg_tile_size  = 512
    seg_instantseg_batch_size = 16
    // Writable host path for InstanSeg's BioImage.IO model cache. Exported as
    // INSTANSEG_BIOIMAGEIO_PATH so the model is not written into the read-only
    // container image. When null, falls back to a per-task work-dir cache
    // (functional but re-downloads per task).
    instanseg_model_dir    = null

    // Segmentation (CellSAM backend; only used when seg_method='cellsam')
    // CellSAM segments the nuclear (DAPI) channel; the whole-cell mask is
    // derived by expanding nuclei labels with seg_expand_distance (shared with
    // StarDist). bbox_threshold is the precision/recall knob; use_wsi enables
    // CellSAM's native tiling (block_size/overlap) for large images.
    seg_cellsam_bbox_threshold = 0.4
    seg_cellsam_use_wsi        = true
    // block_size 1024 (vs upstream default 400) cuts the tile count ~6x for the
    // same image, so far fewer per-tile model invocations. Stay within CellSAM's
    // recommended [256, 2048] range.
    seg_cellsam_block_size     = 1024
    seg_cellsam_overlap        = 56
    // Path to pre-downloaded CellSAM weights for offline/container use. When
    // null, weights are auto-downloaded at runtime (requires a valid
    // DEEPCELL_ACCESS_TOKEN in the task environment).
    cellsam_model_path         = null

    // Quantification (per-compartment signal)
    // When true, SEGMENT's nuclear mask is routed into QUANTIFY alongside the
    // whole-cell mask, emitting Nucleus / Cytoplasm / Cell signal per marker into
    // the GeoJSON (cytoplasm = whole-cell − nucleus). Default on: the standard
    // output now carries per-compartment measurements and both a cell+nucleus and a
    // whole-cell-only GeoJSON. Set false for a lean whole-cell-only run.
    quantify_compartments   = true
    // Statistic policy is independent of quantify_compartments: MEDIAN is the
    // default per-channel statistic and is ALWAYS computed (per-cell pixel gather).
    // expanded_quantification adds Mean and Sum (integrated density) per compartment
    // on top. Default OFF: Median alone is the documented per-channel statistic, and
    // Mean/Sum triple the per-compartment measurement columns in cells.geojson and
    // measurements.csv for consumers that never read them. Opt in when you need them.
    expanded_quantification = false

    // GeoJSON export (EXTRACT_CELL_PROPERTIES / EXTRACT_NUCLEI_PROPERTIES). The
    // exported polygon is display-only — all quantification is mask-derived — so
    // simplifying it and dropping sub-pixel coordinate precision does not affect
    // analysis.
    simplify_tolerance       = 1.0   // Douglas-Peucker tolerance (px) for contour simplification
    geojson_coord_precision  = 2     // decimal places for GeoJSON coordinates

    // ---- SpatialData (.zarr) export ------------------------------------------------
    // Additive scverse-native output; OME-TIFF + GeoJSON remain the primary artifacts.
    skip_spatialdata_export         = false
    // spatialdata.write() materializes every element, so including the pyramid
    // duplicates the largest artifact the pipeline produces. Off by default; turn on
    // for a self-contained, depositable object.
    spatialdata_include_image       = false
    // Max centroid distance (px) when joining warp_seg_qc's per-cell residuals onto
    // cell_mask. The QC segmentation is a separate native-image StarDist run and shares
    // no label space with cell_mask, so the join is spatial (see export_spatialdata.py).
    spatialdata_residual_join_max_px = 15.0

    // Postprocessing QC
    skip_postprocessing_qc = false

    // Reference-free cell-segmentation quality scoring (CSE, 2D). OPT-IN.
    //
    // Default TRUE (off) on purpose. This scorer is the one QC stage that can
    // fail for reasons unrelated to the data -- it needs the `segeval` image on
    // Docker Hub, and .github/workflows/build-images.yml only pushes on a release
    // or a manual dispatch, never on a push to main. A default-on stage whose
    // container may not exist yet fails every run of a fresh clone. Turn it on
    // for a benchmark cohort with the `seg_quality` profile, or with
    // -params-file params/seg_quality_eval.json. NOT on the command line: see
    // the profile's own comment below for why a CLI value does the opposite of
    // what it reads like.
    skip_seg_quality_eval = true
    cse_pixel_size_um     = null
    // Bin image+masks so CSE scores at most this many pixels. Full-WSI masks
    // otherwise exhaust CSE's memory/time budget (active-contour + per-pixel
    // reductions), so the process OOMs/times out and its QC-block errorStrategy
    // silently ignores it. Geometry/area metrics are preserved by binning; the
    // composite QualityScore shifts with the factor, so keep it fixed across a
    // cohort for comparability. Set null to disable (score at full resolution).
    cse_max_pixels        = 50000000

    // Final QC report
    skip_final_qc_report   = false

    // Image and pyramid output
    //
    // Micrometres per pixel. 'auto' (the default) reads PhysicalSizeX from each image's own
    // OME metadata; a positive number overrides it for every slide.
    //
    // 'auto' is the default rather than null because the metadata is the authoritative scale
    // when it exists, and reading it is effectively free -- a metadata-only scan of six slides
    // measured 2 ms. PREFLIGHT_SCALE resolves this for every slide BEFORE any heavy work and
    // fails the run if 'auto' cannot find a usable scale, so an unresolvable default cannot
    // reach a process. A supplied NUMBER is never refused, only warned about: an operator
    // passing one is overriding the metadata deliberately, and refusing would break every run
    // whose metadata is absent or wrong (this repo's own test fixtures are exactly that case).
    pixel_size          = 'auto'
    tilex               = 512
    pyramid_resolutions = 8
    pyramid_scale       = 2
    compression         = 'zstd'

    // Resource Limits
    //
    // max_memory and max_cpus are DECLARED NULL, NOT given a default. A default here is a
    // guess about someone else's hardware, and the failure mode of guessing high is an
    // OOM-kill deep into a run, hours after launch. nf-schema's `required` list for
    // resource_limits rejects a run that sets neither, at launch, before any process is
    // instantiated -- and it still does with these declared, because nf-schema treats a
    // null-valued param as NOT PROVIDED. Verified both ways 2026-08-29: undeclared and
    // declared-null produce the identical `Missing required parameter(s): max_cpus,
    // max_memory` rejection.
    //
    // They are declared rather than omitted so `nextflow_schema.json` and this params block
    // agree -- tests/check_param_consistency.py requires that, and leaving them out of the
    // block while the schema declared them broke the `NF latest-everything stub` CI job.
    // This is the same "null means the run must assert it" idiom pixel_size uses above.
    //
    // Every execution profile meant to run real work sets them: test, test_full, local, ieo.
    // max_time keeps a real default because overshooting a walltime ceiling costs a queue
    // slot, not a dead run.
    max_cpus         = null
    max_memory       = null
    max_time         = '240.h'

    // Concurrency. ONE knob drives both caps, because they are only meaningful
    // together: queue_size caps total tasks in flight across the pipeline,
    // max_forks caps tasks of any ONE process, and the lower of the two binds.
    // Raising one alone changes nothing -- which is how the shipped default came
    // to cut cluster throughput ~4x with two in-tree comments describing the
    // max_forks default wrongly as 100 instead of the shipped 5.
    //
    //   --concurrency 20   ->  max_forks 20, queue_size 80
    //   --concurrency 5    ->  max_forks  5, queue_size 20   (the shipped default)
    //
    // max_forks/queue_size stay available for the asymmetric case and OVERRIDE
    // concurrency when set. They are declared `null`, not with a numeric default:
    // this params block is evaluated BEFORE the CLI is applied, so a derived
    // default computed here would use concurrency's DEFAULT and silently ignore
    // `--concurrency`. The derivation therefore lives in the "Concurrency" block
    // at the BOTTOM of this file, after `profiles {}`, together with the four
    // per-process caps it bounds.
    //
    // HOW THESE THREE ARRIVE. They drive SCALARS (queueSize, maxForks), which
    // freeze where they are written. The CLI, a -params-file and a profile all
    // reach them. A `-c site.config` does NOT: nextflow.config is parsed in full
    // before any -c file is merged, so such a pin changes params.concurrency and
    // nothing that reads it. Rather than ignore the pin, ParamUtils.
    // validateFrozenConfig refuses the run at launch, naming the route. The same
    // applies to enable_trace, trace_dir and cleanup_work below (measured
    // 2026-09-09; tests/frozen_config_pin.sh).
    //
    // Because every per-process override in conf/modules.config is
    // Math.min(its own cap, the resolved max_forks), the resolved value clamps
    // ALL of them -- REGISTER's 10 and TILED_COARSE's 20 included -- so a
    // default run is gentle on a shared cluster. LOWERING it really does
    // throttle every module; RAISING it never lifts a process past the limit
    // its own block sets for its own reasons.
    concurrency      = 5
    max_forks        = null
    queue_size       = null

    // Tracing (optional). Both drive scalars in the trace/report/timeline scopes
    // at the bottom of this file: CLI (trace_dir only -- enable_trace is a boolean),
    // -params-file or a profile reach them; a `-c` file does not, and the run is
    // refused rather than the pin ignored (see the concurrency comment above).
    enable_trace     = true             // Enable detailed execution tracing
    trace_dir        = '.trace'          // Directory for trace outputs (independent of outdir)

    // Output cleanup.
    //
    // cleanup_level:
    //   'none'  (DEFAULT since 2026-09-10; was 'final' from 2026-08-25) publish
    //           everything, as the pipeline always did. A run's output can then be
    //           RE-ENTERED: `--start segmentation` reads registered/, and
    //           mode='add_cycle' reads registered/ AND the segmentation masks.
    //   'final' publish ONLY the final artifacts — pyramid/, geojson/,
    //           quantification/ and the SpatialData .zarr — plus run-level qc/,
    //           csv/ and size_logs/. Intermediates are NOT PUBLISHED AT ALL rather
    //           than published-and-deleted: publishDir is mode: 'copy', so the
    //           delete variant pays a full copy out of work/ for a file nobody
    //           reads. Gating the publishDir costs nothing. ParamUtils refuses
    //           add_cycle at this level, at LAUNCH, rather than failing halfway
    //           through; --start past preprocessing warns.
    //
    // The surviving/dropped split has ONE owner: Layout.FINAL_KINDS. Do not
    // restate it here or in conf/modules.config — the gate at each publishDir is
    // one inlined predicate inside a `saveAs:` closure, because conf/*.config
    // cannot see lib/ classes. It is a CLOSURE so that it is resolved per file at
    // publish time, against the FINAL merged params: a plain `enabled:` boolean
    // was evaluated when conf/modules.config was parsed (line ~530, before
    // `profiles {}` and before any `-c` file), so a profile or site-config pin of
    // this param never reached the gates (fixed 2026-09-06).
    // tests/test_cleanup_publish_gates.py keeps the inlined copies honest;
    // tests/cleanup_level_pin.sh proves the pin arrives by every route.
    cleanup_level    = 'none'

    // Work-directory cleanup. true = Nextflow deletes the work directory after a
    // SUCCESSFUL run.
    //
    // Now true by default. It shipped false for two reasons and one of them is
    // gone. It used to destroy the on-disk evidence for any task dropped by
    // conf/modules.config's errorStrategy 'ignore' branch — a run could exit 0
    // with a task silently failed and nothing left to look at. That branch is no
    // longer on the default path: the QC selector is retry-then-fail, so a broken
    // QC task fails the run, a green run implies a complete tree, and deleting
    // work/ on success hides nothing. A FAILED run still keeps its work directory;
    // Nextflow's `cleanup` only fires on success.
    //
    // The OTHER reason still stands: this is mutually exclusive with `-resume`,
    // which docs/usage.md teaches as the normal iteration loop. Now that the
    // default is true, a `-resume` user loses the cache they were relying on
    // without asking for anything — so ParamUtils.validateCleanup WARNS at launch
    // when both are in play. It warns rather than refuses because which one the
    // user meant is genuinely ambiguous, and refusing would break every existing
    // `--start <step> ... -resume` invocation in docs/usage.md.
    //
    // Safe on its own terms because every publishDir uses mode: 'copy' (no symlinks
    // into work/) and no checkpoint CSV records a path inside the work directory
    // (asserted by tests/checkpoint_manifest.nf.test).
    cleanup_work     = true

    // Incremental cyclic-IF mode. 'standard' = normal start/stop pipeline;
    // 'add_cycle' = fold a new imaging cycle into a prior completed run.
    mode         = 'standard'
    // For mode='add_cycle': the --outdir of the previously completed run,
    // whose csv/registered.csv and csv/postprocessed.csv provide the reusable
    // reference, segmentation mask, merged quantification table, and pyramid.
    prior_outdir = null
    // Embed the segmentation masks as a SECOND series in the pyramid OME-TIFF
    // (cell_mask + nuclei_mask, uint32, single-res). Written only when this is
    // true AND quantify_compartments AND expanded_quantification. Default off so
    // enabling compartments+expanded does not silently bloat every pyramid with an
    // extra uint32 mask series — masks remain available separately under
    // segmentation/. Set true to embed them. See docs/add_cycle.md.
    embed_masks  = false

}

/*
========================================================================================
    Modular configuration
========================================================================================
    INCLUDED AFTER THE PARAMS BLOCK ABOVE, DELIBERATELY, AND THE ORDER IS LOAD-BEARING.

    These two files reference `params.*` -- conf/modules.config's memory closures read
    params.preproc_tile_size and friends. When they were included at the TOP of this
    file, before the params block existed, a bare `params.x` did not read null: Nextflow
    resolves it to an EMPTY ConfigObject, i.e. a Map. Inside a closure that is harmless,
    because closures are evaluated at task-submission time by which point params are
    populated -- which is why every `memory = { ... }` closure worked. Evaluated EAGERLY
    it is not: `params.x as int` on a Map throws "Cannot coerce a map to class
    java.lang.Integer", and the whole config fails to parse. Measured on this tree.

    `maxForks` cannot be deferred into a closure the way `memory` can -- it is not a
    dynamic directive. Nextflow compares it against 0 in TaskProcessor's constructor and
    throws "Cannot compare ... Closure ... and java.lang.Integer with value '0'". The
    per-process maxForks caps therefore used to live in conf/modules.config, at this
    position; they now live in the "Concurrency" block at the BOTTOM of this file, after
    `profiles {}`, because a scalar here froze before any profile ran (2026-09-09). No
    eager `params.*` read remains in either included file.

    Relative order is otherwise unchanged: both files are still included BEFORE the
    `executor` and `process` blocks below, so those still take precedence, exactly as when
    the includes sat at the top. Verified by diffing `nextflow config` for the test,
    test_full and local profiles across the move.
*/
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// executor.queueSize and process.maxForks are NOT here. They are params-derived
// SCALARS, and a scalar freezes against the params as they stand at its own line;
// here that is above `profiles {}`. They live in the "Concurrency" block at the
// bottom of this file, after the profiles -- see the comment there.
process {
    stageInMode     = 'symlink'  // zero overhead, works cross-filesystem
    // Closure (not a plain map): resourceLimits is assigned here, at the TOP
    // of the config, before any profile's `params.max_*` override (e.g.
    // conf/test.config's max_cpus=2) has run. A plain map would eagerly
    // capture params.max_* as they stand at THIS point in the file --
    // nextflow.config's own top-level defaults (null / null / 240.h) --
    // silently ignoring any profile override and refusing every launch (since
    // max_cpus/max_memory are required and null is not a valid ceiling)
    // instead of enforcing the profile's own values. Wrapped in a closure,
    // evaluation is deferred to task-submission time, by which point the full
    // profile stack (including test/test_full/local's params.max_* overrides)
    // has already been merged. Verified empirically: see tests/modules/
    // resource_limits.nf.test and task-9-report.md.
    resourceLimits  = { [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ] }
}

/*
========================================================================================
    Execution Profiles
========================================================================================
    Container images are declared per-process in modules/local/*.nf
========================================================================================
*/

profiles {
    // Test profile (small dataset validation)
    test {
        includeConfig 'conf/test.config'
    }

    // Test full profile (complete dataset)
    test_full {
        includeConfig 'conf/test_full.config'
    }

    // Test profile variant that pins the segmentation backend to InstanSeg
    // EXPLICITLY. conf/test.config already re-pins seg_method away from the
    // shipped default, so this profile states the backend it exercises rather
    // than inheriting it.
    instantseg_test {
        includeConfig 'conf/test.config'
        params.seg_method = 'instantseg'
    }

    // Test profile variant that pins the segmentation backend to CellSAM
    // EXPLICITLY. conf/test.config already re-pins seg_method away from the
    // shipped default, so this profile states the backend it exercises rather
    // than inheriting it.
    cellsam_test {
        includeConfig 'conf/test.config'
        params.seg_method = 'cellsam'
    }

    // Test profile variant that runs the SHIPPED defaults for pixel_size and
    // seg_method ('auto' / 'instantseg'), unlike conf/test.config which pins both
    // away from what actually ships, for reasons documented at each pin -- which
    // means the exact shipped combination is otherwise never executed, stub or
    // real. Deliberately does NOT `includeConfig 'conf/test.config'`: that file
    // is exactly what re-pins pixel_size and seg_method away from their shipped
    // values, so including it and then overriding the same two keys back
    // reproduces, one layer up, the drift trap this profile exists to close --
    // a future change to either shipped default would silently keep testing the
    // OLD value here. Leaving them unset lets both INHERIT straight from
    // nextflow.config's top-level params block, so they can never drift out of
    // sync with what ships.
    //
    // Everything below is therefore stated explicitly, each for its own reason,
    // rather than picked up as an unexamined bundle from conf/test.config:
    shipped_defaults_test {
        // The only fixture pair this repo generates with a real OME
        // PhysicalSizeX/Y (tests/testdata/generate_complete_testdata.py,
        // section 9) -- every other fixture is scale-less on purpose, so
        // `auto` would (correctly) hard-fail at PREFLIGHT_SCALE against it.
        params.input      = "${projectDir}/tests/testdata/shipped_defaults_input.csv"
        // outdir has no default (nextflow.config sets it null) and nf-schema
        // requires it; CI's shipped-defaults job also passes --outdir on the
        // command line, which wins over this, but the profile should still be
        // runnable stand-alone.
        params.outdir     = 'shipped_defaults_results'

        // Required by nf-schema's `resource_limits` (max_cpus/max_memory are
        // both mandatory); kept CI-sized like conf/test.config's, since this
        // profile still runs on the same small CI runner.
        params.max_cpus   = 2
        params.max_memory = '6.GB'
        params.max_time   = '1.h'

        // MUST divide the fixtures into at least 2 BaSiC FOVs, same constraint
        // and same value as conf/test.config -- see that file's comment. The
        // shipped default (1950px) is sized for real slides, not a 128x128
        // synthetic fixture, and a single-FOV split makes bin/tile_for_basic.py
        // refuse the run outright, stub or not.
        params.preproc_tile_size = 64

        // CI runners have no GPU; the shipped default (true) would make
        // InstanSeg request one that does not exist.
        params.seg_gpu = false
    }

    // Turn ON the opt-in reference-free segmentation-quality scorer (CSE).
    //
    // A PROFILE rather than a command-line flag: Nextflow 26 delivers every
    // --param as a String, so passing this one on the command line sets it to a
    // non-empty string, which is truthy -- it would silently do the OPPOSITE of
    // what it reads like. Used by benchmarks/submit_arms.sh (ENABLE_CSE=true).
    seg_quality {
        params.skip_seg_quality_eval = false
    }

    // Tissue-microarray input. A DATA-shape profile, meant to compose with a site
    // profile: `-profile slurm,ieo,tma`. TMA cores are small (a 1 mm core is ~2000-3000 px
    // on the long side at usual scan resolutions), and VALIS 1.0.0-1.2.0 dies on any slide
    // whose full resolution is no larger than its non-rigid registration size -- the
    // `high` tier's 2048 px (bin/utils/valis_preflight.py has the chain; REGISTER refuses
    // such input at start). 1024 is the `medium` tier's size: safe for any core of
    // 2048 px or more on the long side, with the margin VALIS's tissue-mask term needs.
    // Feature matching stays at `high`'s 2048 px. For larger cores a CLI
    // --reg_valis_max_non_rigid_dim still outranks this pin. Both parameters are read
    // late (ParamUtils.validateRegPresets, REGISTER's script block), so unlike the
    // publishDir gates a profile pin does reach them. Guarded by tests/test_tma_profile.py.
    tma {
        params.memory_mode                 = 'custom'
        params.reg_valis_max_non_rigid_dim = 1024
        // JVM heap: a flat 16 GiB, not register.nf's 32 + 16 x attempt ramp. Bio-Formats
        // on five ~2800 px cores (~130 MB each) needs single-digit GiB (init_jvm's own
        // estimate is 3 x input size + 8), while REGISTER's real peak is on the PYTHON
        // side -- SuperGlue's per-pair working set during all-pairs matching (see
        // MAX_KEYPOINTS, _inference_only and bound_cpu_count in
        // bin/utils/valis_config.py). The ramp's min(48, task.memory - 4) would hand
        // Java most of a small request and leave the side that actually allocates
        // with the remainder. Read late (REGISTER's script block), so a profile pin
        // reaches it; a CLI --reg_jvm_heap_gb outranks it.
        params.reg_jvm_heap_gb             = 16
        // Keypoints per image: 2000 instead of VALIS's 20000. SuperGlue's per-pair cost
        // is quadratic in this, a ~2800 px core has no use for 20000 points, and the
        // profile is the place to say what the DATA needs. This changes which matches
        // exist, so results on the tma profile are not comparable with a run at 20000.
        params.reg_valis_max_keypoints     = 2000
        // conf/modules.config reserves a flat 300 GB x attempt for REGISTER, sized for
        // whole slides. On SLURM the 300 GB request is mostly what the run queues for.
        // Override the one process, keep the retry ramp, leave cpus/time to
        // conf/modules.config. NOTE the premise "small cores need a small fraction":
        // REGISTER's peak is the keypoint count x retained autograd state, not the
        // pixel count (measured 2026-09-10: five cores OOM-killed at 128 GB at
        // "Matching images 0/10" before the keypoint cap, the CPU bound and the
        // no_grad wrapper existed; still killed at 64 GB with the first two alone).
        // 64 GB is sized for the bounded, inference-only matcher; raise it with a
        // site profile if a cohort still climbs the ramp.
        process {
            withName: 'REGISTER' {
                memory = { 64.GB * task.attempt }
            }
        }
    }

    // Docker (local development with containers)
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        conda.enabled          = false
    }

    // Singularity (HPC with containers)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
        // Forward DEEPCELL_ACCESS_TOKEN by name (like Docker's `-e VAR`) instead
        // of interpolating its value into containerOptions (conf/modules.config
        // SEGMENT), which would otherwise land in the work dir's .command.run.
        singularity.envWhitelist = 'DEEPCELL_ACCESS_TOKEN'
    }

    // Conda
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }

    // SLURM execution
    slurm {
        process.executor = 'slurm'
        process.queue    = params.slurm_partition
        process.clusterOptions = {
            def opts = []
            if (params.slurm_account && params.slurm_account != '') opts << "--account=${params.slurm_account}"
            if (params.slurm_qos && params.slurm_qos != '')         opts << "--qos=${params.slurm_qos}"
            return opts ? opts.join(' ') : null
        }
        // resourceLimits is deliberately NOT set here. The top-level
        // `process.resourceLimits` CLOSURE (above `profiles {}`) already clamps
        // every request to params.max_* lazily, at task-submission time, so it sees
        // a `-c site.config` or a later profile's values. This profile used to
        // shadow it with a PLAIN MAP, which froze at profile-merge time to
        // [cpus:null, memory:null, time:240.h] on the documented
        // `-profile slurm,singularity -c site.config` route (measured 2026-09-09,
        // in both `slurm,local` and `local,slurm` order too) -- the retry ramp ran
        // unclamped on exactly the executor the clamp exists for, and the comment
        // above the line said so. tests/test_frozen_config_params.py now forbids a
        // plain-map resourceLimits in any config file.
    }

    // Local development (no SLURM)
    local {
        process.executor  = 'local'
        // Clamp per-process requests to the local machine so heavy production
        // sizing (e.g. CONVERT_IMAGE) does not exceed a workstation's memory.
        // process.resourceLimits (top-level, nextflow.config) reads these back
        // lazily at task-submission time, so setting the params here is enough
        // -- no need for a duplicate per-profile resourceLimits list.
        params.max_cpus   = 4
        params.max_memory = '16.GB'
        params.max_time   = '72.h'
        // NOTE for --registration_method tiled: TILED_COARSE derives its request
        // from the resolved thumbnail bound and asks ~48 GB at the shipped `high`
        // tier. resourceLimits CLAMPS that to the 16 GB above rather than
        // rejecting it, and a clamp is silent -- the task simply OOMs. Pair this
        // profile with --reg_tiled_mode low (512 px, ~5 GB). See docs/resources.md.
    }

    // IEO HPC cluster profile — committable, non-secret cluster execution
    // settings ONLY, so `-profile ieo` parses in CI and fresh clones. Do NOT
    // `includeConfig 'conf/ieo.config'` here: that file is gitignored, and the
    // strict Nextflow parser (latest-everything channel) eagerly evaluates
    // profile includes at parse time for ALL profiles — so a missing include
    // breaks every profile (even `-profile test`) in CI and fresh clones.
    // Site-specific paths/secrets (outdir, model dirs, singularity cacheDir and
    // bind mounts, Tower workspace) live in the gitignored overlay and are
    // layered on the command line:
    //   Setup: cp conf/site.config.template conf/ieo.config   (then customise)
    //   Run:   nextflow run . -profile singularity,ieo -c conf/ieo.config ...
    ieo {
        process.executor = 'slurm'
        // Pin the IEO cluster ceiling explicitly, the same way `local` pins
        // its own. max_cpus/max_memory are declared null at the top level
        // (:402-403) -- no default, required by nextflow_schema.json -- so
        // there is nothing to "happen to equal" any more; only max_time's
        // 240.h coincides with the top-level default (:404), and that too is
        // a coincidence rather than a guarantee IEO should rely on. Pin all
        // three explicitly so `-profile ieo` never depends on whatever the
        // top-level default is. process.resourceLimits (top-level) reads
        // these back lazily at task-submission time.
        params.max_cpus   = 128
        params.max_memory = '700.GB'
        params.max_time   = '240.h'
    }
}

// Tower/Seqera Platform config moved to site-specific configs (e.g. conf/ieo.config)

/*
========================================================================================
    Execution Tracing (Optional)
========================================================================================
*/

trace {
    enabled   = params.enable_trace
    file      = "${params.trace_dir}/trace.txt"
    fields    = 'task_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,cpus,memory,peak_rss,peak_vmem,rchar,wchar'
    overwrite = true
}

report {
    enabled   = params.enable_trace
    file      = "${params.trace_dir}/report.html"
    overwrite = true
}

timeline {
    enabled   = params.enable_trace
    file      = "${params.trace_dir}/timeline.html"
    overwrite = true
}



/*
========================================================================================
    Work-Directory Cleanup (Optional)
========================================================================================
    Nextflow's own `cleanup` option: when true, the work directory is removed after
    a successful run, during session teardown. Preferred over an `rm -rf` inside
    main.nf's workflow.onComplete for two reasons: Nextflow already knows whether the
    run genuinely succeeded, and teardown is ordered — a hand-rolled delete would race
    the resource-report handler, which reads the trace and writes into --outdir.

    Reads params the same way the trace/report/timeline scopes above do -- and freezes
    the same way. `cleanup` is a scalar evaluated at THIS line, after `profiles {}`, so
    a profile or a -params-file reaches it (the CLI cannot carry a boolean at all).
    A `-c site.config` pin of cleanup_work does NOT: this file is parsed in full before
    any -c file is merged, so `params.cleanup_work` would print the pinned value while
    `cleanup` kept this line's. Measured 2026-09-09. ParamUtils.validateFrozenConfig
    refuses that run at launch instead of deleting (or keeping) work/ against the
    operator's stated intent. tests/frozen_config_pin.sh proves both.
*/

cleanup = params.cleanup_work

/*
========================================================================================
    Concurrency -- AFTER `profiles {}`, deliberately
========================================================================================
    queueSize and maxForks are SCALARS: Nextflow compares maxForks against 0 in
    TaskProcessor's constructor, so neither can be deferred into a closure the way
    memory or resourceLimits can. A scalar computed from params freezes against
    whatever the params are at the LINE it is written on. When these sat above
    `profiles {}` (measured 2026-09-09 with a probe printing workflow.session.config,
    Nextflow 25.04.7), a profile pinning `params.concurrency = 7` left queueSize at 20
    and every maxForks at 5 while `params.concurrency` printed 7. Placed here they see
    the merged profile stack, the CLI and any -params-file.

    What they still cannot see is a `-c` file (see the cleanup comment above).
    ParamUtils.validateFrozenConfig compares each params-derived scalar in this file
    against the final params at launch and REFUSES the run on a mismatch, naming the
    route. tests/test_frozen_config_params.py discovers every such scalar by scanning
    this file and asserts (a) it sits below `profiles {}` and (b) the validator names
    its param; tests/frozen_config_pin.sh proves the refusal and the working routes by
    running them.

    queueSize is set HERE, not in conf/base.config where the rest of the executor
    scope lives: that file is included before the params block exists, and a
    `params.queue_size` reference from there is silently parsed as the opening of a
    NESTED SCOPE NAMED `params` -- the setting vanishes from the resolved config with
    no error (measured: `executor { params { } exitReadTimeout = '1 day' }`). It merges
    with base.config's exitReadTimeout. Guarded by tests/test_concurrency_params.py.

    Explicit null tests, NOT `?:` -- Groovy treats 0 as falsy, so elvis cannot express
    "unset" for a numeric param (tests/test_nullable_numeric_params_no_elvis.py cites
    the live bug it caught: reg_tiled_max_disp 0 -> 256).
*/

executor {
    queueSize = (params.queue_size != null ? params.queue_size : (params.concurrency as int) * 4) as int
}

process {
    // Per-process cap: params.max_forks if set, else params.concurrency. At the shipped
    // defaults this (5) is LOWER than queueSize (20), so it is the ceiling that binds --
    // raising queueSize alone has no effect.
    maxForks = (params.max_forks != null ? params.max_forks : params.concurrency) as int

    // Four processes carry their own, higher cap, bounded by the same parameter. They
    // are here rather than in conf/modules.config for the evaluation-order reason above:
    // that file is included BEFORE `profiles {}`, and withName wins over the scope
    // default, so a cap frozen there silently overrode the value a profile asked for.
    // The cap table is mirrored in ParamUtils.PER_PROCESS_MAX_FORKS_CAP, which the
    // launch check reads; tests/test_concurrency_params.py asserts the two agree.
    withName: 'REGISTER'       { maxForks = Math.min(10, (params.max_forks != null ? params.max_forks : params.concurrency) as int) }
    withName: 'TILED_REG_TILE' { maxForks = Math.min(20, (params.max_forks != null ? params.max_forks : params.concurrency) as int) }
    withName: 'TILED_COARSE'   { maxForks = Math.min(20, (params.max_forks != null ? params.max_forks : params.concurrency) as int) }
    withName: 'TILED_STITCH'   { maxForks = Math.min(10, (params.max_forks != null ? params.max_forks : params.concurrency) as int) }
}
