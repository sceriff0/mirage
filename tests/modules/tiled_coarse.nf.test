nextflow_process {

    name "Test TILED_COARSE process"
    script "modules/local/tiled_coarse.nf"
    process "TILED_COARSE"

    tag "modules"
    tag "modules_local"
    tag "tiled_coarse"

    test("Should emit an M0 anchor and a tile plan - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['DAPI', 'CD3'], is_reference: false ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.m0
            assert process.out.tiles
            assert process.out.versions
            with(process.out.m0) {
                assert size() == 1
                assert get(0).get(1).toString().endsWith('_m0.json')
            }
        }
    }

    test("Should render --max-dim so the anchor runs on a thumbnail - rendered command") {

        // `stub` tag but no `options "-stub"`: `-stub` never evaluates `script:`.
        // --max-dim bounds the COARSE anchor to a thumbnail; without it the anchor warps and
        // FFTs the native-resolution plane ~50 times, far beyond the memory request derived
        // from this flag. 1024 is the default refine resolution.
        // Asserts .command.sh, not the outcome (no container engine under `--profile test`).
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['DAPI', 'CD3'], is_reference: false ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('${projectDir}/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('tiled_coarse.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered TILED_COARSE .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--max-dim 1024') },
                    "rendered command missing --max-dim (params.reg_tiled_coarse_max_dim default 1024): " + rendered.join(' --- ') },
                // the other flags must still be rendered
                { assert rendered.every { it.contains('--tile 2048') },
                    "rendered command missing --tile: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--halo 256') },
                    "rendered command missing --halo: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should resolve the nuclear index from channel metadata, not a fixed 0 - rendered command") {

        // `channels` has no DAPI and puts the nuclear marker (CELLTOX, params.nuclear_markers'
        // second entry) at index 1, so the module must render `--nuclear-index 1`, not a fixed
        // index 0 (which would estimate the anchor from CD3).
        // `stub` tag but no `options "-stub"`: the rendered command is the whole assertion.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['CD3', 'CELLTOX'], is_reference: false ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('${projectDir}/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('tiled_coarse.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered TILED_COARSE .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--nuclear-index 1') },
                    "nuclear index not resolved from channel metadata (expected 1 for ['CD3','CELLTOX']): " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--dapi-index') },
                    "the renamed flag is gone from the module; --dapi-index survives only as a deprecated Python alias: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should let reg_tiled_nuclear_index override the resolved index - rendered command") {

        tag "stub"

        when {
            params {
                reg_tiled_nuclear_index = 0
            }
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['CD3', 'CELLTOX'], is_reference: false ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('${projectDir}/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('tiled_coarse.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered TILED_COARSE .command.sh found under the task work dir" },
                // Metadata resolution would not pick 0 here, so this proves the override is honoured.
                { assert rendered.every { it.contains('--nuclear-index 0') },
                    "explicit params.reg_tiled_nuclear_index was not honoured: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should let an explicit reg_tiled_tile override its default and keep the others - rendered command") {

        // STARE has no cost tiers: each knob is a plain param, set directly.
        // `stub` tag but no `options "-stub"`: -stub never evaluates a script: block.
        tag "stub"

        when {
            params {
                reg_tiled_tile = 4096
            }
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['DAPI', 'CD3'], is_reference: false ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('${projectDir}/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('tiled_coarse.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1, "no rendered TILED_COARSE .command.sh found" },
                { assert rendered.every { it.contains('--tile 4096') },
                    "the explicit reg_tiled_tile was not rendered: " + rendered.join(' --- ') },
                // ...and everything not overridden keeps its default
                { assert rendered.every { it.contains('--halo 256') },
                    "halo did not keep its default 256: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--max-dim 1024') },
                    "max-dim did not keep its default 1024: " + rendered.join(' --- ') }
            )
        }
    }
}
