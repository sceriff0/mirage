nextflow_process {

    name "Test REGISTER process"
    script "modules/local/register.nf"
    process "REGISTER"

    tag "modules"
    tag "modules_local"
    tag "register"

    test("Should run VALIS batch registration - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001'],
                    'P001',
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    [
                        file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                        file('$projectDir/tests/testdata/P001_mov2.ome.tiff', checkIfExists: true)
                    ],
                    [
                        [patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']]
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.registered },
                { assert process.out.versions },
                { with(process.out.registered) {
                    assert size() == 1
                    assert get(0).get(0) == 'P001'
                }},
                { with(process.out.versions) {
                    assert size() == 1
                    assert get(0).toString().endsWith('versions.yml')
                }}
            )
        }
    }

    test("Should handle single moving image - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001'],
                    'P001',
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    [
                        file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                    ],
                    [
                        [patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']]
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.registered },
                { assert process.out.versions }
            )
        }
    }

    test("Should preserve patient ID through registration - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P002'],
                    'P002',
                    file('$projectDir/tests/testdata/P002_ref.ome.tiff', checkIfExists: true),
                    [
                        file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                    ],
                    [
                        [patient_id: 'P002', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P002', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']]
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { with(process.out.registered) {
                    assert get(0).get(0) == 'P002'
                }}
            )
        }
    }

    test("Should emit versions.yml with process info - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001'],
                    'P001',
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    [
                        file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                    ],
                    [
                        [patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']]
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.versions },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("Should stage its file list at a task-relative path, not /tmp - rendered command") {

        // `stub` tag but no `options "-stub"`: `-stub` never evaluates `script:`. REGISTER is
        // per-patient with maxForks > 1 and Singularity bind-mounts /tmp, so a constant /tmp
        // slide list would be shared between concurrent tasks; it must be a relative path in
        // the task's own work directory. Asserts the rendered .command.sh, not the outcome
        // (register.py is not expected to succeed on the bare host).
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001'],
                    'P001',
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    [
                        file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                    ],
                    [
                        [patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']]
                    ]
                ]
                """
            }
        }

        then {
            // Nextflow lays tasks out as <workDir>/<2 hex>/<30 hex>/.command.sh.
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('files_to_copy.txt')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered REGISTER .command.sh found under the task work dir" },
                // Fails if the slide list is written to `/tmp/files_to_copy.txt`.
                { assert rendered.every { !it.contains('/tmp/files_to_copy.txt') },
                    "rendered command still writes/reads the shared /tmp path: " + rendered.join(' --- ') },
                // The path must be plain and relative (no leading '/'), so it stays inside the
                // task's own work directory.
                { assert rendered.every { it.contains('> files_to_copy.txt') },
                    "rendered command: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('cat files_to_copy.txt') },
                    "rendered command: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should run valis-wsi at its defaults: no tier, micro, keypoint or size flags - rendered command") {

        // `stub` tag but no `options "-stub"`: -stub never evaluates a script: block.
        // REGISTER runs valis-wsi 1.2.0 at its defaults: the rendered call carries the inputs,
        // the JVM heap and the stage checkpoint, and nothing that sets VALIS. Each flag below
        // belongs to the archived tuned configuration and register.py rejects it. The
        // registration channel (index 0) is set inside register.py
        // (tests/test_register_valis_defaults.py).
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001'],
                    'P001',
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    [
                        file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                    ],
                    [
                        [patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']]
                    ]
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('register.py')) {
                    rendered << f.text
                }
            }
            def calls = rendered.collect { it.substring(it.indexOf('register.py \\')) }
            def removed = ['--memory-mode', '--micro-reg', '--micro-reg-fraction', '--max-image-dim',
                           '--max-processed-dim', '--max-non-rigid-dim', '--max-keypoints',
                           '--cpus', '--interp-method']

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered REGISTER .command.sh found under the task work dir" },
                { assert calls.every { c -> removed.every { !c.contains(it + ' ') } },
                    "a VALIS setting is rendered again: " + calls.join(' --- ') },
                // reg_valis_mode 'default' renders no flag (the hires case below renders it).
                { assert calls.every { !it.contains('--valis-mode') },
                    "the default mode rendered a mode flag: " + calls.join(' --- ') },
                // REGISTER passes the STAGED path (stageAs 'ref/*' -> ref/<name>); register.py
                // takes its basename and finds the copy under --input-dir.
                { assert calls.every { it =~ /--reference (\S+\/)?P001_ref\.ome\.tiff / },
                    "the reference did not reach register.py: " + calls.join(' --- ') },
                // Fixed heap: 10 GB (VALIS's own), clamped by task.memory - 4 on a small runner.
                { assert calls.every { c ->
                        def m = (c =~ /--jvm-heap-gb (\d+)/)
                        m.find() && (m.group(1) as int) >= 1 && (m.group(1) as int) <= 10 },
                    "the JVM heap is not the fixed <= 10 GB: " + calls.join(' --- ') },
                // Truncation guard: a backslash-newline followed by an empty line would end the
                // shell command early and run the rest as separate commands.
                { assert calls.every { !it.contains('\\\n\n') },
                    "register.py invocation is truncated by a blank line: " + calls.join(' --- ') }
            )
        }
    }

    test("Should run valis-wsi's hires example under reg_valis_mode hires - rendered command") {

        // `stub` tag but no `options "-stub"`: only the rendered command shows whether the
        // mode reached register.py. reg_valis_mode = 'hires' is valis-wsi 1.2.0's
        // high-resolution example (tests/test_register_valis_modes.py); its whole rendered
        // footprint is one flag, `--valis-mode hires`, on the stage-checkpoint line.
        tag "stub"

        when {
            params {
                reg_valis_mode = 'hires'
            }
            process {
                """
                input[0] = [
                    [patient_id: 'P001'],
                    'P001',
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    [
                        file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                    ],
                    [
                        [patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']]
                    ]
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('register.py')) {
                    rendered << f.text
                }
            }
            def calls = rendered.collect { it.substring(it.indexOf('register.py \\')) }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered REGISTER .command.sh found under the task work dir" },
                { assert calls.every { it.contains('--valis-mode hires') },
                    "reg_valis_mode 'hires' did not reach register.py: " + calls.join(' --- ') },
                // reg_qc defaults to 2, so the pre-micro checkpoint is still requested: hires
                // scores non_rigid (the checkpoint) apart from micro (the pickle).
                { assert calls.every { it.contains('--valis-mode hires --stage-checkpoint-dir reg_stage_checkpoint') },
                    "the hires flag must share the stage-checkpoint line: " + calls.join(' --- ') },
                { assert calls.every { !it.contains('--valis-mode default') },
                    "only hires renders a mode flag: " + calls.join(' --- ') },
                { assert rendered.every { it.contains('valis-wsi high-resolution example (hires)') },
                    "the settings banner does not name the hires example: " + rendered.join(' --- ') },
                { assert calls.every { !it.contains('\\\n\n') },
                    "register.py invocation is truncated by a blank line: " + calls.join(' --- ') }
            )
        }
    }

    test("Should render the envelope's size-log row and container line - rendered command") {

        // `stub` tag but no `options "-stub"`: -stub never evaluates a script: block.
        // Asserts .command.sh, not the outcome. task.container is set even with no container
        // engine enabled, so the container line is assertable here.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001'],
                    'P001',
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    [
                        file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                    ],
                    [
                        [patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'CD3']]
                    ]
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('P001.REGISTER.size.csv')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered REGISTER .command.sh found under the task work dir" },
                // The envelope's one-stat form over REGISTER's two staged globs, split into two
                // shorter needles because the line is quoting-dense.
                { assert rendered.every { it.contains('stat -L --printf="%s\\n" ref/* input_*/*') },
                    "rendered command: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('awk \'{s+=$1} END {print s+0}\'') },
                    "rendered command: " + rendered.join(' --- ') },
                // The process name is asserted by suffix: nf-test wraps a directly-tested process in
                // its own workflow, so the fully-qualified name differs from a pipeline run's.
                { assert rendered.every { it.contains('REGISTER,P001,inputs/,${size_bytes}" > P001.REGISTER.size.csv') },
                    "rendered command: " + rendered.join(' --- ') },
                // ...and it is a real name, not the literal STUB.
                { assert rendered.every { !it.contains('"STUB,') },
                    "rendered command: " + rendered.join(' --- ') },
                // The needle is scoped to `-exec stat -L --printf`: REGISTER's script: also runs an
                // unrelated `find -L ref input_* -maxdepth 1 ...` to stage input files, so a bare
                // `find -L ref input_*` needle would always match.
                { assert rendered.every { !it.contains('-exec stat -L --printf') },
                    "rendered command still uses the hand-written find: " + rendered.join(' --- ') },
                // The image is recorded by the run itself, not only by the trace. Digest-pinned, no
                // tag (Apptainer/Singularity: NAME[:TAG|@DIGEST], never both).
                { assert rendered.every { it.contains('    container: bolt3x/mirage-valis:1.0.0') },
                    "rendered command: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('valis: $(python -c "import valis;') },
                    "rendered command: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should run VALIS batch registration - real") {

        tag "real"
        tag "slow"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001'],
                    'P001',
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    [
                        file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                        file('$projectDir/tests/testdata/P001_mov2.ome.tiff', checkIfExists: true)
                    ],
                    [
                        [patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']]
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.registered },
                { assert process.out.versions },
                { with(process.out.registered) {
                    assert size() == 1
                    assert get(0).get(0) == 'P001'
                }}
            )
        }
    }
}
