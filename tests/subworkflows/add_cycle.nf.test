nextflow_workflow {

    name "Test ADD_CYCLE subworkflow (stub)"
    script "subworkflows/local/add_cycle.nf"
    workflow "ADD_CYCLE"

    /*
     * ADD_CYCLE takes the new-cycle sample channel: it rebuilds the prior
     * run's reusable assets itself, from --prior_outdir's checkpoint CSVs (that
     * reconstruction, including EXTRACT_MASK_SERIES, used to live in the router).
     * tests/testdata/prior_run/ is a minimal stand-in for a completed run, written
     * by tests/testdata/generate_complete_testdata.py.
     *
     * take: gained a second input, compartment_mode -- Task 4 (arch-B-split)'s seam
     * for --quantify_compartments / --expanded_quantification / --embed_masks,
     * resolved once by workflows/mirage.nf in production and threaded down the same
     * way here. The two compartments-off tests below pass input[1] as a LITERAL map
     * that DIVERGES from params (left at its true default), proving ADD_CYCLE
     * honours the argument rather than re-reading params.quantify_compartments --
     * the same "the literal wins" proof the registration_method='tiled' + literal
     * 'valis' assertion in the third test already makes for that sibling seam. The
     * middle ("compartment path runs") test keeps input[1] in agreement with params
     * since it exercises the positive path, not the argument-vs-global distinction.
     * UNVERIFIED LOCALLY (nf-test hangs under qemu on this host).
     */

    test("folds a new cycle: emits combined geojson, merged csv, and pyramid") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                // New cycle: one non-reference slide with DAPI + a new marker.
                input[0] = Channel.of([
                    [ id: 'P001_cycle2', patient_id: 'P001', is_reference: false,
                      channels: ['DAPI','CD8'], images_count: 1, channels_count: 2 ],
                    file('tests/testdata/P001_image.tiff')
                ])
                input[1] = [compartments: false, expanded: false, embedMasks: false]
                """
            }
            params {
                // quantify_compartments deliberately NOT overridden (defaults true)
                // -- input[1] above is a LITERAL with compartments: false, proving
                // ADD_CYCLE honours the compartment_mode ARGUMENT (which gates
                // whether EXTRACT_NUCLEI_PROPERTIES runs), not a re-read of the --
                // here, conflicting -- global param.
                outdir = "$outputDir"
                mode = 'add_cycle'
                prior_outdir = "$projectDir/tests/testdata/prior_run"
                reg_qc = 1
            }
        }

        then {
            assert workflow.success
            assert workflow.out.geojson
            assert workflow.out.merged_csv
            assert workflow.out.pyramid
        }
    }

    test("reg_qc=2 + expanded quantification: seg_qc emitted, compartment path runs") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'P001_cycle2', patient_id: 'P001', is_reference: false,
                      channels: ['DAPI','CD8'], images_count: 1, channels_count: 2 ],
                    file('tests/testdata/P001_image.tiff')
                ])
                input[1] = [compartments: true, expanded: true, embedMasks: false]
                """
            }
            params {
                // The positive path (compartments genuinely on): input[1] agrees
                // with params here on purpose, since this test's whole point (per
                // its name) is exercising the "compartment path runs" behaviour,
                // not the argument-vs-global distinction the two compartments-off
                // tests in this file prove.
                outdir = "$outputDir"
                mode = 'add_cycle'
                prior_outdir = "$projectDir/tests/testdata/prior_run"
                reg_qc = 2
                quantify_compartments = true
                expanded_quantification = true
            }
        }

        then {
            assert workflow.success
            assert workflow.out.geojson
            assert workflow.out.pyramid
            assert workflow.out.seg_qc   // reg_qc=2 -> WARP_SEG_QC metrics present
        }
    }

    test("reuses the PRIOR reference: the prior run's checkpoint drives registration") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'P001_cycle2', patient_id: 'P001', is_reference: false,
                      channels: ['DAPI','CD8'], images_count: 1, channels_count: 2 ],
                    file('tests/testdata/P001_image.tiff')
                ])
                input[1] = [compartments: false, expanded: false, embedMasks: false]
                """
            }
            params {
                // quantify_compartments deliberately NOT overridden (defaults true)
                // -- input[1] above is a LITERAL with compartments: false, same
                // argument-vs-global proof as the first test in this file.
                outdir = "$outputDir"
                mode = 'add_cycle'
                prior_outdir = "$projectDir/tests/testdata/prior_run"
                reg_qc = 1
                // ADD_CYCLE registers with VALIS unconditionally: it passes the
                // LITERAL 'valis' to the shared REGISTER_PATIENT, never
                // params.registration_method. workflows/mirage.nf rejects
                // --registration_method tiled in add_cycle mode, but a caller that
                // invokes ADD_CYCLE directly -- this test, for one -- bypasses that
                // guard entirely, so the guarantee has to be pinned HERE too.
                // tests/subworkflows/local/register_patient.nf.test proves
                // REGISTER_PATIENT honours its argument; this proves add_cycle.nf
                // passes the right one. Neither test alone is sufficient.
                registration_method = 'tiled'
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Set to 'tiled' above and still not tiled: the literal wins.
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('TILED_') }.size() == 0 },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('REGISTER') }.size() == 1 },
                // The reusable masks come from the prior PYRAMID's embedded mask
                // series, not from postprocessed.csv's cell_mask column: this pins
                // that EXTRACT_MASK_SERIES really runs inside ADD_CYCLE.
                // Exactly one patient in the prior run -> one extraction, one merge.
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('EXTRACT_MASK_SERIES') }.size() == 1 },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('MERGE_QUANT_CSVS') }.size() == 1 }
            )
        }
    }

    /*
     * THE ASSERTION WITH TEETH for the native-image join (Task 8). ch_for_qc pairs the
     * new cycle's NATIVE (pre-registration) image -- ch_new_pre, the same channel
     * ch_grouped hands to REGISTER_PATIENT -- to its own registered file via
     * `.join(ch_new_pre.map { ... }, by: 0)` keyed on meta.id. add_cycle registers
     * exactly one new slide per patient, so a wrong key cannot cross-pair two slides
     * the way registration.nf's twin test can prove; the only observable failure mode
     * here is join() silently dropping the pair -- ch_for_qc, and therefore
     * GENERATE_REGISTRATION_QC, would emit nothing while workflow.success stays true.
     * GENERATE_REGISTRATION_QC stages its native input into its own `native/`
     * subdirectory (stageAs: 'native/*'), so finding it at all is the proof the join
     * matched, and the file it contains being the new cycle's preprocessed output (not
     * empty, not the frozen reference) is the proof of WHICH slide matched.
     */
    test("Should pair the new cycle's own native image with its registered file - stub") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'P001_cycle2', patient_id: 'P001', is_reference: false,
                      channels: ['DAPI','CD8'], images_count: 1, channels_count: 2 ],
                    file('tests/testdata/P001_image.tiff')
                ])
                input[1] = [compartments: false, expanded: false, embedMasks: false]
                """
            }
            params {
                outdir = "$outputDir"
                mode = 'add_cycle'
                prior_outdir = "$projectDir/tests/testdata/prior_run"
                reg_qc = 1
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                {
                    def taskDirs = []
                    new File("$workDir").eachFileRecurse { f ->
                        if (f.isDirectory() && f.name == 'native') {
                            taskDirs << f.parentFile
                        }
                    }
                    assert taskDirs.size() == 1 :
                        "expected 1 GENERATE_REGISTRATION_QC task dir, found ${taskDirs.size()} " +
                        "-- a dropped join (wrong meta.id key on either side) leaves this at 0"

                    def nativeFiles = new File(taskDirs[0], 'native').listFiles()
                    assert nativeFiles.size() == 1 :
                        "expected exactly one staged native file, found ${nativeFiles*.name}"
                    // The teeth: the staged native file is the NEW CYCLE's own
                    // preprocessed output, not empty and not the frozen prior
                    // reference (whose meta.id is 'P001_reference', never
                    // 'P001_cycle2') -- so a join keyed on the wrong side's meta.id
                    // could not have produced this pairing by accident.
                    assert nativeFiles[0].name.contains('P001_cycle2') :
                        "staged native file was '${nativeFiles[0].name}', expected the new " +
                        "cycle's own preprocessed output (named from meta.id 'P001_cycle2')"

                    def registeredFiles = taskDirs[0].listFiles()
                        .findAll { it.name.endsWith('_registered.ome.tiff') }
                    assert registeredFiles.size() == 1
                    assert registeredFiles[0].name.contains('CD8') :
                        "registered file staged alongside it was '${registeredFiles[0].name}', " +
                        "expected the new cycle's own DAPI_CD8 channel set"
                }
            )
        }
    }

}
