            }
            // Exact, not a lower bound: a lower bound lets a path column disappear
            // from a manifest without anyone noticing.
            assert checked == 19 :
                "expected 19 recorded paths, examined ${checked} — did the CSV columns change?"
            // ONE assertion covering both properties, deliberately: Groovy aborts at
            // the first failed assert, so splitting them would hide the work-directory
