nextflow_process {

    name "Test TILED_COARSE process"
    script "modules/local/tiled_coarse.nf"
    process "TILED_COARSE"

    tag "modules"
    tag "modules_local"
    tag "tiled_coarse"

    test("Should emit an M0 anchor and a tile plan - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['DAPI', 'CD3'], is_reference: false ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.m0
            assert process.out.tiles
            assert process.out.versions
            with(process.out.m0) {
                assert size() == 1
                assert get(0).get(1).toString().endsWith('_m0.json')
            }
        }
    }

    test("Should render --max-dim so the anchor runs on a thumbnail - rendered command") {

        // Tagged `stub` so CI's blocking `nf-test test --tag stub` gate collects it, but
        // deliberately WITHOUT `options "-stub"` -- `-stub` never evaluates a `script:`
        // block, so no stub run can observe a rendered command. Same shape as
        // tests/modules/seg_qc_geojson.nf.test's "rendered command" case.
        //
        // This is the assertion with teeth for the OOM fix: --max-dim is what bounds the
        // COARSE anchor to a thumbnail. Without it the anchor would warp and FFT the
        // native-resolution plane ~50 times, against a memory request derived from this very
        // flag. (When the anchor was a U-Net that was thousands of GB -- how patient 052
        // exhausted all four attempts with exit status 137; the pre-change module rendered no
        // such flag at all.) 1024 is the 'high' tier's refine resolution since 2026-09-27.
        //
        // The assertions read the rendered .command.sh rather than the process outcome, so
        // the case holds whether tiled_coarse.py itself succeeds; under `--profile test` no
        // container engine is active and the host may lack skimage/zarr.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['DAPI', 'CD3'], is_reference: false ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('${projectDir}/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('tiled_coarse.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered TILED_COARSE .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--max-dim 1024') },
                    "rendered command missing --max-dim (params.reg_tiled_coarse_max_dim 'high' tier 1024): " + rendered.join(' --- ') },
                // the pre-existing flags must survive the change
                { assert rendered.every { it.contains('--tile 2048') },
                    "rendered command missing --tile: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--halo 256') },
                    "rendered command missing --halo: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should resolve the nuclear index from channel metadata, not a fixed 0 - rendered command") {

        // The teeth for the DAPI-hardcode fix. `channels` here has NO DAPI and puts the
        // nuclear marker (CELLTOX, params.nuclear_markers' second entry) at index 1, so a
        // correct module renders `--nuclear-index 1`. The pre-change module read the fixed
        // `params.reg_tiled_dapi_index = 0` and rendered `--dapi-index 0` for this same
        // input -- estimating the whole-slide anchor from CD3 instead of the fiducial.
        //
        // `stub` tag but NO `options "-stub"`: -stub never evaluates a script: block, and
        // the rendered command is the whole assertion. Same shape as the --max-dim case above.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['CD3', 'CELLTOX'], is_reference: false ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('${projectDir}/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('tiled_coarse.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered TILED_COARSE .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--nuclear-index 1') },
                    "nuclear index not resolved from channel metadata (expected 1 for ['CD3','CELLTOX']): " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--dapi-index') },
                    "the renamed flag is gone from the module; --dapi-index survives only as a deprecated Python alias: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should let reg_tiled_nuclear_index override the resolved index - rendered command") {

        tag "stub"

        when {
            params {
                reg_tiled_nuclear_index = 0
            }
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['CD3', 'CELLTOX'], is_reference: false ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('${projectDir}/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('tiled_coarse.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered TILED_COARSE .command.sh found under the task work dir" },
                // 0 is what metadata resolution would NOT pick here, so this proves the
                // override is honoured rather than coincidentally agreeing with the resolver.
                { assert rendered.every { it.contains('--nuclear-index 0') },
                    "explicit params.reg_tiled_nuclear_index was not honoured: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should render the tier's values when reg_tiled_mode is not high - rendered command") {

        // `stub` tag but NO `options "-stub"`: -stub never evaluates a script: block, so a stub
        // run cannot see which tier's numbers reached the command. Same idiom as the case above.
        //
        // The assertion with teeth for the preset refactor: reg_tiled_tile/halo/coarse_max_dim are
        // null in nextflow.config and resolve through RegPresets at render time. If that wiring
        // regresses, the flags render as 'null' (or stay at the high values) and every non-high
        // tier silently becomes a no-op -- the run would look completely normal.
        tag "stub"

        when {
            params {
                reg_tiled_mode = 'low'
            }
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['DAPI', 'CD3'], is_reference: false ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('${projectDir}/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('tiled_coarse.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered TILED_COARSE .command.sh found under the task work dir" },
                // RegPresets.STARE.low
                { assert rendered.every { it.contains('--tile 512') },
                    "the 'low' tier did not reach --tile: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--halo 128') },
                    "the 'low' tier did not reach --halo: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--max-dim 512') },
                    "the 'low' tier did not reach --max-dim: " + rendered.join(' --- ') },
                // The failure mode a broken resolution would produce, called out explicitly so
                // the message names the cause rather than just showing a missing flag. Matched on
                // the FLAG VALUE, not the whole script: shell redirections legitimately contain
                // '/dev/null' and a bare contains('null') fires on those.
                { assert rendered.every { r -> ['--tile null', '--halo null', '--max-dim null'].every { !r.contains(it) } },
                    "a tier-owned knob rendered as literal 'null' -- RegPresets resolution is " +
                    "not wired: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should let a custom override beat the tier - rendered command") {

        tag "stub"

        when {
            params {
                reg_tiled_mode = 'custom'
                reg_tiled_tile = 4096
            }
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['DAPI', 'CD3'], is_reference: false ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('${projectDir}/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('tiled_coarse.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1, "no rendered TILED_COARSE .command.sh found" },
                { assert rendered.every { it.contains('--tile 4096') },
                    "the explicit override did not win over the tier: " + rendered.join(' --- ') },
                // ...and everything NOT overridden still comes from 'high', which is what
                // "custom starts from high" means. A custom tier that zeroed the rest would be
                // a very different contract.
                { assert rendered.every { it.contains('--halo 256') },
                    "custom did not inherit halo from the high row: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--max-dim 1024') },
                    "custom did not inherit max-dim from the high row: " + rendered.join(' --- ') }
            )
        }
    }
}
