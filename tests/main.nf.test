    test("Should publish quantification, geojson and the zarr when starting at postprocessing - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_segmented.csv"
                outdir = "$outputDir"
                start = "postprocessing"
            }
        }

        then {
            assert workflow.success
            assert new File("$outputDir/P001/quantification").isDirectory()
            assert new File("$outputDir/P001/geojson").isDirectory()
            assert new File("$outputDir/P001/spatialdata/P001.zarr").isDirectory()
            assert !new File("$outputDir/csv/registered.csv").exists() : "no registration ran, so no registration checkpoint may be written"
        }
    }

}
