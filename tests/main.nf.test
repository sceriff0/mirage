        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_postprocessing.csv"
                outdir = "$outputDir"
                start = "segmentation"
            }
        }

        then {
            assert workflow.success
            assert new File("$outputDir/csv/segmented.csv").exists() : "segmented.csv is the step's checkpoint"
            assert new File("$outputDir/csv/postprocessed.csv").exists() : "the run continued to the end"
            assert new File("$outputDir/P001/geojson").isDirectory()
        }
