/*
 * buildManifest / buildRunSummary: the run_summary.json content builders used by
 * FINAL_QC's ch_run_summary closure (subworkflows/local/final_qc.nf). GENERATE_QC_REPORT's
 * stub never exposes run_summary.json to a workflow-level test, so these call the
 * builders directly.
 *
 * buildRunSummary takes params/pipeline-info/timestamp as arguments so it is callable
 * with no live params or workflow binding; the test fixes the timestamp itself.
 */
nextflow_function {

    name "Test buildManifest / buildRunSummary (run_summary.json content)"
    script "subworkflows/local/final_qc.nf"

    tag "stub"

    test("buildManifest reads declared_channels, not channels -- linear path") {

        function "buildManifest"

        when {
            function {
                """
                input[0] = [
                    stop: 'postprocessing',
                    patients: [P001: 2],
                    channels: [P001: 4],
                    declared_channels: [P001: 5],
                ]
                """
            }
        }

        then {
            assert function.success
            assert function.result == [
                totals: [patients: 1, images: 2, channels: 5],
                patients: [P001: [images: 2, channels: 5]],
            ]
        }
    }

    test("buildManifest reads declared_channels, not channels -- reference-less sheet") {

        // The regression this whole task closes: a 3-channel sheet declares DAPI on
        // its (non-reference) rows, but channels_count drops DAPI when INPUT_CHECK
        // runs with autoReference=false (dev's add_cycle path is the live example).
        // Before this task the manifest read `channels` and silently reported 2.
        function "buildManifest"

        when {
            function {
                """
                input[0] = [
                    stop: 'postprocessing',
                    patients: [P001: 1],
                    channels: [P001: 2],
                    declared_channels: [P001: 3],
                ]
                """
            }
        }

        then {
            assert function.success
            assert function.result == [
                totals: [patients: 1, images: 1, channels: 3],
                patients: [P001: [images: 1, channels: 3]],
            ]
        }
    }

    test("buildRunSummary assembles the complete run_summary.json content -- linear path") {

        function "buildRunSummary"

        when {
            function {
                """
                input[0] = [
                    stop: 'postprocessing',
                    patients: [P001: 2],
                    channels: [P001: 4],
                    declared_channels: [P001: 5],
                ]
                input[1] = [
                    mode: null,
                    start: 'preprocessing',
                    registration_method: 'valis',
                    seg_method: 'cellpose',
                    quantify_compartments: false,
                    expanded_quantification: false,
                    pixel_size: 0.5,
                ]
                input[2] = [name: 'mirage', version: '1.0.0']
                input[3] = '2026-08-06 00:00:00 UTC'
                """
            }
        }

        then {
            assert function.success
            // Every field of run_summary.json is pinned exactly, totals and
            // per-patient; the timestamp is our own input.
            assert function.result == [
                pipeline: [name: 'mirage', version: '1.0.0'],
                run: [
                    timestamp: '2026-08-06 00:00:00 UTC',
                    mode: null,
                    start: 'preprocessing',
                    stop: 'postprocessing',
                ],
                params: [
                    registration_method: 'valis',
                    seg_method: 'cellpose',
                    quantify_compartments: false,
                    expanded_quantification: false,
                    pixel_size: 0.5,
                ],
                manifest: [
                    totals: [patients: 1, images: 2, channels: 5],
                    patients: [P001: [images: 2, channels: 5]],
                ],
            ]
        }
    }

    test("buildRunSummary assembles the complete run_summary.json content -- reference-less sheet") {

        function "buildRunSummary"

        when {
            function {
                """
                input[0] = [
                    stop: 'postprocessing',
                    patients: [P001: 1],
                    channels: [P001: 2],
                    declared_channels: [P001: 3],
                ]
                input[1] = [
                    mode: 'standard',
                    start: 'preprocessing',
                    registration_method: 'valis',
                    seg_method: 'cellpose',
                    quantify_compartments: false,
                    expanded_quantification: false,
                    pixel_size: 0.5,
                ]
                input[2] = [name: 'mirage', version: '1.0.0']
                input[3] = '2026-08-06 00:00:00 UTC'
                """
            }
        }

        then {
            assert function.success
            assert function.result == [
                pipeline: [name: 'mirage', version: '1.0.0'],
                run: [
                    timestamp: '2026-08-06 00:00:00 UTC',
                    mode: 'standard',
                    start: 'preprocessing',
                    stop: 'postprocessing',
                ],
                params: [
                    registration_method: 'valis',
                    seg_method: 'cellpose',
                    quantify_compartments: false,
                    expanded_quantification: false,
                    pixel_size: 0.5,
                ],
                manifest: [
                    totals: [patients: 1, images: 1, channels: 3],
                    patients: [P001: [images: 1, channels: 3]],
                ],
            ]
        }
    }
}
