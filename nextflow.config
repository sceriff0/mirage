/*
========================================================================================
    MIRAGE WSI Processing Pipeline - Main Configuration
========================================================================================
    Author: mirage team
    Version: 1.0.0
========================================================================================
*/


// Pinned to an exact version so a plugin release cannot change validation on a rerun.
// 2.5.1 is the newest nf-schema that supports Nextflow >=25.04.0 (2.6.0+ need >=25.10.0).
// Air-gapped clusters must pre-provision it: see docs/hpc.md, "Offline / air-gapped execution".
plugins {
    id 'nf-schema@2.5.1'
}

validation {
    // Fail the launch on an unknown --param instead of reading it as null.
    // nf-schema 2.5.1 has no `failUnrecognisedParams`; this log level is its equivalent.
    logging {
        unrecognisedParams = 'error'
    }

    // params/*.json presets document each section with a "_comment_<section>" key, which
    // becomes a real param under -params-file. Hand-maintained: add new section names here.
    ignoreParams = [
        '_comment_io',
        '_comment_output',
        '_comment_preproc',
        '_comment_reg_common',
        '_comment_reg_valis',
        '_comment_resources',
        '_comment_seg',
        '_comment_seg_method',
        '_comment_trace',
        '_comment_workflow',
        // Retired param. Let through nf-schema so ParamUtils.checkRetiredParams answers it
        // with a specific message. Never declare it again.
        'reg_tiled_mode',
    ]
}

// Pipeline metadata
manifest {
    name            = 'mirage'
    description     = 'WSI processing pipeline (preprocessing, registration, segmentation, quantification, GeoJSON export)'
    author          = 'Valerio Fassi, Yinxiu Zhan'
    version         = '1.0.0'
    nextflowVersion = '>=25.04.0'
    mainScript      = 'main.nf'
}


/*
========================================================================================
    Pipeline Parameters
========================================================================================
*/

params {
    // Input/output
    input              = null
    outdir             = null

    // Workflow control
    start          = 'preprocessing'  // preprocessing | registration | segmentation | postprocessing
    stop           = null            // null = run to end; or: preprocessing | registration | segmentation | postprocessing
    dry_run        = false
    debug_channels = false

    // Cluster options
    slurm_partition = null
    slurm_account   = null
    slurm_qos       = null
    // GRES for GPU jobs, rendered as `--gres=gpu:${gpu_type}` on SEGMENT when seg_gpu is true.
    // '1' means any one GPU; a typed value (e.g. 'nvidia_h200:1') belongs in a site config.
    gpu_type        = '1'

    // Preprocessing (BaSiC illumination correction, via nf-core's BASICPY module at its
    // upstream defaults: no darkfield, no autotune).
    skip_preprocessing        = true   // CONVERT_IMAGE only, no BaSiC. Set false in a
                                       // -params-file or profile (not on the CLI) to correct.
    preproc_skip_nuclear      = true   // nuclear/fiducial channels (params.nuclear_markers)
                                       // bypass BaSiC, so registration and segmentation see
                                       // the uncorrected fiducial
    preproc_tile_size         = 1950   // BaSiC FOV tile size (px)
    preprocess_qc_scale_factor = 0.25
    skip_preprocess_qc         = false

    // Nuclear/fiducial channel, in order of preference. The first marker found in the channel
    // metadata is moved to channel 0 by CONVERT_IMAGE and drives both segmentation and the
    // registration fiducial. Fails if none is present (single-channel images excepted).
    nuclear_markers      = ['DAPI', 'CELLTOX']

    // Registration (common)
    registration_method  = 'tiled'         // 'tiled' (STARE) | 'valis'. STARE is fully parallel and
                                           // JVM-free; each task asks 2-4 GB at the defaults.
    reg_qc               = 2                // 0=none, 1=DAPI overlay, 2=overlay + segmentation-overlap
                                            // dice/displacement
    qc_scale_factor      = 0.25

    // reg_qc=2 cell pairing: 'lsa' = optimal one-to-one assignment within the match radius;
    // 'mutual_nn' = greedy mutual nearest neighbour.
    seg_qc_pairing             = 'lsa'
    // Match radius in median nuclear radii. Tighten toward 1.0 for 'mutual_nn'.
    seg_qc_match_radius_factor = 1.5
    // reg_qc=2: reuse QC nuclei from another run's --outdir (same native slides, same
    // seg_method) instead of segmenting again. null = segment.
    seg_qc_nuclei_dir          = null

    // Registration (tiled / STARE), used only when registration_method='tiled'.
    // A stale reg_tiled_mode is refused at launch (ParamUtils.checkRetiredParams).

    // Nuclear channel index for the transform. null = resolve from channel metadata against
    // params.nuclear_markers; set an integer only to override.
    reg_tiled_nuclear_index    = null

    // Geometry
    reg_tiled_tile             = 2048             // tile core size (px) = one REG_TILE task
    reg_tiled_halo             = 256              // SOLVE's range-gate default (px) and COARSE's anchor
                                                  // warning. Not a read margin: REG_TILE reads
                                                  // core + 3*reg_tiled_stride
    reg_tiled_out_tile         = 1024             // streaming stitch write-tile size (px)
    reg_tiled_coarse_max_dim   = 1024             // COARSE anchor thumbnail, longest side (px). Lower =
                                                  // cheaper, coarser M0; its residual must stay inside
                                                  // reg_tiled_halo. Values below 256 abort at launch.

    // Gating / resolution. SOLVE always runs dctpls (robust affine + robust DCT-PLS).
    reg_tiled_max_disp         = null             // range gate: drop a window vector with |displacement|
                                                  // (px) at or beyond this. null = reg_tiled_halo.
    reg_tiled_stride           = 64               // vector-lattice stride (px): one displacement vector per
                                                  // node, window W = 2*stride (50 % overlap), ~21 um at
                                                  // 0.325 um/px. Pass 1 recovers +-stride px of anchor
                                                  // error. Read box is core + 3*stride per side, so
                                                  // TILED_REG_TILE's memory derives from it.

    // Registration (VALIS): valis-wsi 1.2.0 at its defaults. The earlier tuned configuration
    // is kept at the git tag archive/valis-mirage-tuned.
    //   'default' register() at valis-wsi defaults (no micro pass)
    //   'hires'   valis-wsi's high-resolution example as shipped: MicroRigidRegistrar, then
    //             register_micro() at floor(0.25 x the smallest slide's longest side).
    //             Its known micro-pass defect is not fixed. REGISTER asks 128 GB on attempt 1.
    reg_valis_mode             = 'default'        // 'default' | 'hires'
    // JVM heap (GiB) for VALIS/Bio-Formats in REGISTER. null = VALIS's own 10 GB.
    reg_jvm_heap_gb            = null

    // Segmentation
    // 'stardist' uses the trained model on the Hugging Face Hub (segmentation_model, pinned
    // to a commit), downloaded on first use into segmentation_model_dir (or the task dir);
    // a copy already there is used offline. 'instantseg' needs no trained model
    // (Apache-2.0 weights); CellSAM/Cellpose/Mesmer weights are gated or non-commercial.
    seg_method             = 'stardist' // 'stardist' | 'instantseg' | 'cellsam'
    seg_gpu                = true
    seg_pmin               = 1.0
    seg_pmax               = 99.8
    // StarDist detection probability threshold. null = the model's built-in default.
    seg_prob_thresh        = null
    seg_n_tiles_y          = 16
    seg_n_tiles_x          = 16
    seg_expand_distance    = 10
    segmentation_model_dir = null
    // hf://<owner>/<repo>@<commit> | a folder name under segmentation_model_dir | a StarDist built-in
    segmentation_model     = 'hf://DSUnit/stardist@68b94406104bb069a58b64f4c890375c7f2f15df'

    // Segmentation (InstanSeg backend; only used when seg_method='instantseg')
    seg_instantseg_model      = 'fluorescence_nuclei_and_cells'
    // Only 'all_outputs' is accepted: 'cells' or 'nuclei' return one label map, which would
    // leave Cytoplasm = Cell - Nucleus empty.
    seg_instantseg_target     = 'all_outputs'
    // Tiled inference: tile_size in px at the model's pixel size; batch_size = tiles per
    // forward pass (raise on large GPUs, lower on small ones to avoid OOM).
    seg_instantseg_tile_size  = 512
    seg_instantseg_batch_size = 16
    // Writable host path for InstanSeg's model cache (INSTANSEG_BIOIMAGEIO_PATH). null = a
    // per-task cache that re-downloads each task.
    instanseg_model_dir    = null

    // Segmentation (CellSAM backend; only used when seg_method='cellsam')
    // CellSAM segments the nuclear channel; the cell mask is nuclei expanded by
    // seg_expand_distance. bbox_threshold trades precision for recall; use_wsi enables
    // CellSAM's native tiling (block_size/overlap).
    seg_cellsam_bbox_threshold = 0.4
    seg_cellsam_use_wsi        = true
    // Upstream default is 400; 1024 cuts the tile count ~6x. Keep within [256, 2048].
    seg_cellsam_block_size     = 1024
    seg_cellsam_overlap        = 56
    // Pre-downloaded CellSAM weights. null = download at runtime (needs DEEPCELL_ACCESS_TOKEN).
    cellsam_model_path         = null

    // Quantification
    // true: route SEGMENT's nuclear mask into QUANTIFY for Nucleus / Cytoplasm / Cell signal
    // (cytoplasm = cell - nucleus). false: whole-cell only.
    quantify_compartments   = true
    // Median is always computed. true adds Mean and Sum per compartment (triples the columns).
    expanded_quantification = false

    // GeoJSON export. Polygons are display-only (quantification is mask-derived), so
    // simplifying them does not affect analysis.
    simplify_tolerance       = 1.0   // Douglas-Peucker tolerance (px) for contour simplification
    geojson_coord_precision  = 2     // decimal places for GeoJSON coordinates

    // ---- SpatialData (.zarr) export ------------------------------------------------
    // Additive scverse-native output; OME-TIFF + GeoJSON remain the primary artifacts.
    skip_spatialdata_export         = false
    // Including the image duplicates the pyramid inside the .zarr. Turn on for a
    // self-contained, depositable object.
    spatialdata_include_image       = false
    // Max centroid distance (px) when joining warp_seg_qc's per-cell residuals onto cell_mask.
    // The QC segmentation shares no label space with cell_mask, so the join is spatial.
    spatialdata_residual_join_max_px = 15.0

    // Postprocessing QC
    skip_postprocessing_qc = false

    // Reference-free cell-segmentation quality scoring (CSE, 2D). Opt-in: its `segeval` image
    // may not be published yet. Enable with the `seg_quality` profile or
    // -params-file params/seg_quality_eval.json, not on the command line.
    skip_seg_quality_eval = true
    cse_pixel_size_um     = null
    // Bin image+masks so CSE scores at most this many pixels; full-WSI masks exhaust its
    // memory. The QualityScore shifts with the factor, so keep it fixed across a cohort.
    // null = full resolution.
    cse_max_pixels        = 50000000

    // Final QC report
    skip_final_qc_report   = false

    // Image and pyramid output
    // Micrometres per pixel. 'auto' reads PhysicalSizeX from each image's OME metadata;
    // PREFLIGHT_SCALE fails the run before heavy work if it cannot. A number overrides the
    // metadata for every slide (warned about, never refused).
    pixel_size          = 'auto'
    tilex               = 512
    pyramid_resolutions = 8
    pyramid_scale       = 2
    compression         = 'zstd'

    // Resource limits. max_cpus and max_memory have no default: nf-schema requires the run
    // (or a profile) to set them. Declared null so this block matches nextflow_schema.json.
    max_cpus         = null
    max_memory       = null
    max_time         = '240.h'

    // Concurrency. One knob sets both caps: max_forks = concurrency (per process),
    // queue_size = 4 x concurrency (whole pipeline). Set max_forks/queue_size to override.
    // They are null here because the derivation must see CLI values; it lives in the
    // "Concurrency" block at the bottom of this file. A `-c` file cannot change these
    // (ParamUtils.validateFrozenConfig refuses the run); use the CLI, -params-file or a profile.
    concurrency      = 5
    max_forks        = null
    queue_size       = null

    // Tracing. Like concurrency, a `-c` file cannot change these.
    enable_trace     = true             // Enable detailed execution tracing
    trace_dir        = '.trace'          // Directory for trace outputs (independent of outdir)

    // Output cleanup.
    //   'none'  publish everything; the output can be re-entered by `--start <step>` or
    //           mode='add_cycle'.
    //   'final' publish only pyramid/, geojson/, quantification/, the SpatialData .zarr and
    //           run-level qc/, csv/, size_logs/. Intermediates are never published.
    //           add_cycle is refused at this level (ParamUtils.validateCleanup).
    // Layout.FINAL_KINDS owns the split; each publishDir gates in its `saveAs:` closure.
    cleanup_level    = 'none'

    // Delete the work directory after a successful run (a failed run keeps it). Conflicts
    // with -resume, so ParamUtils.validateCleanup warns when both are in play. Like
    // concurrency, a `-c` file cannot change it.
    cleanup_work     = true

    // Incremental cyclic-IF mode. 'standard' = normal start/stop pipeline;
    // 'add_cycle' = fold a new imaging cycle into a prior completed run.
    mode         = 'standard'
    // For mode='add_cycle': the --outdir of the previously completed run,
    // whose csv/registered.csv and csv/postprocessed.csv provide the reusable
    // reference, segmentation mask, merged quantification table, and pyramid.
    prior_outdir = null
    // Embed cell_mask + nuclei_mask as a second series in the pyramid OME-TIFF. Written only
    // when this, quantify_compartments and expanded_quantification are all true.
    // See docs/add_cycle.md.
    embed_masks  = false

}

/*
========================================================================================
    Modular configuration
========================================================================================
    Must stay after the params block: these files read params.*, which is not yet set
    above it. Must stay before the executor/process blocks below, which take precedence.
*/
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// queueSize and maxForks are set in the "Concurrency" block at the bottom, after profiles.
process {
    stageInMode     = 'symlink'  // zero overhead, works cross-filesystem
    // Must stay a closure: a plain map would freeze params.max_* before profiles are merged.
    resourceLimits  = { [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ] }
}

/*
========================================================================================
    Execution Profiles
========================================================================================
    Container images are declared per-process in modules/local/*.nf
========================================================================================
*/

profiles {
    // Test profile (small dataset validation)
    test {
        includeConfig 'conf/test.config'
    }

    // Test full profile (complete dataset)
    test_full {
        includeConfig 'conf/test_full.config'
    }

    // Test profile with the InstanSeg backend.
    instantseg_test {
        includeConfig 'conf/test.config'
        params.seg_method = 'instantseg'
    }

    // Test profile with the CellSAM backend.
    cellsam_test {
        includeConfig 'conf/test.config'
        params.seg_method = 'cellsam'
    }

    // Runs the shipped pixel_size and seg_method defaults, which conf/test.config overrides.
    // Does not include conf/test.config, so both inherit straight from the params block.
    shipped_defaults_test {
        // The only fixture pair with a real OME PhysicalSizeX/Y, so `auto` can resolve it.
        params.input      = "${projectDir}/tests/testdata/shipped_defaults_input.csv"
        params.outdir     = 'shipped_defaults_results'

        // CI-sized limits, as in conf/test.config.
        params.max_cpus   = 2
        params.max_memory = '6.GB'
        params.max_time   = '1.h'

        // Must split the 128x128 fixtures into at least 2 BaSiC FOVs.
        params.preproc_tile_size = 64

        // CI runners have no GPU.
        params.seg_gpu = false
    }

    // Turns on the opt-in CSE segmentation-quality scorer. A profile because a boolean
    // passed on the command line arrives as a non-empty (truthy) string.
    seg_quality {
        params.skip_seg_quality_eval = false
    }

    // Docker (local development with containers)
    docker {
        docker.enabled         = true
        // Images are linux/amd64 only; --platform lets Apple-silicon Docker run them under
        // emulation. No effect on an amd64 host.
        docker.runOptions      = '-u $(id -u):$(id -g) --platform linux/amd64'
        singularity.enabled    = false
        conda.enabled          = false
    }

    // Singularity (HPC with containers)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
        // Forward the token by name so its value never lands in .command.run.
        singularity.envWhitelist = 'DEEPCELL_ACCESS_TOKEN'
        // No ociAutoPull: the head pulls each image once into the cache. With it, tasks
        // convert images concurrently into Apptainer's cache, which is not safe for
        // concurrent writers.
    }

    // SLURM execution
    slurm {
        process.executor = 'slurm'
        process.queue    = { params.slurm_partition }
        process.clusterOptions = {
            def opts = []
            if (params.slurm_account && params.slurm_account != '') opts << "--account=${params.slurm_account}"
            if (params.slurm_qos && params.slurm_qos != '')         opts << "--qos=${params.slurm_qos}"
            return opts ? opts.join(' ') : null
        }
        // No resourceLimits here: a plain map would freeze and shadow the top-level closure.
    }

    // Local development (no SLURM)
    local {
        process.executor  = 'local'
        // Clamp requests to a workstation. Read lazily by process.resourceLimits.
        params.max_cpus   = 4
        params.max_memory = '16.GB'
        params.max_time   = '72.h'
        // resourceLimits clamps a larger request silently and the task then OOMs, so keep
        // hand-raised STARE knobs inside this budget. See docs/resources.md.
    }
}

/*
========================================================================================
    Execution Tracing (Optional)
========================================================================================
*/

trace {
    enabled   = params.enable_trace
    file      = "${params.trace_dir}/trace.txt"
    fields    = 'task_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,cpus,memory,peak_rss,peak_vmem,rchar,wchar'
    overwrite = true
}

report {
    enabled   = params.enable_trace
    file      = "${params.trace_dir}/report.html"
    overwrite = true
}

timeline {
    enabled   = params.enable_trace
    file      = "${params.trace_dir}/timeline.html"
    overwrite = true
}



/*
========================================================================================
    Work-Directory Cleanup (Optional)
========================================================================================
    Nextflow removes the work directory after a successful run, at session teardown
    (after the resource report has read the trace). A scalar: frozen before any `-c` file.
*/

cleanup = params.cleanup_work

/*
========================================================================================
    Concurrency -- must stay after `profiles {}`
========================================================================================
    queueSize and maxForks are scalars (maxForks cannot be a closure), so they freeze
    against params at this line: here they see profiles, the CLI and -params-file, but not
    a `-c` file. ParamUtils.validateFrozenConfig refuses a run where they disagree.
    Not in conf/base.config: there `params.queue_size` would parse as a nested scope.
    Explicit null tests, not `?:`, because 0 is falsy in Groovy.
*/

executor {
    queueSize = (params.queue_size != null ? params.queue_size : (params.concurrency as int) * 4) as int
}

process {
    // Per-process cap. At the defaults it (5) is lower than queueSize (20), so it binds.
    maxForks = (params.max_forks != null ? params.max_forks : params.concurrency) as int

    // Higher caps for four processes, still bounded by the same parameter.
    // Mirrored in ParamUtils.PER_PROCESS_MAX_FORKS_CAP.
    withName: 'REGISTER'       { maxForks = Math.min(10, (params.max_forks != null ? params.max_forks : params.concurrency) as int) }
    withName: 'TILED_REG_TILE' { maxForks = Math.min(20, (params.max_forks != null ? params.max_forks : params.concurrency) as int) }
    withName: 'TILED_COARSE'   { maxForks = Math.min(20, (params.max_forks != null ? params.max_forks : params.concurrency) as int) }
    withName: 'TILED_STITCH'   { maxForks = Math.min(10, (params.max_forks != null ? params.max_forks : params.concurrency) as int) }
}
