            // passthrough reference at the PRIOR run's outdir (verified — a run with
            // --outdir /tmp/A correctly wrote /tmp/B/P001/preprocessed/... into its
            // own registered.csv). Excluding workDir is the correct shape; requiring
            // an outputDir prefix is not.
            def csvDir = new File("${outputDir}/csv".toString())
            assert csvDir.isDirectory() : "no csv/ directory was published"

            // Globbed, not a hardcoded step list: a fourth checkpoint manifest is
            // covered the day it is added instead of silently going unchecked.
            def manifests = (csvDir.listFiles() ?: [])
                .findAll { it.name.endsWith('.csv') }
                .sort { it.name }
            assert manifests.size() == 4 :
                "expected 4 checkpoint manifests, found ${manifests.size()}: " +
                manifests*.name

            def work = new File("${workDir}".toString()).absolutePath
            def problems = []
            def checked  = 0
            manifests.each { csv ->
                csv.readLines().drop(1).findAll { it.trim() }.each { line ->
                    csvFields(line).each { field ->
                        // Absolute fields only: the rest are ids, booleans and
                        // pipe-joined channel names.
                        if (field.startsWith('/')) {
                            checked++
                            if (new File(field).absolutePath.startsWith(work + File.separator))
                                problems << "${csv.name}: inside the work directory (scratch, unpublished) -> ${field}"
                            else if (!new File(field).exists())
                                problems << "${csv.name}: does not exist -> ${field}"
