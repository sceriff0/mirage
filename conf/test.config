/*
========================================================================================
    Test Profile Configuration - nf-core Compliant
========================================================================================
    Minimal test dataset to check pipeline function
    Reference: https://nf-co.re/docs/guidelines/pipelines/recommendations/testing
========================================================================================
*/

params {
    // The synthetic fixtures carry no OME PhysicalSize, so 'auto' would fail at
    // PREFLIGHT_SCALE; pin a number.
    pixel_size = 0.325
    // Limit resources for CI/local testing
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '1.h'

    // Test input data (relative to pipeline root)
    input  = "${projectDir}/tests/testdata/test_input.csv"
    outdir = "test_results"

    // Pipeline step
    start = 'preprocessing'

    // Disable GPU for CI testing
    seg_gpu = false

    // Must split the 128x128 fixtures into at least 2 BaSiC FOVs (64 gives 2x2); BaSiC
    // cannot fit a profile from one site. tests/test_test_profile_fixture_compat.py checks it.
    preproc_tile_size         = 64

    // Segmentation parameters (minimal tiling)
    seg_n_tiles_y             = 2
    seg_n_tiles_x             = 2
    // BaSiC on, away from the shipped default, so the suite covers the preprocessing path.
    // The shipped default is run by the shipped_defaults_test profile.
    skip_preprocessing        = false
    // StarDist pinned explicitly, with a small built-in model instead of the shipped
    // Hugging Face one, so CI does not run the shipped model's weights.
    seg_method                = 'stardist'
    // VALIS, away from the shipped 'tiled': this profile's snapshots were recorded on it.
    // The shipped default is run by the shipped_defaults_test profile.
    registration_method       = 'valis'
    // StarDist built-in model, loaded via StarDist2D.from_pretrained() with no model dir.
    segmentation_model        = '2D_versatile_fluo'
    segmentation_model_dir    = null
    // Lower StarDist detection threshold so the built-in model picks up the
    // small synthetic nuclei in the test fixtures (default ~0.48 misses them).
    seg_prob_thresh           = 0.3

    // QC generation (enabled but minimal)
    skip_registration_qc      = false
    qc_scale_factor           = 0.1

    debug_channels            = false

    // Output cleanup, pinned explicitly so the profile does not move with the defaults.
    // cleanup_work=false: nf-test hashes snapshot files after session teardown, when
    // `cleanup` has already deleted them.
    cleanup_work              = false

    // Module tests assert on published intermediates.
    cleanup_level             = 'none'
}

process {
    // Local executor for testing
    executor = 'local'

    // Default minimal resources
    cpus   = { 1    }
    memory = { 2.GB }
    time   = { 30.m }

    // Resource labels for testing
    withLabel: 'process_single' {
        cpus   = 1
        memory = 2.GB
        time   = 15.m
    }

    withLabel: 'process_low' {
        cpus   = 1
        memory = 2.GB
        time   = 30.m
    }

    withLabel: 'process_medium' {
        cpus   = 2
        memory = 4.GB
        time   = 1.h
    }

    withLabel: 'process_high' {
        cpus   = 2
        memory = 6.GB
        time   = 1.h
    }

    // Error handling for CI
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'
}

// Disable Seqera Platform/Tower for testing (no token needed)
tower {
    enabled = false
}

// Container settings - will be overridden by profile (docker/singularity)
// Don't hardcode docker.enabled here to allow singularity profile to work
