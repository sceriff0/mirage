/*
 * Characterisation tests for lib/Layout.groovy: where a published file
 * lands.
 *
 * nf-test's assertion context cannot see lib/ classes (`No such property: Layout`),
 * so Layout is asserted through the checkpoint CSVs it writes. Those CSVs are a
 * restart contract (`--start registration` opens exactly the paths they name), so
 * the exact strings are the right granularity.
 *
 *   checkpointDir / checkpointCsvName  <outdir>/csv/<step>.csv
 *   publishedPath                      <outdir>/<pid>/<kind>/[<producer subdir>/]<name>;
 *                                      'registered_slides/' and 'export/' must survive,
 *                                      or a restart opens a missing file.
 *   isTaskDir                          matches <work>/<2 hex>/<30 hex> structurally.
 *
 * Every expected line ends in .toString(): List.contains() never matches a GString
 * against a String.
 */

nextflow_pipeline {

    name "Layout — published paths recorded in the checkpoint CSVs"
    script "main.nf"

    tag "pipeline"
    tag "layout"

    test("checkpoint CSVs record exactly the paths Layout constructs") {
        tag "stub"
        options "-stub"

        when {
            params {
                input  = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },

                // --- Layout.checkpointDir + Layout.checkpointCsvName -------------
                { assert path("$outputDir/csv/preprocessed.csv").exists() },
                { assert path("$outputDir/csv/registered.csv").exists() },
                { assert path("$outputDir/csv/postprocessed.csv").exists() },

                // --- Layout.publishedPath: <outdir>/<pid>/<kind>/<basename> ------
                // 'id' comes from Meta.identityFor on the samplesheet's path_to_file
                // ('P001_ref.ome.tiff' -> 'P001_ref'). 'pixel_size' is last: 0.325,
                // what PREFLIGHT_SCALE resolves under conf/test.config.
                { assert path("$outputDir/csv/preprocessed.csv").readLines().contains(
                    "P001,P001_ref,$outputDir/P001/preprocessed/P001_ref_corrected.ome.tif,true,DAPI|PANCK|SMA,0.325".toString()) },
                { assert path("$outputDir/csv/preprocessed.csv").readLines().contains(
                    "P001,P001_mov1,$outputDir/P001/preprocessed/P001_mov1_corrected.ome.tif,false,DAPI|CD3|CD8,0.325".toString()) },

                // --- Layout.publishedPath: the producer subdirectory survives ----
                // REGISTER's 'registered_slides/' subdirectory is carried into the
                // published path; dropping it breaks every `--start registration`.
                { assert path("$outputDir/csv/registered.csv").readLines().contains(
                    "P001,P001_ref,$outputDir/P001/registered/registered_slides/P001_DAPI_PANCK_SMA_registered.ome.tiff,true,DAPI|PANCK|SMA,0.325".toString()) },
                { assert path("$outputDir/csv/registered.csv").readLines().contains(
                    "P001,P001_mov1,$outputDir/P001/registered/registered_slides/P001_DAPI_CD3_CD8_registered.ome.tiff,false,DAPI|CD3|CD8,0.325".toString()) },

                // --- Layout.publishedPath across five different `kind`s ----------
                // The geojson columns carry EXPORT_GEOJSON's `export/` subdirectory.
                // 'postprocessed' rows are per patient: id == patient_id.
                { assert path("$outputDir/csv/postprocessed.csv").readLines().contains(
                    "P001,P001," +
                    "$outputDir/P001/geojson/export/cells_data.csv," +
                    "$outputDir/P001/geojson/export/cells.geojson," +
                    "$outputDir/P001/quantification/merged_quant.csv," +
                    "$outputDir/P001/segmentation/P001_cell_mask.tif," +
                    "$outputDir/P001/pyramid/pyramid.ome.tiff," +
                    "0.325".toString()) },

                // --- column order is part of the contract ------------------------
                // 'pixel_size' is the last column on every schema.
                { assert path("$outputDir/csv/preprocessed.csv").readLines()[0] ==
                    "patient_id,id,preprocessed_image,is_reference,channels,pixel_size" },
                { assert path("$outputDir/csv/registered.csv").readLines()[0] ==
                    "patient_id,id,registered_image,is_reference,channels,pixel_size" },
                { assert path("$outputDir/csv/postprocessed.csv").readLines()[0] ==
                    "patient_id,id,cell_csv,cell_geojson,merged_csv,cell_mask,pyramid,pixel_size" }
            )
        }
    }
}
