    //==========================================================================
    // ROUTER SHAPE — one input read, one QC aggregation
    //==========================================================================

    /*
     * The router used to carry TWO copies of the end-of-run aggregation (the
     * add_cycle copy was introduced as "Mirrors the standard-path aggregation
     * below"). Both paths now go through subworkflows/local/final_qc.nf, so the
     * QC report must come from exactly one call site — and the fully-qualified
     * task name is the evidence of which one. Asserting only that a report exists
     * would still pass if a second, differently-fed aggregation reappeared and
     * overwrote it.
     */
    test("Should aggregate QC exactly once, through FINAL_QC - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:FINAL_QC:GENERATE_QC_REPORT') }.size() == 1 },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('GENERATE_QC_REPORT') }.size() == 1 },
                // `enable_trace` (a boolean param; set it in a profile or -params-file)
                // defaults true, so the size rollup is the other half of FINAL_QC and
                // must also run exactly once.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:FINAL_QC:AGGREGATE_SIZE_LOGS') }.size() == 1 },
                { assert path("$outputDir/qc").list().any {
                    it.toString().contains('mirage_qc_report_') } },
                { assert path("$outputDir/size_logs/input_sizes.csv").exists() },
                // The aggregated stub CSV is now a real artifact, not a bare header.
                // Before this phase: AGGREGATE_SIZE_LOGS' stub block wrote the header
                // and discarded its inputs, and every row it discarded said `STUB` as
                // its process name anyway -- so a stub run proved nothing at all about
                // the size-log path. Both halves are fixed, so assert both.
                { def sizes = new File("$outputDir/size_logs/input_sizes.csv").readLines()
                  assert sizes[0] == 'process,sample_id,filename,bytes'
                  assert sizes.size() > 1
                  assert sizes.drop(1).every { !it.startsWith('STUB,') }
                  assert sizes.any { it.contains('CONVERT_IMAGE,') } }
            )
        }
    }

    /*
     * FINAL_QC is now invoked unconditionally; the two gates live inside it. A run
     * that wants neither half must still complete cleanly rather than hang on an
     * unconsumed artifact channel.
     */
    test("Should complete with no report and no size rollup when both are off - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                skip_final_qc_report = true
                enable_trace = false

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('GENERATE_QC_REPORT') }.size() == 0 },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('AGGREGATE_SIZE_LOGS') }.size() == 0 },
                // The rest of the pipeline is unaffected.
                { assert path("$outputDir/csv/postprocessed.csv").exists() }
            )
        }
    }

    /*
     * The samplesheet is read exactly once, by INPUT_CHECK, with the column fixed
     * by --start. Starting mid-pipeline must read the checkpoint's own column
     * (registered_image here) — reading path_to_file instead would fail at launch
     * rather than silently, but only if the mapping stays in step with --start.
     */
    test("Should read the entry step's image column, once - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_segmented.csv"
                outdir = "$outputDir"
                start = "postprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // One patient, TWO registered images -> two per-image SPLIT_CHANNELS and
                // one per-patient merge. A second read of the sheet (or a lost
                // images_count) would change these. This asserted one
                // MIRAGE:POSTPROCESSING:SEGMENT until the segmentation step was split
                // out: SEGMENT is neither under POSTPROCESSING nor run at all at
                // --start postprocessing, where the masks come from the checkpoint --
                // so the old assertion could only ever have matched zero tasks. It was
                // masked because this test pointed at the pre-segmentation-step
                // 4-column fixture and died in validateInputCSV before reaching here.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:SPLIT_CHANNELS') }.size() == 2 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:MERGE_QUANT_CSVS') }.size() == 1 },
                // --start postprocessing REUSES the checkpoint's masks; re-segmenting
                // here would silently discard them.
                { assert workflow.trace.tasks().findAll {
                    it.name.contains(':SEGMENT') }.size() == 0 },
                { assert path("$outputDir/csv/postprocessed.csv").exists() }
            )
        }
    }

    test("Should name the trace path it looked for when no report can be made") {

        // F3: the resource report's real defect was silent trace discovery. main.nf
        // built "${params.trace_dir}/trace.txt" from the raw param and cmd.execute()
        // resolved it against the JVM's working directory, so a relative trace_dir
        // pointed somewhere else entirely on any launch that was not from the run
        // directory -- and the script exited 0 over an empty page, so main.nf printed
        // a SUCCESS line.
        //
        // trace_dir is RELATIVE here on purpose: the leading slash in the asserted
        // path is the whole proof that ResourceReport.tracePath resolved it against
        // launchDir rather than passing the raw param through.
        tag "stub"
        options "-stub"

        when {
            params {
                input       = "$projectDir/tests/testdata/single_sample.csv"
                outdir      = "$outputDir"
                start       = "preprocessing"
                stop        = "preprocessing"
                seg_gpu     = false
                enable_trace = false
                trace_dir   = 'plan10_relative_trace_dir'
            }
        }

        then {
            // The message is a log.warn from workflow.onComplete. nf-test launches
            // Nextflow with -quiet unless it is itself run with --verbose (CI is),
            // and under -quiet Nextflow 25 AND 26 drop log.warn from the console
            // streams entirely -- workflow.stdout/stderr come back empty while the
            // line sits in the run log. Measured 2026-09-03: 4/4 local failures
            // without --verbose, 0 with; what the master plan recorded as a 'stdout
            // capture race' was this. So read the run log too: nf-test writes it to
            // <launchDir>/meta/nextflow.log, and the assertion holds in both modes.
            def runLog = new File("${launchDir}/meta/nextflow.log")
            def said = workflow.stdout + workflow.stderr +
                       (runLog.exists() ? runLog.readLines() : [])
            assertAll(
                { assert workflow.success },
                { assert said.any { it.contains('/plan10_relative_trace_dir/trace.txt') },
                    "the diagnostic did not name an ABSOLUTE trace path: " + said.join(' | ') },
                { assert said.any { it.contains('enable_trace') },
                    "the diagnostic did not say whether tracing was on: " + said.join(' | ') },
                // Nothing is written: an empty report page that says "not available"
                // is worse than no page, because it looks like a report.
                { assert !new File("$outputDir/qc/mirage_resource_report.html").exists() }
            )
        }
    }

    test("Should write the resource report when the trace is where it says it is") {

        // The other half of the same fix: when a trace file genuinely exists at the
        // resolved path, the report IS produced. This is the regression guard for the
        // discovery change -- there is no in-DAG process to hang a rendered-command
        // nf-test on, because the report is generated from workflow.onComplete
        // deliberately, so the artifact's existence is the assertion available.
        //
        // trace_dir is deliberately an ABSOLUTE path under $outputDir here, pre-seeded
        // with a minimal trace.txt before the pipeline launches -- it is NOT enough to
        // rely on the shipped `enable_trace` default (a boolean param; set it in a
        // profile or -params-file) and let Nextflow's own trace{}
        // scope write the file during the run. nf-test unconditionally appends its OWN
        // `-with-trace <meta/trace.csv>` to every `nextflow run` invocation it makes
        // (confirmed via .nf-test/tests/*/meta/nextflow.log: only ONE
        // "TraceFileObserver ... saving trace file" line ever appears, and only
        // meta/trace.csv gets written -- .trace/trace.txt is never created). CLI
        // options win over `nextflow.config`, so nf-test's flag silently overrides
        // this pipeline's `trace.file` setting for the run; a competing `-with-trace`
        // added from a test's own `options` does not help either -- Nextflow's CLI
        // parser rejects a second occurrence outright ("Can only specify option
        // -with-trace once"), watched failing while investigating this. Pre-seeding
        // the exact file ResourceReport.tracePath will resolve to is therefore the
        // only way to exercise the "found -> report produced" branch under nf-test;
        // it is not a workaround for anything main.nf gets wrong, and CI's own
        // `nf-test test` invocation (.github/workflows/_test-suite.yml) carries the
        // same unconditional `-with-trace`, so this is the real CI shape, not a local
        // artifact.
        tag "stub"
        options "-stub"

        when {
            new File("$outputDir/faketrace").mkdirs()
            new File("$outputDir/faketrace/trace.txt").text =
                "task_id\tprocess\ttag\tname\tstatus\texit\tsubmit\tstart\tcomplete\t" +
                "duration\trealtime\t%cpu\tcpus\tmemory\tpeak_rss\tpeak_vmem\trchar\twchar\n" +
                "1\tMIRAGE:PREPROCESSING:CONVERT_IMAGE\tP001\t" +
                "MIRAGE:PREPROCESSING:CONVERT_IMAGE (P001)\tCOMPLETED\t0\t" +
                "2026-09-02 00:00:00.000\t2026-09-02 00:00:00.100\t2026-09-02 00:00:00.200\t" +
                "200ms\t100ms\t50.0%\t1\t2 GB\t500 MB\t1 GB\t10 MB\t5 MB\n"
            params {
                input     = "$projectDir/tests/testdata/single_sample.csv"
                outdir    = "$outputDir"
                start     = "preprocessing"
                stop      = "preprocessing"
                seg_gpu   = false
                trace_dir = "$outputDir/faketrace"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/qc/mirage_resource_report.html").exists() },
                { assert path("$outputDir/qc/mirage_resource_report.html").text
                         .contains("MIRAGE Computational Resource Report") }
            )
        }
    }

    test("Should refuse --start registration when a checkpoint path no longer exists") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/invalid_checkpoint_dangling_path.csv"
                outdir = "$outputDir"
                start = "registration"
            }
        }

        then {
            assert workflow.failed
            def report = (workflow.stdout + workflow.stderr).join('\n') + (workflow.errorReport ?: '') + (workflow.errorMessage ?: '')
            assert report.contains('P001_deleted_after_the_run.ome.tiff') : "the refusal must name the missing file: " + report
        }
    }

    test("Should reject a samplesheet whose is_reference is yes/no rather than true/false") {
        tag "stub"
        options "-stub"
        when {
            params {
                input = "$projectDir/tests/testdata/invalid_is_reference_yes.csv"
                outdir = "$outputDir"
                start = "preprocessing"
            }
        }
        then {
            assert workflow.failed
            def report = (workflow.stdout + workflow.stderr).join('\n') + (workflow.errorReport ?: '') + (workflow.errorMessage ?: '')
            assert report.contains("Must be 'true' or 'false'") : report
            assert report.contains("'yes'") : "the offending value is named: " + report
        }
    }

    test("Should publish the segmented checkpoint and geojson when starting at segmentation - stub") {

        tag "stub"
