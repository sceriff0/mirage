/*
========================================================================================
    Site-specific configuration template
========================================================================================
    Per-site sizing lives here. `max_cpus` and `max_memory` have no default and
    are required, so a run that does not set them is refused at launch:

        ERROR ~ Validation of pipeline parameters failed!
        * Missing required parameter(s): max_cpus, max_memory

    Make yours once:

        cp conf/site.config.template site.config
        # edit the values below to match your machine or cluster
        nextflow run . -profile slurm,singularity -c site.config \
            --input samplesheet.csv --outdir results

    `site.config` at the repository root is gitignored.

    A named profile works too if you control nextflow.config:

        profiles { mysite { includeConfig 'conf/mysite.config' } }

    but a `-c` file wins over a profile on params regardless of argument order.

    Do not set cleanup_work, enable_trace, trace_dir, concurrency, max_forks or
    queue_size here: they are fixed before a `-c` file is read, and the pipeline
    refuses such a run (ParamUtils.validateFrozenConfig). Pass them with
    -params-file or on the command line (the two booleans only via -params-file).
========================================================================================
*/

params {
    // ---- Required: this machine's ceiling ----------------------------------
    // Ceilings, not requests: every task request is clamped to these. Set them to
    // what the node or partition actually has. max_time is optional (default 240.h);
    // set it to the partition's MaxTime so no job asks for more than the queue allows.
    max_cpus               = 16
    max_memory             = '64.GB'
    max_time               = '48.h'

    // ---- Output ------------------------------------------------------------
    outdir                 = '/path/to/results'

    // ---- Segmentation model location ---------------------------------------
    // Used when seg_method = 'stardist' (the default). The shipped model is downloaded
    // on first use into segmentation_model_dir. Without network access, pre-download
    // config.json, thresholds.json and weights_best.h5 into
    // <segmentation_model_dir>/DSUnit__stardist__68b94406104b/.
    // Set segmentation_model to a folder name under that directory to use your own.
    segmentation_model_dir = '/path/to/models/'
    // segmentation_model  = 'your_stardist_model_name'

    // ---- SLURM settings (leave null when not using SLURM) -------------------
    slurm_partition        = null
    slurm_account          = null
    slurm_qos              = null

    // ---- GPU type for SLURM (used by segmentation) --------------------------
    // Match `sinfo -o "%G"`; the request is emitted as --gres=gpu:<value>.
    gpu_type               = 'nvidia_a100:1'
}

// Singularity bind paths (adjust to your site)
singularity {
    runOptions = '--writable-tmpfs --bind /path/to/models'
}

// Seqera Platform / Tower (optional monitoring)
tower {
    enabled = false
}
