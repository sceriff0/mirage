nextflow_process {

    name "Test REGISTER process"
    script "modules/local/register.nf"
    process "REGISTER"

    tag "modules"
    tag "modules_local"
    tag "register"

    test("Should run VALIS batch registration - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001'],
                    'P001',
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    [
                        file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                        file('$projectDir/tests/testdata/P001_mov2.ome.tiff', checkIfExists: true)
                    ],
                    [
                        [patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']]
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.registered },
                { assert process.out.versions },
                { with(process.out.registered) {
                    assert size() == 1
                    assert get(0).get(0) == 'P001'
                }},
                { with(process.out.versions) {
                    assert size() == 1
                    assert get(0).toString().endsWith('versions.yml')
                }}
            )
        }
    }

    test("Should handle single moving image - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001'],
                    'P001',
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    [
                        file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                    ],
                    [
                        [patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']]
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.registered },
                { assert process.out.versions }
            )
        }
    }

    test("Should preserve patient ID through registration - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P002'],
                    'P002',
                    file('$projectDir/tests/testdata/P002_ref.ome.tiff', checkIfExists: true),
                    [
                        file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                    ],
                    [
                        [patient_id: 'P002', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P002', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']]
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { with(process.out.registered) {
                    assert get(0).get(0) == 'P002'
                }}
            )
        }
    }

    test("Should emit versions.yml with process info - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001'],
                    'P001',
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    [
                        file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                    ],
                    [
                        [patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']]
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.versions },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("Should stage its file list at a task-relative path, not /tmp - rendered command") {

        // Tagged `stub` so CI's blocking `nf-test test --tag stub` gate runs it, but
        // deliberately WITHOUT `options "-stub"` — `-stub` never evaluates a `script:`
        // block, so a stub run cannot see the `/tmp/files_to_copy.txt` fix at all (same
        // blind spot documented in generate_qc_report.nf.test). This pins the fix: REGISTER
        // is per-patient with maxForks > 1, and under Singularity /tmp is host-bind-mounted,
        // so two concurrent tasks sharing a constant /tmp path would each stage the other's
        // slide list. The list must live at a plain relative path inside the task's own
        // work directory instead.
        //
        // The blocking gate runs `--profile test` (no docker), so this executes register.py
        // for real on the bare host rather than in the VALIS container; register.py is not
        // expected to succeed there. That is fine — like the GENERATE_QC_REPORT precedent,
        // the assertions read the rendered .command.sh rather than process outcome, so the
        // case holds whether or not the script completes.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001'],
                    'P001',
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    [
                        file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                    ],
                    [
                        [patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']]
                    ]
                ]
                """
            }
        }

        then {
            // Nextflow lays tasks out as <workDir>/<2 hex>/<30 hex>/.command.sh.
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('files_to_copy.txt')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered REGISTER .command.sh found under the task work dir" },
                // The assertion with teeth: against the pre-fix module this reads
                // `/tmp/files_to_copy.txt` in all three spots (find redirect, and two cats)
                // and this fails.
                { assert rendered.every { !it.contains('/tmp/files_to_copy.txt') },
                    "rendered command still writes/reads the shared /tmp path: " + rendered.join(' --- ') },
                // The replacement path must be plain and relative (no leading '/'), which
                // keeps it inside the task's own work directory rather than any shared or
                // absolute location.
                { assert rendered.every { it.contains('> files_to_copy.txt') },
                    "rendered command: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('cat files_to_copy.txt') },
                    "rendered command: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should run valis-wsi at its defaults: no tier, micro, keypoint or size flags - rendered command") {

        // `stub` tag but NO `options "-stub"`: -stub never evaluates a script: block.
        //
        // REGISTER runs valis-wsi 1.2.0 at its defaults (2026-11-05): the rendered call carries
        // the inputs, the JVM heap and the stage checkpoint, and NOTHING that sets VALIS. Each
        // flag below is one the tuned configuration used to render (archive/valis-mirage-tuned);
        // register.py no longer accepts any of them, so a reappearance would also fail the task.
        // The one non-default VALIS argument, the registration channel (index 0), lives inside
        // register.py and is pinned by tests/test_register_valis_defaults.py.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001'],
                    'P001',
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    [
                        file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                    ],
                    [
                        [patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']]
                    ]
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('register.py')) {
                    rendered << f.text
                }
            }
            def calls = rendered.collect { it.substring(it.indexOf('register.py \\')) }
            def removed = ['--memory-mode', '--micro-reg', '--micro-reg-fraction', '--max-image-dim',
                           '--max-processed-dim', '--max-non-rigid-dim', '--max-keypoints',
                           '--cpus', '--interp-method']

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered REGISTER .command.sh found under the task work dir" },
                { assert calls.every { c -> removed.every { !c.contains(it + ' ') } },
                    "a VALIS setting is rendered again: " + calls.join(' --- ') },
                // REGISTER passes the STAGED path (stageAs 'ref/*' -> ref/<name>); register.py
                // takes its basename and finds the copy under --input-dir.
                { assert calls.every { it =~ /--reference (\S+\/)?P001_ref\.ome\.tiff / },
                    "the reference did not reach register.py: " + calls.join(' --- ') },
                // Fixed heap: 10 GB (VALIS's own), clamped by task.memory - 4 on a small runner.
                { assert calls.every { c ->
                        def m = (c =~ /--jvm-heap-gb (\d+)/)
                        m.find() && (m.group(1) as int) >= 1 && (m.group(1) as int) <= 10 },
                    "the JVM heap is not the fixed <= 10 GB: " + calls.join(' --- ') },
                // Truncation guard: a backslash-newline followed by an empty line would end the
                // shell command early and run the rest as separate commands.
                { assert calls.every { !it.contains('\\\n\n') },
                    "register.py invocation is truncated by a blank line: " + calls.join(' --- ') }
            )
        }
    }

    test("Should render the envelope's size-log row and container line - rendered command") {

        // `stub` tag but NO `options "-stub"`: -stub never evaluates a script: block,
        // so a stub run cannot see either line this case exists to pin. Same shape and
        // same reason as the two rendered-command cases above.
        //
        // The blocking gate runs `--profile test` (no docker), so register.py executes
        // on the bare host and is not expected to succeed. That is fine -- the
        // assertions read .command.sh, not the outcome. task.container is non-null even
        // with no container engine enabled (measured 2026-09-02 on 25.04.7), which is
        // why the container line is assertable here at all.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001'],
                    'P001',
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    [
                        file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                    ],
                    [
                        [patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'CD3']]
                    ]
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('P001.REGISTER.size.csv')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered REGISTER .command.sh found under the task work dir" },
                // The envelope's one-stat form, over REGISTER's two staged globs. Split
                // into two shorter needles rather than one long literal: the whole line
                // is quoting-dense (an awk program inside a command substitution) and a
                // single mistyped character in the test reads as a product failure.
                { assert rendered.every { it.contains('stat -L --printf="%s\\n" ref/* input_*/*') },
                    "rendered command: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('awk \'{s+=$1} END {print s+0}\'') },
                    "rendered command: " + rendered.join(' --- ') },
                // The row itself, with `inputs/` for a multi-path measurement. The process
                // name is asserted by SUFFIX, because nf-test wraps a directly-tested
                // process in its own generated workflow and the fully-qualified name it
                // renders is not the one a pipeline run produces.
                { assert rendered.every { it.contains('REGISTER,P001,inputs/,${size_bytes}" > P001.REGISTER.size.csv') },
                    "rendered command: " + rendered.join(' --- ') },
                // ...and it is a real name, not the literal STUB the stub blocks used to write.
                { assert rendered.every { !it.contains('"STUB,') },
                    "rendered command: " + rendered.join(' --- ') },
                // Against the pre-refactor module the size-log preamble reads
                // `total_bytes=$(find -L ref input_* -maxdepth 1 -type f (...) -exec stat -L
                // --printf="%s\n" {} + ...)` and every assertion above fails. Against a module
                // that lost the envelope call entirely, `rendered` is empty and the first
                // assertion fails. The needle is scoped to `-exec stat -L --printf`, the part
                // unique to that removed find -- REGISTER's script: ALSO runs an unrelated,
                // still-legitimate `find -L ref input_* -maxdepth 1 ...` to stage input files
                // for copying (modules/local/register.nf, the "STAGE INPUT FILES" section), so
                // a bare `find -L ref input_*` needle would false-positive against that line on
                // every render, migrated or not.
                { assert rendered.every { !it.contains('-exec stat -L --printf') },
                    "rendered command still uses the hand-written find: " + rendered.join(' --- ') },
                // Ruling R6: the image is recorded by the run itself, not only by the trace.
                // Digest-pinned, no tag (Apptainer/Singularity: NAME[:TAG|@DIGEST], never both) --
                // see tests/test_base_images_are_digest_pinned.py.
                { assert rendered.every { it.contains('    container: bolt3x/mirage-valis:1.0.0') },
                    "rendered command: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('valis: $(python -c "import valis;') },
                    "rendered command: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should run VALIS batch registration - real") {

        tag "real"
        tag "slow"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001'],
                    'P001',
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    [
                        file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                        file('$projectDir/tests/testdata/P001_mov2.ome.tiff', checkIfExists: true)
                    ],
                    [
                        [patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']],
                        [patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']]
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.registered },
                { assert process.out.versions },
                { with(process.out.registered) {
                    assert size() == 1
                    assert get(0).get(0) == 'P001'
                }}
            )
        }
    }
}
