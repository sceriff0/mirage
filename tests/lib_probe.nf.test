/*
 * Nextflow looks for lib/ next to the script, not the repo root, so this probe
 * needs an explicit -lib. It must be absolute: a relative path resolves against
 * nf-test's scratch workdir and fails with "Cannot find specified library".
 */
nextflow_pipeline {

    name "lib/ probe — direct assertions against lib/*.groovy"
    script "tests/lib_probe.nf"
    tag "stub"

    test("every lib/ assertion holds") {
        // No -stub: the script declares no processes; its assertions always run.
        options "-lib $projectDir/lib"
        when {
            params {
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.success
            assert workflow.stdout.any { it.contains("LIB PROBE: all assertions passed") }
        }
    }
}
