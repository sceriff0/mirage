nextflow_process {

    name "Test TILE_FOR_BASIC process"
    script "modules/local/tile_for_basic.nf"
    process "TILE_FOR_BASIC"

    tag "modules"
    tag "modules_local"
    tag "tile_for_basic"

    test("Should emit a tile stack, a sidecar and the passthrough slide - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.tiles },
                { assert process.out.sidecar },
                { assert process.out.versions },
                // The `sidecar` emit carries three elements (meta, the input slide, the positions
                // JSON): joining slide and sidecar back on meta would mis-pair two slides of one
                // patient whose meta maps are identical.
                { assert process.out.sidecar.get(0).size() == 3 },
                { assert process.out.tiles.get(0).get(1).endsWith('_tiles.ome.tif') },
                { assert process.out.sidecar.get(0).get(2).endsWith('_tiles.json') }
            )
        }
    }

    test("Should render the nuclear-marker flags and the FOV size - rendered command") {

        // `stub` tag but no `options "-stub"`: the subject is what tile_for_basic.py is
        // invoked with. The nuclear/fiducial skip is decided here and recorded in the sidecar
        // for APPLY_PROFILES; if the marker list stops reaching this call, a CELLTOX panel has
        // its fiducial corrected. The task may fail without a container; the assertions read
        // .command.sh only.
        tag "stub"

        when {
            params {
                preproc_tile_size = 64
                nuclear_markers = ['DAPI', 'CELLTOX']
                // false here, unlike the shipped default (true), to cover the off branch of
                // `params.preproc_skip_nuclear ? '--skip_nuclear' : ''`; the case below covers on.
                preproc_skip_nuclear = false
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('tile_for_basic.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered TILE_FOR_BASIC .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--nuclear-markers DAPI CELLTOX') },
                    "rendered command missing --nuclear-markers: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--skip_nuclear') },
                    "rendered command still contains --skip_nuclear despite preproc_skip_nuclear=false: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--fov_size 64') },
                    "rendered command missing --fov_size: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--sidecar') },
                    "rendered command writes no positions sidecar: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should render --skip_nuclear when preproc_skip_nuclear is set - rendered command") {

        // Copy of the case above with `preproc_skip_nuclear = true` (the shipped default),
        // pinning the on branch of the ternary.
        tag "stub"

        when {
            params {
                preproc_tile_size = 64
                nuclear_markers = ['DAPI', 'CELLTOX']
                preproc_skip_nuclear = true
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('tile_for_basic.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered TILE_FOR_BASIC .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--skip_nuclear') },
                    "rendered command missing --skip_nuclear despite preproc_skip_nuclear=true: " + rendered.join(' --- ') }
            )
        }
    }
}
