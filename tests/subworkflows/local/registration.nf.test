nextflow_workflow {

    name "Test REGISTRATION subworkflow"
    script "subworkflows/local/registration.nf"
    workflow "REGISTRATION"

    tag "subworkflow"
    tag "registration"

    test("Should run VALIS registration - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                skip_registration_qc = true
                padding = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI', 'PANCK']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', id: 'P001_mov1', is_reference: false, channels: ['DAPI', 'CD3']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                // REGISTRATION now takes only ch_preprocessed (VALIS-only)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.checkpoint_csv },
                // REGISTER's stub writes no preprocessed/data/*.csv, so under -stub the
                // optional intrinsic_tre channel is empty; a real run usually has one.
                { assert workflow.out.registration_tre.size() == 0,
                    "VALIS's REGISTER stub: block never touches preprocessed/data/*.csv, so " +
                    "the optional `summary` emit (intrinsic_tre) is empty under -stub, unlike " +
                    "a real run: " + workflow.out.registration_tre },
                { assert snapshot(workflow.out.checkpoint_csv).match() }
            )
        }
    }


    test("Should run tiled/STARE registration - stub") {

        // Same inputs as the VALIS case, with registration_method 'tiled'.
        // TILED_SOLVE always writes *_tre.json (stub included), so intrinsic_tre is
        // populated once per moving slide, not a Channel.empty() slot.
        tag "stub"
        options "-stub"

        when {
            params {
                skip_registration_qc = true
                padding = false
                registration_method = 'tiled'
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI', 'PANCK']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', id: 'P001_mov1', is_reference: false, channels: ['DAPI', 'CD3']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                // REGISTRATION now takes only ch_preprocessed (VALIS-only)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.checkpoint_csv },
                { assert workflow.out.registration_tre.size() >= 1,
                    "the tiled adapter also produces its own STARE *_tre.json -- " +
                    "intrinsic_tre is not a null-object slot for this backend, contrary to " +
                    "the brief's fallback premise. Real: " + workflow.out.registration_tre }
            )
        }
    }

    test("Should handle multi-patient registration - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                skip_registration_qc = true
                padding = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', id: 'P001_mov1', is_reference: false, channels: ['DAPI', 'CD3']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')],
                    [[patient_id: 'P002', id: 'P002_ref', is_reference: true, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P002_ref.ome.tiff')]
                ])
                // REGISTRATION now takes only ch_preprocessed (VALIS-only)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { with(workflow.out.checkpoint_csv) {
                    assert size() == 1
                }}
            )
        }
    }

    // registration_method's allowed values are enforced at launch by the schema;
    // see tests/param_validation.nf.test.

    test("Should handle padding workflow - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                padding = true
                skip_registration_qc = true
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', id: 'P001_mov1', is_reference: false, channels: ['DAPI', 'CD3']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                // REGISTRATION now takes only ch_preprocessed (VALIS-only)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.checkpoint_csv }
            )
        }
    }

    test("Should skip QC when configured - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                skip_registration_qc = true
                padding = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', id: 'P001_mov1', is_reference: false, channels: ['DAPI', 'CD3']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                // REGISTRATION now takes only ch_preprocessed (VALIS-only)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.checkpoint_csv }
            )
        }
    }

    /*
     * The reference is resolved once in INPUT_CHECK (CsvUtils.resolveReferenceRows)
     * and arrives in meta.is_reference; registration.nf only guards that invariant.
     * These cases pin the guard: a reference-less patient is refused. The full-run
     * refusal is main.nf.test's "Should reject a samplesheet that marks no reference".
     */
    test("Should reject a multi-slide patient that names no reference - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                skip_registration_qc = true
                padding = false
            }
            workflow {
                """
                // No is_reference=true anywhere. INPUT_CHECK would have resolved one
                // before this point on a real run; reaching REGISTRATION without one
                // means the samplesheet or checkpoint never named a reference.
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: false, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', id: 'P001_mov1', is_reference: false, channels: ['DAPI', 'CD3']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                """
            }
        }

        then {
            assert !workflow.success
            assert workflow.stdout.any { it.contains('No reference image found for patient P001') }
        }
    }

    /*
     * Single slide: REGISTER_PATIENT passes it straight through to ch_registered, but
     * the guard runs before that branch, so a reference-less lone slide must still be
     * refused rather than passed through as if registered.
     */
    test("Should reject a single-slide patient that names no reference - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                skip_registration_qc = true
                padding = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: false, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')]
                ])
                // REGISTRATION now takes only ch_preprocessed (VALIS-only)
                """
            }
        }

        then {
            assert !workflow.success
            assert workflow.stdout.any { it.contains('No reference image found for patient P001') }
        }
    }

    test("Should not run seg-QC segmentation for a single-slide patient - stub") {

        // Single-slide patients have nothing to register and are branched straight
        // through to ch_registered (see the "single" branch in registration.nf).
        // Their reference must NOT be fed into SEG_QC: there is no moving slide to
        // score it against, so a full GPU StarDist segmentation would be computed
        // and thrown away. Guarded alongside a two-slide patient (below) so a fix
        // that disables seg-QC entirely would also fail this test.

        tag "stub"
        options "-stub"

        when {
            params {
                reg_qc = 2
                padding = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('SEG_QC_GEOJSON')
                }.size() == 0 }
            )
        }
    }

    test("Should still run seg-QC segmentation for both slides of a two-slide patient - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                reg_qc = 2
                padding = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P002', id: 'P002_ref', is_reference: true, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P002_ref.ome.tiff')],
                    [[patient_id: 'P002', id: 'P002_P001_mov1', is_reference: false, channels: ['DAPI', 'CD3']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('SEG_QC_GEOJSON')
                }.size() == 2 }
            )
        }
    }

    test("Should seg-QC score a multi-slide patient whose reference is not the first slide by id - stub") {

        // A multi-slide patient must be seg-QC scored whichever slide is its
        // reference: seg_qc.nf splits reference/moving on meta.is_reference, and an
        // empty reference branch makes the per-patient join match nothing. The input
        // carries is_reference on one slide, the shape INPUT_CHECK hands REGISTRATION.

        tag "stub"
        options "-stub"

        when {
            params {
                reg_qc = 2
                padding = false
            }
            workflow {
                """
                // Two slides, one of them marked -- the shape INPUT_CHECK produces.
                input[0] = Channel.fromList([
                    [[patient_id: 'P003', id: 'P003_P002_ref', is_reference: true, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P002_ref.ome.tiff')],
                    [[patient_id: 'P003', id: 'P003_P001_mov1', is_reference: false, channels: ['DAPI', 'CD3']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Both slides were segmented (the waste-avoidance guard above does not
                // apply here — this patient has two slides, not one).
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('SEG_QC_GEOJSON')
                }.size() == 2 },
                // The reference/moving split in seg_qc.nf resolved: one moving
                // slide was scored against the reference.
                { assert workflow.out.seg_qc.size() == 1 }
            )
        }
    }

    /*
     * Pins the native-image join: ch_for_qc pairs each moving slide's native image
     * with its registered file via `.join(..., by: 0)` on meta.id. A join drops an
     * unmatched pair silently, and a wrong key cross-pairs slides.
     *
     * The reference id sorts first (cycle1): with a non-unique key such as
     * meta.patient_id, join() pairs FIFO, the reference's native image is queued first
     * and every pair shifts by one, so the mutation fails deterministically. With the
     * reference sorting last, FIFO order happens to be correct and the test is blind.
     *
     * The registered file is identified through qc/<simpleName>_QC_RGB.png, not by
     * globbing the task dir: two staged inputs end '_registered.ome.tiff' (the moving
     * slide and the reference), and directory order differs between APFS and ext4.
     */
    test("Should pair each slide's own native image with its registered file, not the other slide's - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                padding = false
                // reg_qc defaults to 2 (level >= 1), so GENERATE_REGISTRATION_QC runs
                // without needing to set anything here.
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P004', id: 'P004_cycle1', is_reference: true, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)],
                    [[patient_id: 'P004', id: 'P004_cycle2', is_reference: false, channels: ['DAPI', 'CD3']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)],
                    [[patient_id: 'P004', id: 'P004_cycle3', is_reference: false, channels: ['DAPI', 'CD8']],
                     file('$projectDir/tests/testdata/P001_mov2.ome.tiff', checkIfExists: true)]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.qc.size() == 2 },
                {
                    // Every GENERATE_REGISTRATION_QC task directory has a `native/`
                    // subdirectory (unique to this process's stageAs).
                    def taskDirs = []
                    new File("$workDir").eachFileRecurse { f ->
                        if (f.isDirectory() && f.name == 'native') {
                            taskDirs << f.parentFile
                        }
                    }
                    assert taskDirs.size() == 2 :
                        "expected 2 GENERATE_REGISTRATION_QC task dirs (one per moving slide), found ${taskDirs.size()}"

                    def pairs = taskDirs.collect { dir ->
                        def nativeFiles = new File(dir, 'native').listFiles()
                        assert nativeFiles.size() == 1 :
                            "expected exactly one staged native file, found ${nativeFiles*.name}"
                        // The qc/ output is the only unambiguous name of the
                        // `registered` input in this directory (see header).
                        def qcFiles = new File(dir, 'qc').listFiles()
                            .findAll { it.name.endsWith('_QC_RGB.png') }
                        assert qcFiles.size() == 1 :
                            "expected exactly one qc/*_QC_RGB.png, found ${qcFiles*.name}"
                        [native: nativeFiles[0].name, registered: qcFiles[0].name]
                    }

                    def cd3Task = pairs.find { it.registered.contains('CD3') }
                    def cd8Task = pairs.find { it.registered.contains('CD8') }
                    assert cd3Task != null : "no task rendered QC for the CD3 slide: ${pairs}"
                    assert cd8Task != null : "no task rendered QC for the CD8 slide: ${pairs}"
                    // The teeth: a wrong or dropped join would either cross these two
                    // (CD3's task staging cycle3's native file, or -- under a patient_id
                    // key -- the REFERENCE's) or leave one without a native/ file at all.
                    assert cd3Task.native == 'P001_mov1.ome.tiff' :
                        "P004_cycle2 (CD3) task staged native file '${cd3Task.native}', expected P001_mov1.ome.tiff"
                    assert cd8Task.native == 'P001_mov2.ome.tiff' :
                        "P004_cycle3 (CD8) task staged native file '${cd8Task.native}', expected P001_mov2.ome.tiff"
                }
            )
        }
    }

    test("Should register images using VALIS - real") {

        tag "real"
        tag "slow"

        when {
            params {
                outdir = "$outputDir"
                skip_registration_qc = true
                padding = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)],
                    [[patient_id: 'P001', id: 'P001_mov1', is_reference: false, channels: ['DAPI', 'CD3', 'CD8']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)]
                ])
                // REGISTRATION now takes only ch_preprocessed (VALIS-only)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Registered outputs exist
                { with(workflow.out.registered) {
                    assert size() == 2
                    // At least one output file exists with real data
                    assert get(0).get(1) != null
                    assert get(1).get(1) != null
                }},
                // patient_id preserved in all outputs
                // Explicit receiver on collect: inside `with { }`, an unqualified
                // `collect` gets the whole list as `it`, not the delegate's elements.
                {
                    def patient_ids = workflow.out.registered.collect { it[0].patient_id }
                    assert patient_ids.size() == 2
                    assert patient_ids.every { it == 'P001' }
                },
                // Checkpoint CSV created
                { with(workflow.out.checkpoint_csv) {
                    assert size() == 1
                    assert file(get(0)).exists()
                }}
            )
        }
    }
}
