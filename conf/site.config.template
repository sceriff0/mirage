/*
========================================================================================
    Site-specific configuration template
========================================================================================
    THE ONE PLACE PER-SITE SIZING LIVES. `max_cpus` and `max_memory` have NO
    default in nextflow.config (they are declared null on purpose -- a default
    there is a lie about somebody else's machine) and nextflow_schema.json marks
    both required, so a run that does not set them is refused at launch:

        ERROR ~ Validation of pipeline parameters failed!
        * Missing required parameter(s): max_cpus, max_memory

    Every command in the MIRAGE documentation therefore ends in `-c site.config`.
    Make yours once:

        cp conf/site.config.template site.config
        # edit the values below to match your machine or cluster
        nextflow run . -profile slurm,singularity -c site.config \
            --input samplesheet.csv --outdir results

    `site.config` at the repository root is gitignored, so your paths and
    account names never reach a commit.

    Prefer a NAMED PROFILE only if you also control nextflow.config:

        profiles { mysite { includeConfig 'conf/mysite.config' } }

    Note the ordering trap if you do: a profile body is evaluated while
    nextflow.config is parsed, whereas a `-c` file is layered afterwards and
    wins on params regardless of argument order.

    THE REVERSE TRAP -- SIX PARAMS MUST NOT BE SET IN THIS FILE. cleanup_work,
    enable_trace, trace_dir, concurrency, max_forks and queue_size each drive a
    SCALAR inside nextflow.config (`cleanup`, `trace.enabled`, `executor.queueSize`,
    `process.maxForks`, ...) that is evaluated while nextflow.config is parsed --
    which is BEFORE this file is layered. A pin here changes the param and reaches
    nothing that reads it (measured 2026-09-09). The pipeline REFUSES such a run at
    launch (ParamUtils.validateFrozenConfig) rather than ignore the pin. Pass those
    six with -params-file (the two booleans can only go that way) or on the command
    line.
========================================================================================
*/

params {
    // ---- Required: this machine's ceiling ----------------------------------
    // Every per-process request is clamped to these by process.resourceLimits.
    // They are CEILINGS, not requests: set them to what the node or partition
    // actually has, not to what a task should ask for.
    max_cpus               = 16
    max_memory             = '64.GB'
    max_time               = '48.h'

    // ---- Output ------------------------------------------------------------
    outdir                 = '/path/to/results'

    // ---- Segmentation model location ---------------------------------------
    // Only consulted when seg_method = 'stardist'. The shipped default backend
    // is 'instantseg', which needs neither of these.
    segmentation_model_dir = '/path/to/models/'
    segmentation_model     = 'your_stardist_model_name'

    // ---- SLURM settings (leave null when not using SLURM) -------------------
    slurm_partition        = null
    slurm_account          = null
    slurm_qos              = null

    // ---- GPU type for SLURM (used by segmentation) --------------------------
    // Match `sinfo -o "%G"`; the request is emitted as --gres=gpu:<value>.
    gpu_type               = 'nvidia_a100:1'
}

// Singularity bind paths (adjust to your site)
singularity {
    runOptions = '--writable-tmpfs --bind /path/to/models'
}

// Seqera Platform / Tower (optional monitoring)
tower {
    enabled = false
}
