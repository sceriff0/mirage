nextflow_process {

    name "Test QUANTIFY process"
    script "modules/local/quantify.nf"
    process "QUANTIFY"

    tag "modules"
    tag "modules_local"
    tag "quantify"

    test("Should quantify single channel - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], id: 'P001_DAPI', channel_name: 'DAPI'],
                    file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.individual_csv
            assert process.out.versions

            with(process.out.individual_csv) {
                assert size() == 1
                assert get(0).get(0).patient_id == 'P001'
                assert get(0).get(1).toString().endsWith('_quant.csv')
            }
        }
    }

    test("Should render the quoted channel name and the compartments/expanded toggles - rendered command") {

        // No options "-stub": stub mode never evaluates script:, so this is the only
        // tag-"stub" case that reaches the rendered command.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], id: 'P001_DAPI', channel_name: 'DAPI'],
                    file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('quantify.py'))
                    rendered << f.text
            }

            assertAll(
                { assert rendered.size() >= 1 },
                // The brief pinned channel_name 'PANCK', but the copied input tuple
                // (this file's own first stub case) carries channel_name: 'DAPI' --
                // substituted per the brief's own fallback instruction.
                { assert rendered.every { it.contains("--channel-name 'DAPI'") },
                    "single-quoted, so a marker with a space or parenthesis survives the shell: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--nuclei_mask_file') }, "quantify_compartments defaults true: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--expanded') }, "expanded_quantification defaults false: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('_quant.csv') }, rendered.join(' --- ') }
            )
        }
    }

    test("Should drop --nuclei_mask_file and add --expanded when the toggles flip - rendered command") {

        tag "stub"

        when {
            params {
                quantify_compartments = false
                expanded_quantification = true
            }
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], id: 'P001_DAPI', channel_name: 'DAPI'],
                    file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('quantify.py'))
                    rendered << f.text
            }

            assertAll(
                { assert rendered.size() >= 1 },
                { assert rendered.every { !it.contains('--nuclei_mask_file') }, rendered.join(' --- ') },
                { assert rendered.every { it.contains('--expanded') }, rendered.join(' --- ') }
            )
        }
    }

    test("Should produce CSV with expected columns - real") {

        tag "real"
        tag "slow"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], id: 'P001_DAPI', channel_name: 'DAPI'],
                    file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.individual_csv },
                // Validate CSV content against the SHIPPED defaults, which is what
                // this case runs on: nextflow.config sets quantify_compartments =
                // true but expanded_quantification = FALSE, and conf/modules.config
                // renders `--expanded` only when the latter is on. Median alone is
                // computed, so the contract is
                //   label + bare marker + Median x {Nucleus, Cytoplasm, Cell} = 5.
                // This assertion said 11 (and its comment claimed expanded defaulted
                // to true) from before that default moved; it got 5 on every real
                // run. See the expanded companion case below for the 11-column shape.
                {
                    def csvFile = process.out.individual_csv.get(0).get(1)
                    def lines = path(csvFile).readLines()
                    assert lines.size() > 1, "CSV should have header + data rows"
                    def header = lines[0].split(',')
                    assert header.size() == 5, "CSV should have exactly 5 columns (label + marker + Median x 3 compartments), got ${header.size()}: ${header}"
                    assert header[0] == 'label', "First column should be 'label'"
                    assert header[1] == 'DAPI', "Second column should be the bare (whole-cell mean) marker column"
                    assert header.contains('DAPI: Cell: Median'), "Should have whole-cell Median column"
                    assert header.contains('DAPI: Nucleus: Median'), "Should have Nucleus Median column"
                    assert header.contains('DAPI: Cytoplasm: Median'), "Should have Cytoplasm Median column"
                    // The Mean/Sum columns are expanded-only and must NOT be here.
                    assert !header.any { it.contains(': Mean') || it.contains(': Sum') },
                        "Mean/Sum are expanded-only, got: ${header}"
                    assert lines.size() - 1 > 0, "CSV should have at least one data row"
                },
                // Metadata preserved
                { assert process.out.individual_csv.get(0).get(0).patient_id == 'P001' }
            )
        }
    }

    test("Should produce the expanded column set when expanded_quantification is on - real") {

        // The other half of the contract the case above pins. Without this one,
        // moving expanded_quantification's default would silently take the
        // Mean/Sum columns out of the pipeline's reachable behaviour and nothing
        // would notice -- conf/modules.config's `--expanded` flag is rendered from
        // a `script:`-time ext.args closure, which no -stub run evaluates.
        tag "real"
        tag "slow"

        when {
            params {
                expanded_quantification = true
            }
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], id: 'P001_DAPI', channel_name: 'DAPI'],
                    file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.individual_csv },
                {
                    def csvFile = process.out.individual_csv.get(0).get(1)
                    def lines = path(csvFile).readLines()
                    def header = lines[0].split(',')
                    // label + bare marker + {Median, Mean, Sum} x {Nucleus, Cytoplasm, Cell}
                    assert header.size() == 11, "expanded CSV should have exactly 11 columns, got ${header.size()}: ${header}"
                    assert header[0] == 'label'
                    assert header[1] == 'DAPI'
                    ['Nucleus', 'Cytoplasm', 'Cell'].each { compartment ->
                        ['Median', 'Mean', 'Sum'].each { statistic ->
                            assert header.contains("DAPI: ${compartment}: ${statistic}"),
                                "missing DAPI: ${compartment}: ${statistic} from ${header}"
                        }
                    }
                }
            )
        }
    }
    test("Should produce non-negative intensity values with correct cell count - regression") {

        tag "real"
        tag "slow"
        tag "regression"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], id: 'P001_DAPI', channel_name: 'DAPI'],
                    file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // Cell count should match mask (20 cells, some may be filtered by min_area)
                {
                    def csvFile = process.out.individual_csv.get(0).get(1)
                    def lines = path(csvFile).readLines()
                    def cellCount = lines.size() - 1
                    assert cellCount > 0, "Must have at least one cell"
                    assert cellCount <= 20, "Should not exceed 20 cells from synthetic mask"
                },
                // All intensity values should be non-negative (DAPI synthetic range: 8000-15000)
                {
                    def csvFile = process.out.individual_csv.get(0).get(1)
                    def lines = path(csvFile).readLines()
                    def header = lines[0].split(',')
                    def valueIdx = 1  // second column is the intensity
                    lines[1..-1].each { line ->
                        def val = line.split(',')[valueIdx] as double
                        assert val >= 0, "Intensity must be >= 0, got ${val}"
                    }
                },
                // Labels should be positive integers matching mask labels
                {
                    def csvFile = process.out.individual_csv.get(0).get(1)
                    def lines = path(csvFile).readLines()
                    lines[1..-1].each { line ->
                        def label = line.split(',')[0] as int
                        assert label > 0, "Label must be > 0 (background excluded)"
                    }
                }
            )
        }
    }
}
