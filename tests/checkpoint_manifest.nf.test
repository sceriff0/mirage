    test("every path in every checkpoint CSV exists — --start segmentation (reused registered.csv)") {
        tag "stub"
        options "-stub"

        when {
            params {
                // Precisely the shape a `csv/registered.csv` from a completed
                // registration run has -- reusing the existing single-slide-reference
                // fixture (its name predates the segmentation step; before it,
                // 'postprocessing' was the step keyed on 'registered_image', the same
                // column 'segmentation' now shares). --start segmentation reads this
                // through INPUT_CHECK, so `registered_image`'s value is ALREADY an
                // absolute published path from outside this run -- exactly the shape
                // review found segmentation.nf's writer mis-recording (it applied
                // Layout.publishedPath unconditionally, double-nesting/rewriting the
                // path against the wrong outdir; fixed via Layout.publishedOrAsIs's
                // isUnderTaskDir check). No --stop, so this run continues into
                // postprocessing too, exercising the chained failure review also
                // found ("--start postprocessing against that file fails").
                input  = "$projectDir/tests/testdata/valid_checkpoint_postprocessing.csv"
                outdir = "$outputDir"
                // Every case in this file asserts on a checkpoint MANIFEST, and no
                // manifest is written at the default --cleanup_level=final: the
                // artifacts its rows name are not published there, so every path
                // would dangle (Checkpoint.writesAtLevel). The 'final' behaviour has
                // its own case at the end of this file.
                cleanup_level = 'none'
                start  = 'segmentation'
            }
        }

        then {
            assert workflow.success

            def csvDir = new File("${outputDir}/csv".toString())
            assert csvDir.isDirectory() : "no csv/ directory was published"

            // Only segmented.csv + postprocessed.csv: entry is 'segmentation', so
            // preprocessed.csv/registered.csv are never written this run.
            def manifests = (csvDir.listFiles() ?: [])
                .findAll { it.name.endsWith('.csv') }
                .sort { it.name }
            assert manifests*.name == ['postprocessed.csv', 'segmented.csv'] :
                "expected postprocessed.csv + segmented.csv, found ${manifests*.name}"

            // segmented.csv's registered_image must be the ORIGINAL fixture path
            // (already published, outside this run entirely) -- not rewritten
            // against this run's outdir. This is the exact property Critical 1
            // broke: publishedPath applied unconditionally reconstructed it as
            // <outputDir>/P001/registered/<name>, which nothing ever publishes.
            def segLines = manifests.find { it.name == 'segmented.csv' }.readLines()
            def segRow = csvFields(segLines[1])
            // index 2, not 1: 'id' (RULING R17, Task 4.3) is now column 1.
            assert segRow[2] == "$projectDir/tests/testdata/P001_ref.ome.tiff".toString() :
                "segmented.csv rewrote registered_image against the wrong outdir: ${segRow[2]}"

            def work = new File("${workDir}".toString()).absolutePath
            def problems = []
            def checked  = 0
            manifests.each { csv ->
                csv.readLines().drop(1).findAll { it.trim() }.each { line ->
                    csvFields(line).each { field ->
                        if (field.startsWith('/')) {
                            checked++
                            if (new File(field).absolutePath.startsWith(work + File.separator))
                                problems << "${csv.name}: inside the work directory (scratch, unpublished) -> ${field}"
                            else if (!new File(field).exists())
                                problems << "${csv.name}: does not exist -> ${field}"
                        }
                    }
                }
            }
            // 5 segmented (registered_image, cell_mask, nuclei_mask, contours,
            // nucleus_contours) + 5 postprocessed (cell_csv, cell_geojson, merged_csv,
            // cell_mask, pyramid), one row each.
            assert checked == 10 :
                "expected 10 recorded paths, examined ${checked} — did the CSV columns change?"
            assert problems.isEmpty() :
                "checkpoint manifest has ${problems.size()} bad path(s):\n  " +
                problems.join("\n  ")
        }
    }

    test("every path in every checkpoint CSV exists — --outdir contains a comma (Task 4.5 direct proof)") {
        tag "stub"
        options "-stub"

        when {
            params {
                // THE DIRECT PROOF (Task 4.5, lib/Checkpoint.groovy:140-ish). Every
                // published path is built from --outdir, so a comma in --outdir is
                // the realistic way a checkpoint field ends up carrying a comma — no
                // synthetic filename needed. Before Checkpoint.row() quoted fields, a
                // bare `.join(',')` could not tell "a value with a comma in it" from
                // "a column boundary", so this comma would have shifted every LATER
                // column of every row whose path embedded it. Same fixture as the
                // first test above (two-slide VALIS) so the "checked" count below is
                // directly comparable.
                input  = "$projectDir/tests/testdata/test_input.csv"
                outdir = "${outputDir}/has,a,comma"
                // See the note on the first case: no manifest is written at the
                // default --cleanup_level=final, and a manifest is what this
                // asserts on.
                cleanup_level = 'none'
            }
        }

        then {
            assert workflow.success

            def csvDir = new File("${outputDir}/has,a,comma/csv".toString())
            assert csvDir.isDirectory() : "no csv/ directory was published"

            def manifests = (csvDir.listFiles() ?: [])
                .findAll { it.name.endsWith('.csv') }
                .sort { it.name }
            assert manifests.size() == 4 :
                "expected 4 checkpoint manifests, found ${manifests.size()}: " +
                manifests*.name

            // Sanity guard against a vacuous pass: at least one published field must
            // actually have been wrapped in RFC 4180 quotes, or this test would not
            // be exercising the fix at all (e.g. if --outdir were silently sanitized
            // upstream before reaching Checkpoint.row()).
            def sawQuotedField = manifests.any { csv -> csv.readLines().drop(1).any { it.contains('"') } }
            assert sawQuotedField :
                "no field in any manifest was quoted — this test did not exercise the " +
                "comma-in---outdir fix at all"

            def work = new File("${workDir}".toString()).absolutePath
            def problems  = []
            def checked   = 0
            manifests.each { csv ->
                def lines      = csv.readLines()
                def headerCols = csvFields(lines[0]).size()
                lines.drop(1).findAll { it.trim() }.each { line ->
                    def fields = csvFields(line)
                    // THE PROPERTY A BARE JOIN CANNOT GUARANTEE: every data row
                    // parses to the SAME field count as its own header. A shifted
                    // column (the pre-fix failure mode) fails here directly, instead
                    // of surfacing later as a wrong-looking path.
                    assert fields.size() == headerCols :
                        "${csv.name}: row has ${fields.size()} field(s), header declares " +
                        "${headerCols} (comma in --outdir shifted a column): ${line}"
                    fields.each { field ->
                        // No field is the bare four-character literal "null" — the
                        // failure mode an unquoted `null` VALUE used to produce.
                        assert field != 'null' :
                            "${csv.name}: field literally reads the text 'null': ${line}"
                        if (field.startsWith('/')) {
                            checked++
                            if (new File(field).absolutePath.startsWith(work + File.separator))
                                problems << "${csv.name}: inside the work directory (scratch, unpublished) -> ${field}"
                            else if (!new File(field).exists())
                                problems << "${csv.name}: does not exist -> ${field}"
                        }
                    }
                }
            }
            // Same fixture as the first test in this file: same 19 recorded paths.
            assert checked == 19 :
                "expected 19 recorded paths, examined ${checked} — did the CSV columns change?"
            assert problems.isEmpty() :
                "checkpoint manifest has ${problems.size()} bad path(s):\n  " +
                problems.join("\n  ")
        }
    }

    test("no checkpoint manifest at the DEFAULT --cleanup_level=final") {
        tag "stub"
        options "-stub"

        // The other side of the invariant, and the reason every case above had to
        // name --cleanup_level=none explicitly.
        //
        // At the default level the intermediates are not published, so a manifest
        // written anyway would record paths that do not exist -- turning the
        // invariant above red for a DESIGNED reason, which is the worst possible
        // outcome for a guard. Checkpoint.writesAtLevel makes the writers
        // level-aware instead, and this asserts the result rather than trusting it.
        //
        // Note the postprocessed manifest is absent TOO, which does not follow from
        // "final artifacts are published": its cell_csv, cell_geojson, merged_csv
        // and pyramid columns are all final, but its cell_mask column names a
        // segmentation mask, and segmentation is an intermediate. One dangling
        // column is enough to make the whole manifest a lie.

        when {
            params {
                input  = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                // The shipped default, written out rather than relied on, so this
                // case still means what it says if the default ever moves.
                cleanup_level = 'final'
            }
        }

        then {
            assert workflow.success

            def csvDir = new File("${outputDir}/csv".toString())
            def manifests = csvDir.isDirectory()
                ? (csvDir.listFiles() ?: []).findAll { it.name.endsWith('.csv') }.sort { it.name }
                : []
            assert manifests.isEmpty() :
                "expected NO checkpoint manifest at --cleanup_level=final, found " +
                manifests*.name

            // An empty csv/ is indistinguishable from a run that died before its
            // first checkpoint, so the directory has to say which it is.
            def readme = new File(csvDir, 'README.txt')
            assert readme.exists() : "csv/README.txt was not written"
            assert readme.text.contains('--cleanup_level none') :
                "csv/README.txt does not name the flag that restores the manifests"

            // And the run is still USEFUL: the final artifacts are all there. If
            // this ever passed with an empty output tree, the assertions above
            // would be satisfied by a pipeline that published nothing at all.
            ['geojson', 'pyramid', 'quantification'].each { kind ->
                def dir = new File("${outputDir}/P001/${kind}".toString())
                assert dir.isDirectory() && (dir.listFiles() ?: []).size() > 0 :
                    "final artifact directory ${kind}/ is missing or empty"
            }
            // ...and the intermediates are genuinely gone, or the case above proves
            // nothing about the gate.
            ['converted', 'preprocessed', 'split_channels', 'quantify'].each { kind ->
                def dir = new File("${outputDir}/P001/${kind}".toString())
                assert !dir.isDirectory() || (dir.listFiles() ?: []).size() == 0 :
                    "intermediate ${kind}/ was published at --cleanup_level=final"
            }
        }
    }
}
