/*
 * THE INVARIANT: a checkpoint manifest never names a file that does not exist.
 *
 * csv/preprocessed.csv, csv/registered.csv, csv/segmented.csv and csv/postprocessed.csv
 * are published artifacts AND restart inputs — `--start registration` opens the paths
 * registered.csv names, `--start postprocessing` opens the ones segmented.csv names
 * (csv/segmented.csv, Task 1 of arch-B-split, is the fourth manifest the "globbed, not
 * hardcoded" counts below now pick up automatically). A row pointing at a path nothing
 * published is not a cosmetic defect; it is a restart that fails, or a downstream
 * consumer silently reading the wrong file.
 *
 * These paths are CONSTRUCTED, not observed: the workflow predicts where publishDir
 * will put a file. THREE independent ways to mispredict it had accumulated by the
 * time this test was written, all three caught on its first run:
 *
 *   (b) EXPORT_GEOJSON emits into an `export/` subdirectory and publishDir carries
 *       that segment into the published path, but postprocess.nf recorded only the
 *       basename -> postprocessed.csv named <pid>/geojson/cells.geojson, which does
 *       not exist.
 *   (c) A reference that is never registered — a single-slide patient's, or EVERY
 *       patient's under the tiled backend — was recorded under <pid>/registered/,
 *       where no process publishes it. For a single-slide patient that directory
 *       does not exist at all.
 *   (d) The work-hash test that was supposed to recognise a bare task-directory
 *       output tested for a 32-character hash. Nextflow task directories are 30
 *       characters (`<work>/<2 hex>/<30 hex>`), so it never fired, and a bare output
 *       was recorded as <pid>/registered/<30-hex-hash>/<name>.
 *
 * The fixes are consequences of this test, not the other way round. Keep it general
 * — every absolute field of every row of every checkpoint — rather than asserting
 * the corrected paths: the next publishDir that emits into a subdirectory should
 * fail HERE, not on a user's restart.
 *
 * Tagged "stub" because CI's blocking gate is `nf-test test --tag stub`.
 */

nextflow_pipeline {

    name "Checkpoint manifests never name a file that does not exist"
    script "main.nf"

    tag "pipeline"
    tag "checkpoint_manifest"

    // RFC 4180 field split (Task 4.5). lib/Checkpoint.groovy's row() now quotes a
    // value containing a comma (an --outdir with a comma in it, embedded in every
    // published path, used to shift every later column of a bare `.join(',')` row).
    // Every REAL reader in the pipeline parses with Nextflow's own
    // `splitCsv(header: true)`, which already understands RFC 4180 quoting — but
    // this test's `then:` blocks read the published CSV text by hand, AFTER the
    // pipeline session has already exited, so `Channel`/`splitCsv` are not
    // available here. A naive `line.split(',')` in THIS file would be exactly the
    // "quoting writer, naive reader" trap Task 4.5 warns about: it would itself
    // mis-split a quoted field and corrupt the very invariant this test protects
    // (silently under-counting `checked`, or reporting a quoted path with its
    // wrapping `"` as a spurious "does not exist"). This closure splits on a comma
    // only when it is outside a quoted span, then strips a field's own surrounding
    // quotes and un-doubles any embedded `""` — the RFC 4180 decode paired with
    // Checkpoint.groovy's encode.
    def csvFields = { String line ->
        line.split(/,(?=(?:[^"]*"[^"]*")*[^"]*$)/, -1).collect { raw ->
            (raw.startsWith('"') && raw.endsWith('"') && raw.length() >= 2)
                ? raw[1..-2].replace('""', '"')
                : raw
        }
    }

    test("every path in every checkpoint CSV exists — two-slide patient (VALIS)") {
        tag "stub"
        options "-stub"

        when {
            params {
                // The default fixture: VALIS registers both slides, so both
                // registered rows carry REGISTER's own `registered_slides/`
                // output subdirectory into the published path.
                input  = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                // Every case in this file asserts on a checkpoint MANIFEST, and no
                // manifest is written at the default --cleanup_level=final: the
                // artifacts its rows name are not published there, so every path
                // would dangle (Checkpoint.writesAtLevel). The 'final' behaviour has
                // its own case at the end of this file.
                cleanup_level = 'none'
            }
        }

        then {
            assert workflow.success

            // --- the invariant ------------------------------------------------
            // TWO properties, not one.
            //
            //   1. every recorded path EXISTS, and
            //   2. no recorded path lies under the run's work directory.
            //
            // (2) is not redundant. Existence alone is blind to the failure mode this
            // manifest actually has: under the pre-fix `{32}` work-hash width the
            // single-slide reference was recorded as
            // <workDir>/49/bc25521f0d35abf9510e09738cbcad/P001_ref_corrected.ome.tif —
            // a path that EXISTS, so an existence-only check waves it through. The
            // work directory is scratch: -w is cleanable, it is not published, and a
            // manifest that points into it is a restart that breaks the first time
            // someone runs `nextflow clean`.
            //
            // Deliberately NOT "every path must start with outputDir". That would be
            // wrong: with --start registration a run legitimately records the
            // passthrough reference at the PRIOR run's outdir (verified — a run with
            // --outdir /tmp/A correctly wrote /tmp/B/P001/preprocessed/... into its
            // own registered.csv). Excluding workDir is the correct shape; requiring
            // an outputDir prefix is not.
            def csvDir = new File("${outputDir}/csv".toString())
            assert csvDir.isDirectory() : "no csv/ directory was published"

            // Globbed, not a hardcoded step list: a fourth checkpoint manifest is
            // covered the day it is added instead of silently going unchecked.
            def manifests = (csvDir.listFiles() ?: [])
                .findAll { it.name.endsWith('.csv') }
                .sort { it.name }
            assert manifests.size() == 4 :
                "expected 4 checkpoint manifests, found ${manifests.size()}: " +
                manifests*.name

            def work = new File("${workDir}".toString()).absolutePath
            def problems = []
            def checked  = 0
            manifests.each { csv ->
                csv.readLines().drop(1).findAll { it.trim() }.each { line ->
                    csvFields(line).each { field ->
                        // Absolute fields only: the rest are ids, booleans and
                        // pipe-joined channel names.
                        if (field.startsWith('/')) {
                            checked++
                            if (new File(field).absolutePath.startsWith(work + File.separator))
                                problems << "${csv.name}: inside the work directory (scratch, unpublished) -> ${field}"
                            else if (!new File(field).exists())
                                problems << "${csv.name}: does not exist -> ${field}"
                        }
                    }
                }
            }
            // Exact, not a lower bound: a lower bound lets a path column disappear
            // from a manifest without anyone noticing.
            assert checked == 19 :
                "expected 19 recorded paths, examined ${checked} — did the CSV columns change?"
            // ONE assertion covering both properties, deliberately: Groovy aborts at
            // the first failed assert, so splitting them would hide the work-directory
            // findings behind the existence findings whenever a change breaks both.
            assert problems.isEmpty() :
                "checkpoint manifest has ${problems.size()} bad path(s):\n  " +
                problems.join("\n  ")
        }
    }

    test("every path in every checkpoint CSV exists — single-slide patient (passthrough reference)") {
        tag "stub"
        options "-stub"

        when {
            params {
                // One reference and nothing else: registration has nothing to
                // register, so registration.nf's ch_passthrough branch carries the
                // reference through unregistered and NOTHING publishes it into
                // <pid>/registered/ — that directory is not created at all.
                input  = "$projectDir/tests/testdata/single_sample.csv"
                outdir = "$outputDir"
                // Every case in this file asserts on a checkpoint MANIFEST, and no
                // manifest is written at the default --cleanup_level=final: the
                // artifacts its rows name are not published there, so every path
                // would dangle (Checkpoint.writesAtLevel). The 'final' behaviour has
                // its own case at the end of this file.
                cleanup_level = 'none'
            }
        }

        then {
            assert workflow.success

            // --- the invariant ------------------------------------------------
            // TWO properties, not one.
            //
            //   1. every recorded path EXISTS, and
            //   2. no recorded path lies under the run's work directory.
            //
            // (2) is not redundant. Existence alone is blind to the failure mode this
            // manifest actually has: under the pre-fix `{32}` work-hash width the
            // single-slide reference was recorded as
            // <workDir>/49/bc25521f0d35abf9510e09738cbcad/P001_ref_corrected.ome.tif —
            // a path that EXISTS, so an existence-only check waves it through. The
            // work directory is scratch: -w is cleanable, it is not published, and a
            // manifest that points into it is a restart that breaks the first time
            // someone runs `nextflow clean`.
            //
            // Deliberately NOT "every path must start with outputDir". That would be
            // wrong: with --start registration a run legitimately records the
            // passthrough reference at the PRIOR run's outdir (verified — a run with
            // --outdir /tmp/A correctly wrote /tmp/B/P001/preprocessed/... into its
            // own registered.csv). Excluding workDir is the correct shape; requiring
            // an outputDir prefix is not.
            def csvDir = new File("${outputDir}/csv".toString())
            assert csvDir.isDirectory() : "no csv/ directory was published"

            // Globbed, not a hardcoded step list: a fourth checkpoint manifest is
            // covered the day it is added instead of silently going unchecked.
            def manifests = (csvDir.listFiles() ?: [])
                .findAll { it.name.endsWith('.csv') }
                .sort { it.name }
            assert manifests.size() == 4 :
                "expected 4 checkpoint manifests, found ${manifests.size()}: " +
                manifests*.name

            def work = new File("${workDir}".toString()).absolutePath
            def problems = []
            def checked  = 0
            manifests.each { csv ->
                csv.readLines().drop(1).findAll { it.trim() }.each { line ->
                    csvFields(line).each { field ->
                        // Absolute fields only: the rest are ids, booleans and
                        // pipe-joined channel names.
                        if (field.startsWith('/')) {
                            checked++
                            if (new File(field).absolutePath.startsWith(work + File.separator))
                                problems << "${csv.name}: inside the work directory (scratch, unpublished) -> ${field}"
                            else if (!new File(field).exists())
                                problems << "${csv.name}: does not exist -> ${field}"
                        }
                    }
                }
            }
            // Exact, not a lower bound: a lower bound lets a path column disappear
            // from a manifest without anyone noticing.
            assert checked == 12 :
                "expected 12 recorded paths, examined ${checked} — did the CSV columns change?"
            // ONE assertion covering both properties, deliberately: Groovy aborts at
            // the first failed assert, so splitting them would hide the work-directory
            // findings behind the existence findings whenever a change breaks both.
            assert problems.isEmpty() :
                "checkpoint manifest has ${problems.size()} bad path(s):\n  " +
                problems.join("\n  ")
        }
    }

    test("every path in every checkpoint CSV exists — tiled (STARE) method") {
        tag "stub"
        options "-stub"

        when {
            params {
                // The tiled backend passes EVERY patient's reference through
                // unregistered (it defines the frame), so this exercises the
                // passthrough branch on a MULTI-slide patient — and
                // TILED_STITCH's own `registered/` output subdirectory on the
                // moving slide.
                input               = "$projectDir/tests/testdata/test_input.csv"
                outdir              = "$outputDir"
                // Every case in this file asserts on a checkpoint MANIFEST, and no
                // manifest is written at the default --cleanup_level=final: the
                // artifacts its rows name are not published there, so every path
                // would dangle (Checkpoint.writesAtLevel). The 'final' behaviour has
                // its own case at the end of this file.
                cleanup_level = 'none'
                registration_method = 'tiled'
            }
        }

        then {
            assert workflow.success

            // --- the invariant ------------------------------------------------
            // TWO properties, not one.
            //
            //   1. every recorded path EXISTS, and
            //   2. no recorded path lies under the run's work directory.
            //
            // (2) is not redundant. Existence alone is blind to the failure mode this
            // manifest actually has: under the pre-fix `{32}` work-hash width the
            // single-slide reference was recorded as
            // <workDir>/49/bc25521f0d35abf9510e09738cbcad/P001_ref_corrected.ome.tif —
            // a path that EXISTS, so an existence-only check waves it through. The
            // work directory is scratch: -w is cleanable, it is not published, and a
            // manifest that points into it is a restart that breaks the first time
            // someone runs `nextflow clean`.
            //
            // Deliberately NOT "every path must start with outputDir". That would be
