/*
 * REGISTER_PATIENT: the shared registration core, called by REGISTRATION (linear) and
 * ADD_CYCLE. Most behaviour is asserted through those callers; what is asserted here:
 *
 *   1. the backend is chosen by the `method` argument, not params.registration_method.
 *      ADD_CYCLE passes the literal 'valis' because workflows/mirage.nf rejects
 *      --registration_method tiled in add_cycle mode; reading the param would lift
 *      that rejection.
 *   2. a single-slide group bypasses the adapter entirely (VALIS crashes on a lone
 *      image).
 */

nextflow_workflow {

    name "Test REGISTER_PATIENT subworkflow (stub)"
    script "subworkflows/local/register_patient.nf"
    workflow "REGISTER_PATIENT"

    tag "subworkflow"
    tag "registration"

    test("the method ARGUMENT wins over params.registration_method") {
        tag "stub"
        options "-stub"

        when {
            params {
                // The param says tiled; the caller says valis. The caller must win.
                registration_method = 'tiled'
                reg_qc = 0
            }
            workflow {
                """
                input[0] = Channel.of([
                    'P001',
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI','PANCK']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [
                      [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI','PANCK']],
                       file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                      [[patient_id: 'P001', id: 'P001_mov1', is_reference: false, channels: ['DAPI','CD3']],
                       file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                    ]
                ])
                input[1] = 'valis'
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('REGISTER')
                }.size() == 1 },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('TILED_')
                }.size() == 0 },
                { assert workflow.out.checkpoint_csv },
            )
        }
    }

    test("'tiled' selects the STARE backend") {
        tag "stub"
        options "-stub"

        when {
            params {
                // The mirror image: the param says valis, the caller says tiled.
                registration_method = 'valis'
                reg_qc = 0
            }
            workflow {
                """
                input[0] = Channel.of([
                    'P001',
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI','PANCK']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [
                      [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI','PANCK']],
                       file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                      [[patient_id: 'P001', id: 'P001_mov1', is_reference: false, channels: ['DAPI','CD3']],
                       file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                    ]
                ])
                input[1] = 'tiled'
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('TILED_')
                }.size() > 0 },
                { assert workflow.trace.tasks().findAll {
                    it.name =~ /(^|:)REGISTER\b/
                }.size() == 0 },
                { assert workflow.out.images_multi.size() >= 1,
                    "a two-slide patient reaches the adapter as images_multi" },
            )
        }
    }

    test("a single-slide group never reaches the adapter") {
        tag "stub"
        options "-stub"

        when {
            params {
                reg_qc = 0
            }
            workflow {
                """
                input[0] = Channel.of([
                    'P001',
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI','PANCK']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [
                      [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI','PANCK']],
                       file('$projectDir/tests/testdata/P001_ref.ome.tiff')]
                    ]
                ])
                input[1] = 'valis'
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Nothing registered — VALIS crashes on a lone image.
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('REGISTER')
                }.size() == 0 },
                // ...but the slide still reaches the registered stream, and the
                // checkpoint still records it (at its preprocessed/native location,
                // via meta.is_passthrough).
                { assert workflow.out.registered.size() == 1 },
                { assert workflow.out.checkpoint_csv },
                { assert workflow.out.images_multi.size() == 0,
                    "a single-slide group never reaches the adapter, so images_multi is empty" },
            )
        }
    }
}
