nextflow_process {

    name "Test CONVERT_IMAGE process"
    script "modules/local/convert_image.nf"
    process "CONVERT_IMAGE"

    tag "modules"
    tag "modules_local"
    tag "convert_image"

    test("Should convert to OME-TIFF - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                pixel_size = 0.325
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.ome_tiff },
                { assert process.out.versions },
                { with(process.out.ome_tiff) {
                    assert size() == 1
                    assert get(0).get(0).patient_id == 'P001'
                }}
            )
        }
    }

    test("Should create channels.txt file - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                pixel_size = 0.325
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { with(process.out.ome_tiff) {
                    // Check that channels.txt is emitted (third element in tuple)
                    assert get(0).get(2).toString().endsWith('_channels.txt')
                }}
            )
        }
    }

    test("Should preserve channel names from metadata - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                pixel_size = 0.325
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P002',
                        is_reference: false,
                        channels: ['DAPI', 'GFP', 'RFP']
                    ],
                    file('$projectDir/tests/testdata/P002_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { with(process.out.ome_tiff) {
                    assert get(0).get(0).channels == ['DAPI', 'GFP', 'RFP']
                }}
            )
        }
    }

    test("Should emit versions.yml with tifffile/bioio - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                pixel_size = 0.325
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.versions },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("Should render a valid --nuclear-markers for a scalar params value - real") {

        // REAL, not stub, and deliberately so. This asserts the RENDERED COMMAND, which
        // only a `script:` block produces -- `-stub` runs the stub block and never
        // evaluates line 32 at all. That is exactly how the defect this pins reached
        // main: every test for the scalar `--nuclear_markers CELLTOX` spelling was a
        // stub run, so nothing ever rendered the flag.
        //
        // The defect: `params.nuclear_markers.join(' ')` on a bare String does not throw.
        // Groovy dispatches it to Java's static String.join(CharSequence, CharSequence...)
        // with zero varargs, which returns the EMPTY string -- the rendered command
        // carried a bare `--nuclear-markers` and convert_image.py's nargs="+" exited 2
        // mid-run, naming the wrong problem. Against that code this test fails.
        //
        // Asserted on the rendered .command.sh rather than on process outcome, so it
        // holds whether the conversion itself succeeds or fails for unrelated
        // environmental reasons (arm64 host, missing container).
        tag "real"
        tag "slow"

        when {
            params {
                // The shape Nextflow produces for `--nuclear_markers CELLTOX` on the
                // command line. nextflow_schema.json permits it because an array cannot
                // be given on a command line at all.
                nuclear_markers = 'CELLTOX'
                pixel_size = 0.325
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['CELLTOX', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            // Nextflow lays tasks out as <workDir>/<2 hex>/<30 hex>/.command.sh.
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('convert_image.py'))
                    rendered << f.text
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered CONVERT_IMAGE .command.sh found under the task work dir" },
                // The whole assertion. With the defect the rendered line is a bare
                // `--nuclear-markers` followed by the shell line-continuation, so the
                // value is simply absent and this fails.
                { assert rendered.every { it.contains('--nuclear-markers CELLTOX') },
                    "rendered command lost the marker value: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should convert OME-TIFF with correct channels - real") {

        tag "real"
        tag "slow"

        when {
            params {
                pixel_size = 0.325
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.ome_tiff },
                { assert process.out.versions },
                // Meta preservation
                { assert process.out.ome_tiff.get(0).get(0).patient_id == 'P001' },
                { assert process.out.ome_tiff.get(0).get(0).is_reference == true },
                { assert process.out.ome_tiff.get(0).get(0).channels == ['DAPI', 'PANCK', 'SMA'] },
                // OME-TIFF output is non-trivial
                { assert file(process.out.ome_tiff.get(0).get(1)).size() > 1000 },
                // channels.txt content matches expected channel names. COMMA-separated:
                // bin/convert_image.py:658 writes `",".join(output_channels)` and the
                // stub block writes `meta.channels.join(',')`, so both paths agree. This
                // asserted newline-separated and could not have been observed failing --
                // `.text` on the unwrapped output threw MissingPropertyException first
                // (family 4), which is what hid it. Not to be confused with
                // tests/testdata/sample_channels.txt / expected/channels_3ch.txt, which
                // are one-per-line and belong to a different artifact.
                {
                    def channelsContent = file(process.out.ome_tiff.get(0).get(2)).text.trim()
                    assert channelsContent == 'DAPI,PANCK,SMA'
                }
            )
        }
    }

    test("Should render channels, pixel_size, nuclear-markers and output_dir - stub") {

        // No options "-stub": stub mode never evaluates script:, so this is the
        // only tag-"stub" case that reaches the rendered command. Gates the same
        // scalar-vs-list nuclear_markers defect the "real" case above pins, but
        // under CI's blocking `--tag stub` gate.
        tag "stub"

        when {
            params {
                pixel_size = 0.325
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('convert_image.py'))
                    rendered << f.text
            }

            assertAll(
                { assert rendered.size() >= 1 },
                { assert rendered.every { it.contains('--channels DAPI,PANCK,SMA') }, rendered.join(' --- ') },
                { assert rendered.every { it.contains('--pixel_size 0.325') }, rendered.join(' --- ') },
                { assert rendered.every { it.contains('--nuclear-markers DAPI CELLTOX') },
                    "nextflow.config's nuclear_markers list, space-joined by MarkerUtils.markerList: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--output_dir .') }, rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--nuclear-markers D A P I') },
                    "a scalar nuclear_markers must not be iterated character by character (the real-tagged case's point, now gated): " + rendered.join(' --- ') }
            )
        }
    }

    test("Should render a single-marker scalar nuclear_markers without iterating characters - stub") {

        tag "stub"

        when {
            params {
                pixel_size = 0.325
                nuclear_markers = 'DAPI'
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('convert_image.py'))
                    rendered << f.text
            }

            assertAll(
                { assert rendered.size() >= 1 },
                { assert rendered.every { it.contains('--nuclear-markers DAPI') }, rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--nuclear-markers D A P I') },
                    "a scalar nuclear_markers must not be iterated character by character (the real-tagged case's point, now gated): " + rendered.join(' --- ') }
            )
        }
    }
}
