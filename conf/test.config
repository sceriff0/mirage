/*
========================================================================================
    Test Profile Configuration - nf-core Compliant
========================================================================================
    Minimal test dataset to check pipeline function
    Reference: https://nf-co.re/docs/guidelines/pipelines/recommendations/testing
========================================================================================
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources for CI/local testing
    // pixel_size defaults to 'auto' (see nextflow.config), which reads each image's own
    // OME PhysicalSizeX. Pinned to a number here for the same reason seg_method and
    // cleanup_level are: the synthetic fixtures carry no OME PhysicalSize at all
    // (verified -- read_ome_pixel_size returns (None, None) for all six), so 'auto'
    // would (correctly) hard-fail at PREFLIGHT_SCALE before any process runs.
    pixel_size = 0.325
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '1.h'

    // Test input data (relative to pipeline root)
    input  = "${projectDir}/tests/testdata/test_input.csv"
    outdir = "test_results"

    // Pipeline step
    start = 'preprocessing'

    // Disable GPU for CI testing
    seg_gpu = false

    // Reduce computational requirements for fast testing.
    // MUST divide the fixtures into at least 2 BaSiC FOVs. The fixtures are 128x128
    // (tests/testdata/generate_complete_testdata.py), so 256 gave exactly ONE field and
    // bin/tile_for_basic.py refused it -- nf-core's basicpy module cannot fit an
    // illumination profile from a single site. 64 gives a 2x2 grid. Guarded by
    // tests/test_test_profile_fixture_compat.py so a fixture resize cannot silently
    // reintroduce the single-FOV case.
    preproc_tile_size         = 64

    // Registration parameters for minimal data
    memory_mode               = 'low'    // Use low memory mode for testing

    // Micro-registration OFF for the test fixtures. At the shipped default (2 =
    // micro-rigid + micro non-rigid) VALIS's micro passes kill the Bio-Formats JVM on
    // the 15.6 GiB CI runner -- REGISTER runs there at --memory-mode low --jvm-heap-gb 2,
    // and the run dies with "[FAIL] JVM was killed during registration". VALIS's own
    // remediation text names --micro-reg 0 as the first thing to try.
    //
    // COVERAGE NOTE: this means CI does not exercise the micro-registration path, in the
    // same way it does not exercise the shipped seg_method default (see seg_method below).
    // Micro-registration on a 128x128 synthetic fixture is not a meaningful test of it
    // anyway -- the real coverage has to come from a cluster run.
    reg_micro_reg             = 0

    // Segmentation parameters (minimal tiling)
    seg_n_tiles_y             = 2
    seg_n_tiles_x             = 2
    // CI pins the BaSiC correction ON — the pipeline default became skip_preprocessing=true
    // on 2026-09-10. Same reasoning as the seg_method pin below: the suite must keep
    // exercising the TILE_FOR_BASIC/BASICPY/APPLY_PROFILES path and the preprocessed
    // checkpoint it writes; the shipped default (conversion only) is covered by the
    // shipped_defaults_test profile's stub run instead.
    skip_preprocessing        = false
    // CI pins StarDist explicitly — the pipeline default is now 'instantseg'.
    // The built-in '2D_versatile_fluo' below is small, cached, and deterministic,
    // which keeps the real SEGMENT path cheap in CI. NOTE: this means CI does not
    // exercise the shipped default backend; see nextflow.config seg_method.
    seg_method                = 'stardist'
    // Use a StarDist built-in pretrained model (downloaded/cached at runtime) so
    // the real SEGMENT path runs in CI without shipping the production model.
    // The production stardist model (stardist_full_*) lives on the cluster behind
    // segmentation_model_dir; here we have no model dir, so segment.py loads the
    // built-in via StarDist2D.from_pretrained().
    segmentation_model        = '2D_versatile_fluo'
    segmentation_model_dir    = null
    // Lower StarDist detection threshold so the built-in model picks up the
    // small synthetic nuclei in the test fixtures (default ~0.48 misses them).
    seg_prob_thresh           = 0.3

    // QC generation (enabled but minimal)
    skip_registration_qc      = false
    qc_scale_factor           = 0.1

    debug_channels            = false

    // OUTPUT CLEANUP — both pinned EXPLICITLY, for the same reason seg_method is
    // pinned to 'stardist' above: the test profile exists to exercise the
    // pipeline's mechanics cheaply, and must not drift with a shipped default.
    // cleanup_work is pinned AWAY from its default (true); cleanup_level's pin
    // ('none') has matched the shipped default since 2026-09-10 (it was 'final'
    // before) and stays explicit so this profile's meaning does not move if the
    // default does again. The cleaning level has its own dedicated cases
    // (tests/checkpoint_manifest.nf.test's --cleanup_level=final case,
    // tests/cleanup_work.sh) so it is not left uncovered.
    //
    // cleanup_work: Nextflow's `cleanup` removes the work directory's task files at
    // SESSION TEARDOWN, and nf-test computes its file snapshots AFTER the session
    // has exited. The files it hashes are gone by then, so a `snapshot(...)` that
    // used to record `versions.yml:md5,a884...` records a bare absolute path
    // instead and every snapshot in the suite mismatches. Measured: 78 of 221
    // stub tests failed with cleanup_work at its new default of true.
    cleanup_work              = false

    // cleanup_level: most module tests assert on a PUBLISHED artifact, which at
    // 'final' is not published at all. Pinned so they keep asserting on the
    // mechanism they were written for rather than on the publishing policy.
    cleanup_level             = 'none'
}

process {
    // Local executor for testing
    executor = 'local'

    // Default minimal resources
    cpus   = { 1    }
    memory = { 2.GB }
    time   = { 30.m }

    // Resource labels for testing
    withLabel: 'process_single' {
        cpus   = 1
        memory = 2.GB
        time   = 15.m
    }

    withLabel: 'process_low' {
        cpus   = 1
        memory = 2.GB
        time   = 30.m
    }

    withLabel: 'process_medium' {
        cpus   = 2
        memory = 4.GB
        time   = 1.h
    }

    withLabel: 'process_high' {
        cpus   = 2
        memory = 6.GB
        time   = 1.h
    }

    // Error handling for CI
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'
}

// Disable Seqera Platform/Tower for testing (no token needed)
tower {
    enabled = false
}

// Container settings - will be overridden by profile (docker/singularity)
// Don't hardcode docker.enabled here to allow singularity profile to work
