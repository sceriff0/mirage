/*
 * Segmentation arms only — layered by run_arms.sh as a second `-c` when arm_kind is
 * 'segmentation' (user ruling 2026-10-01). Benchmark-only: main/dev are untouched.
 *
 * A segmentation arm is read for its masks and its quantification, never for the
 * QuPath deliverables. reg_zoom / reg_crop read csv/segmented.csv (registered_image +
 * cell_mask / nuclei_mask); nothing under benchmarks/ reads the pyramidal OME-TIFF or
 * cells.geojson. Both modules already declare
 * `when: task.ext.when == null || task.ext.when`, so this switches them off without a
 * pipeline change. The cost: a seg arm's result cannot be opened in QuPath/FlowPath,
 * and its csv/postprocessed.csv has no rows (its join needs both outputs).
 */
process {
    withName: 'MERGE_AND_PYRAMID|EXPORT_GEOJSON' {
        ext.when = false
    }
}
