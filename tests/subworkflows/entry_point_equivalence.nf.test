/*
 * A checkpoint-entered meta (READ_SEGMENTED_CHECKPOINT -> Meta.fromCheckpointRow /
 * CsvUtils.metaContextFromCheckpoint) must carry keep_channels and channels_count, not
 * just patient_id/id/is_reference/channels. Without keep_channels, SPLIT_CHANNELS falls
 * back to the full declared list (an extra DAPI plane) and QUANTIFY runs twice.
 *
 * One nextflow_workflow block only: nf-test 0.9.5 ran only the last block of a file
 * with several, so a second block would silently skip one of the assertions.
 */

nextflow_workflow {

    name "A checkpoint-entered meta carries the same keys as a samplesheet meta"
    script "subworkflows/local/segmentation.nf"
    workflow "READ_SEGMENTED_CHECKPOINT"

    tag "subworkflows"
    tag "segmentation"
    tag "stub"

    test("Checkpoint meta carries keep_channels/channels_count, matching the samplesheet path") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = "${projectDir}/tests/testdata/segmented.csv"
                input[1] = ParamUtils.compartmentMode(params)
                """
            }
        }

        then {
            assert workflow.success

            def metas = workflow.out.samples.collect { it[0] }
            assert metas.size() == 2 : "expected reference + one moving slide, got: ${metas}"

            // Both keys must be present on every checkpoint-entered meta, not
            // merely on the reference row.
            metas.each { meta ->
                assert meta.containsKey('keep_channels') : "keep_channels missing: ${meta}"
                assert meta.containsKey('channels_count') : "channels_count missing: ${meta}"
            }

            def refMeta = metas.find { it.is_reference }
            def movMeta = metas.find { !it.is_reference }
            assert refMeta != null && movMeta != null

            // tests/testdata/segmented.csv declares the same two rows as
            // test_input.csv. Claim-once (reference first): the reference keeps its
            // three channels; the moving slide's DAPI is already claimed, so it keeps
            // CD3 and CD8.
            assert refMeta.keep_channels == ['DAPI', 'PANCK', 'SMA']
            assert movMeta.keep_channels == ['CD3', 'CD8']

            // channels_count is the per-patient total (3 + 2 = 5) on every row, the
            // same value input_check.nf.test asserts for the samplesheet path.
            // Hard-coded because the nf-test assertion context cannot see lib/.
            assert refMeta.channels_count == 5
            assert movMeta.channels_count == 5
        }
    }
}
