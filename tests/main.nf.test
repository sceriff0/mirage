nextflow_pipeline {

    name "Test full MIRAGE pipeline"
    script "main.nf"

    tag "pipeline"
    tag "pipeline_mirage"

    //==========================================================================
    // NF-CORE STANDARD TESTS - Essential pipeline behavior
    //==========================================================================

    test("Should fail with missing required --input param") {
        tag "stub"

        when {
            params {
                outdir = "$outputDir"
                start = "preprocessing"
                // Note: --input is NOT set
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("Should fail with missing required --outdir param") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                start = "preprocessing"
                // outdir is nulled here because conf/test.config sets a default outdir;
                // omitting it would never exercise the missing-flag case.
                outdir = null
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                // nf-schema reports a missing outdir on stderr, the ParamUtils.validateOutdir
                // fallback via stdout/errorReport: search all three for the parameter name.
                { assert (workflow.stdout + workflow.stderr).any { it.contains("outdir") } ||
                         (workflow.errorReport ?: '').contains("outdir") }
            )
        }
    }

    test("Should fail with empty samplesheet") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/empty_samplesheet.csv"
                outdir = "$outputDir"
                start = "preprocessing"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("Should handle single-sample samplesheet - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/single_sample.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir").exists() }
            )
        }
    }

    test("Should not drop rows whose patient_id has surrounding whitespace") {
        tag "stub"
        options "-stub"

        when {
            params {
                input  = "$projectDir/tests/testdata/whitespace_patient_id.csv"
                outdir = "$outputDir"
                start  = "preprocessing"
                stop   = "preprocessing"
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // both rows must reach preprocessing, not zero and not one
                { assert path("$outputDir/csv/preprocessed.csv").readLines().size() == 3 }  // header + 2
            )
        }
    }

    test("Should complete dry_run with zero process executions") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                dry_run = true
            }
        }

        then {
            assert workflow.success
        }
    }

    //==========================================================================
    // TEST PROFILE TESTS - Quick validation
    //==========================================================================

    test("Should run with test profile") {
        tag "real"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assert workflow.success
            assert path("$outputDir/csv/preprocessed.csv").exists()
        }
    }

    test("Should run with test profile - stub mode") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assert workflow.success
            assert path("$outputDir").exists()
        }
    }

    //==========================================================================
    // PREPROCESSING STEP TESTS
    //==========================================================================

    test("Should run preprocessing step - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false

                preproc_tile_size = 64
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir").exists() }
            )
        }
    }

    test("Should run preprocessing with multi-patient data") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_preprocessing.csv"
                outdir = "$outputDir"
                start = "preprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/csv").exists() }
            )
        }
    }

    //==========================================================================
    // REGISTRATION STEP TESTS
    //==========================================================================

    test("Should run registration from checkpoint") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                outdir = "$outputDir"
                start = "registration"

                max_cpus = 2
                max_memory = '6.GB'
                skip_registration_qc = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir").exists() }
            )
        }
    }

    test("Should run registration with VALIS method - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                outdir = "$outputDir"
                start = "registration"
                max_cpus = 2
                max_memory = '6.GB'
                skip_registration_qc = true
            }
        }

        then {
            assert workflow.success
        }
    }

    //==========================================================================
    // POSTPROCESSING STEP TESTS
    //==========================================================================

    test("Should run postprocessing from checkpoint - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_segmented.csv"
                outdir = "$outputDir"
                start = "postprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assert workflow.success
        }
    }

    //==========================================================================
    // VALIDATION TESTS - Input validation
    //==========================================================================

    test("Should fail with invalid start") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "invalid_step_name"
            }
        }

        then {
            assert workflow.failed
            assert workflow.errorMessage != null
        }
    }

    test("Should fail with invalid registration method") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                outdir = "$outputDir"
                start = "registration"
                registration_method = "invalid_method"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("Should reject missing DAPI channel") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/invalid_no_dapi.csv"
                outdir = "$outputDir"
                start = "preprocessing"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("VALIS refuses, at launch, a patient whose two slides share one channel set") {
        tag "stub"
        tag "channel_set"

        // RegisteredMatch pairs VALIS outputs back to metas by channel set, so two slides
        // with the same set are indistinguishable after REGISTER. dry_run proves the refusal
        // happens in CsvUtils.validateInputSemantics, before any task.
        when {
            params {
                input = "$projectDir/tests/testdata/duplicate_channel_set.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                registration_method = "valis"
                dry_run = true
            }
        }

        then {
            assert workflow.failed
            def log = new File("${launchDir}/meta/nextflow.log").text
            assert log.contains("share the same channel set")
            assert log.contains("cd3|cd8|dapi")     // the signature, lower-cased and sorted
            assert log.contains("patient P001")
            assert log.contains("row 3") && log.contains("row 4")
        }
    }

    test("the tiled backend refuses the duplicate-channel-set sheet too: shared non-nuclear channels are refused at launch on every backend") {
        tag "stub"
        tag "channel_set"

        // The VALIS-only signature rule (Rule B) does not apply to tiled, but rows 3 and 4
        // share the non-nuclear channels CD3 and CD8, which the unconditional cross-slide
        // rule (Rule A) refuses on any backend.
        when {
            params {
                input = "$projectDir/tests/testdata/duplicate_channel_set.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                registration_method = "tiled"
                dry_run = true
            }
        }

        then {
            assert workflow.failed
            def report = new File("${launchDir}/meta/nextflow.log").text
            assert report.contains("appears on 2 different slides")
            assert report.contains("patient P001")
            assert report.contains("row 3") && report.contains("row 4")
            assert !report.contains("share the same channel set")
        }
    }

    test("a segmentation re-entry still refuses the shared non-nuclear channels: Rule A applies at every --start") {
        tag "stub"
        tag "channel_set"

        // --start segmentation does not run REGISTER, so Rule B is skipped (the negative
        // assertion below checks that); Rule A still refuses rows 3 and 4 sharing CD3/CD8.
        when {
            params {
                input = "$projectDir/tests/testdata/duplicate_channel_set_registered.csv"
                outdir = "$outputDir"
                start = "segmentation"
                registration_method = "valis"
                dry_run = true
            }
        }

        then {
            assert workflow.failed
            def report = new File("${launchDir}/meta/nextflow.log").text
            assert report.contains("appears on 2 different slides")
            assert report.contains("patient P001")
            assert !report.contains("share the same channel set")
        }
    }

    test("Should reject a samplesheet that marks no reference") {
        tag "stub"

        // A sheet naming no reference is refused on every path but add_cycle's, whose
        // reference comes from the prior run.
        when {
            params {
                input = "$projectDir/tests/testdata/invalid_no_ref.csv"
                outdir = "$outputDir"
                start = "preprocessing"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("per-patient group sizes are not miscounted when the reference keeps its nuclear channel") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // CsvUtils.countChannelsPerPatient drops the nuclear channel for non-reference rows
                // only, so P001 counts {DAPI,PANCK,SMA} + {CD3,CD8} = 5. A count of 4 would make
                // groupTuple emit the surplus as a second group: MERGE_QUANT_CSVS's keyed join would
                // silently drop it, MERGE_AND_PYRAMID would abort on it. `workflow.success` sees
                // neither, hence the explicit task counts.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }.size() == 5 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:MERGE_QUANT_CSVS') }.size() == 1 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:ASSEMBLE_EXPORT:MERGE_AND_PYRAMID') }.size() == 1 }
            )
        }
    }

    test("a non-reference CELLTOX slide is counted as one dropped nuclear channel") {

        tag "stub"
        options "-stub"

        when {
            params {
                // nuclear_markers is not overridden: this runs on the shipped ['DAPI','CELLTOX'].
                input  = "$projectDir/tests/testdata/celltox_nonreference.csv"
                outdir = "$outputDir"
                start  = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Reference keeps {DAPI,PANCK,SMA}; the other slide keeps {CELLTOX,CD3,CD8}, since
                // the reference never claimed CELLTOX. Six markers, six QUANTIFY tasks, one
                // per-patient consumer.
                //
                // This is the count half of the invariant; tests/unit/test_nuclear_markers.py pins
                // bin/split_multichannel.py emitting the same six. Keep the two in step.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }.size() == 6 },
                // An under-count would not show as 2 here: the keyed inner join upstream silently
                // drops the surplus group instead of running a second MERGE_QUANT_CSVS.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:MERGE_QUANT_CSVS') }.size() == 1 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:ASSEMBLE_EXPORT:MERGE_AND_PYRAMID') }.size() == 1 }
            )
        }
    }

    test("a slide whose every channel is already claimed splits nothing") {

        tag "stub"
        options "-stub"

        when {
            params {
                // The moving slide carries only DAPI, so resolveKeptChannelsPerSlide gives it an
                // empty keep-set ("no new markers"), counted as zero: channels_count is 3.
                input  = "$projectDir/tests/testdata/keepset_exhausted.csv"
                outdir = "$outputDir"
                start  = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // An empty keep-set must not fall back to the full channel list (Groovy treats []
                // as falsy under `?:`): that would quantify DAPI twice, 4 tasks against a count of 3.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }.size() == 3 },
                // The empty-keep-set slide is filtered out before SPLIT_CHANNELS, whose `*.tiff`
                // output stays mandatory so a genuinely failed split still fails.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:SPLIT_CHANNELS') }.size() == 1 },
                // Exactly one DAPI, and the three names are the reference's panel.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }
                        .collect { it.name.replaceAll(/^.*\(P001 - (.*)\)$/, '$1') }.toSorted() ==
                        ['DAPI', 'PANCK', 'SMA'] },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:ASSEMBLE_EXPORT:MERGE_AND_PYRAMID') }.size() == 1 }
            )
        }
    }

    test("two slides sharing an image basename keep distinct keep-sets") {

        tag "stub"
        options "-stub"

        when {
            params {
                // cycle1/slide.ome.tiff (DAPI|CD3, reference) + cycle2/slide.ome.tiff (DAPI|CD8):
                // one directory per cycle, so a shared basename is an ordinary input.
                //
                // reg_qc=0 and skip_preprocess_qc avoid a separate defect: meta.id comes from
                // simpleName, so both rows are `P001_slide` and per-slide QC artifacts collide by
                // filename. The keep-set is asserted directly instead.
                input  = "$projectDir/tests/testdata/duplicate_basename.csv"
                outdir = "$outputDir"
                start  = "preprocessing"
                reg_qc = 0
                skip_preprocess_qc = true
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Patient total is 3: the reference claims DAPI+CD3, cycle2 keeps CD8. Keying the
                // keep-set on basename would collapse the two rows.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }.size() == 3 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }
                        .collect { it.name.replaceAll(/^.*\(P001 - (.*)\)$/, '$1') }.toSorted() ==
                        ['CD3', 'CD8', 'DAPI'] },
                // Both slides still split -- neither keep-set is empty here.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:SPLIT_CHANNELS') }.size() == 2 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:ASSEMBLE_EXPORT:MERGE_AND_PYRAMID') }.size() == 1 }
            )
        }
    }

    test("a CELLTOX-only samplesheet runs end to end under --nuclear_markers CELLTOX") {

        tag "stub"
        options "-stub"

        when {
            params {
                // No DAPI channel anywhere: the marker list is fully configurable.
                input           = "$projectDir/tests/testdata/celltox_only.csv"
                nuclear_markers = ['CELLTOX']
                outdir          = "$outputDir"
                start           = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // {CELLTOX,PANCK,SMA} from the reference + {CD3,CD8} from the moving
                // slide = 5, exactly as for the DAPI-configured sheet.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }.size() == 5 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:MERGE_QUANT_CSVS') }.size() == 1 }
            )
        }
    }

    test("a scalar --nuclear_markers is not iterated character by character") {

        tag "stub"
        options "-stub"

        when {
            params {
                // Nextflow passes `--nuclear_markers CELLTOX` as a bare String; iterated as a List
                // it would yield characters and match 'PANCK' on 'C'. MarkerUtils.markerList coerces
                // it, so this counts the same 5 markers as the List spelling above.
                input           = "$projectDir/tests/testdata/celltox_only.csv"
                nuclear_markers = 'CELLTOX'
                outdir          = "$outputDir"
                start           = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }.size() == 5 }
            )
        }
    }

    test("a comma-joined nuclear_markers element is split, not taken as one marker") {

        tag "stub"
        options "-stub"

        when {
            params {
                // The single-string list shape from a params file. Unsplit, 'CELLTOX,DAPI' would
                // match no channel and keep the nuclear channel on the moving slide: six files
                // against a groupTuple of 5, a silent second MERGE_QUANT_CSVS.
                input           = "$projectDir/tests/testdata/celltox_only.csv"
                nuclear_markers = ['CELLTOX,DAPI']
                outdir          = "$outputDir"
                start           = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }.size() == 5 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:MERGE_QUANT_CSVS') }.size() == 1 }
            )
        }
    }

    test("Should reject missing checkpoint columns") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/invalid_checkpoint_missing_col.csv"
                outdir = "$outputDir"
                start = "registration"
            }
        }

        then {
            assert workflow.failed
        }
    }

    //==========================================================================
    // STOP PARAMETER TESTS
    //==========================================================================

    test("Should fail with invalid --stop value") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                stop = "invalid_stop"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("Should fail when --stop is before --start") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                outdir = "$outputDir"
                start = "registration"
                stop = "preprocessing"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("Should run only preprocessing when stop=preprocessing - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                stop = "preprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/csv/preprocessed.csv").exists() },
                // Registration and postprocessing must NOT have run
                { assert !path("$outputDir/csv/registered.csv").exists() },
                { assert !path("$outputDir/csv/postprocessed.csv").exists() }
            )
        }
    }

    test("Should run preprocessing+registration when stop=registration - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                stop = "registration"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/csv/preprocessed.csv").exists() },
                { assert path("$outputDir/csv/registered.csv").exists() },
                // Postprocessing must NOT have run
                { assert !path("$outputDir/csv/postprocessed.csv").exists() }
            )
        }
    }

    test("Should run only registration when start=registration stop=registration - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                outdir = "$outputDir"
                start = "registration"
                stop = "registration"

                max_cpus = 2
                max_memory = '6.GB'
                skip_registration_qc = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/csv/registered.csv").exists() },
                // Preprocessing and postprocessing must NOT have run
                { assert !path("$outputDir/csv/preprocessed.csv").exists() },
                { assert !path("$outputDir/csv/postprocessed.csv").exists() }
            )
        }
    }

    test("Should run preprocessing+registration+segmentation when stop=segmentation - stub") {

        tag "stub"
        options "-stub"

        // Covers --stop segmentation, the step's own gate as a stop.
        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                stop = "segmentation"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/csv/preprocessed.csv").exists() },
                { assert path("$outputDir/csv/registered.csv").exists() },
                { assert path("$outputDir/csv/segmented.csv").exists() },
                // Postprocessing must NOT have run
                { assert !path("$outputDir/csv/postprocessed.csv").exists() }
            )
        }
    }

    test("Should run registration+segmentation when start=registration stop=segmentation - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                outdir = "$outputDir"
                start = "registration"
                stop = "segmentation"

                max_cpus = 2
                max_memory = '6.GB'
                skip_registration_qc = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/csv/registered.csv").exists() },
                { assert path("$outputDir/csv/segmented.csv").exists() },
                // Preprocessing and postprocessing must NOT have run
                { assert !path("$outputDir/csv/preprocessed.csv").exists() },
                { assert !path("$outputDir/csv/postprocessed.csv").exists() }
            )
        }
    }

    test("Should run only segmentation when start=segmentation stop=segmentation - stub") {

        tag "stub"
        options "-stub"

        // valid_checkpoint_postprocessing.csv has the shape of a registration run's
        // csv/registered.csv, which is what `segmentation` reads; the name predates the step.
        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_postprocessing.csv"
                outdir = "$outputDir"
                start = "segmentation"
                stop = "segmentation"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/csv/segmented.csv").exists() },
                // Nothing before or after it may have run
                { assert !path("$outputDir/csv/preprocessed.csv").exists() },
                { assert !path("$outputDir/csv/registered.csv").exists() },
                { assert !path("$outputDir/csv/postprocessed.csv").exists() }
            )
        }
    }

    test("Should complete dry_run with stop parameter") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                stop = "registration"
                dry_run = true
            }
        }

        then {
            assert workflow.success
        }
    }

    //==========================================================================
    // ROUTER SHAPE — one input read, one QC aggregation
    //==========================================================================

    /*
     * Both the standard and add_cycle paths aggregate QC through final_qc.nf. The
     * fully-qualified task name proves the report comes from exactly one call site; a
     * bare existence check would pass if a second aggregation overwrote it.
     */
    test("Should aggregate QC exactly once, through FINAL_QC - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:FINAL_QC:GENERATE_QC_REPORT') }.size() == 1 },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('GENERATE_QC_REPORT') }.size() == 1 },
                // enable_trace defaults true, so the size rollup (the other half of FINAL_QC)
                // must also run exactly once.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:FINAL_QC:AGGREGATE_SIZE_LOGS') }.size() == 1 },
                { assert path("$outputDir/qc").list().any {
                    it.toString().contains('mirage_qc_report_') } },
                { assert path("$outputDir/size_logs/input_sizes.csv").exists() },
                // The aggregated stub CSV carries real rows, not just a header: assert both.
                { def sizes = new File("$outputDir/size_logs/input_sizes.csv").readLines()
                  assert sizes[0] == 'process,sample_id,filename,bytes'
                  assert sizes.size() > 1
                  assert sizes.drop(1).every { !it.startsWith('STUB,') }
                  assert sizes.any { it.contains('CONVERT_IMAGE,') } }
            )
        }
    }

    /*
     * FINAL_QC runs unconditionally with its gates inside. A run wanting neither half
     * must complete rather than hang on an unconsumed channel.
     */
    test("Should complete with no report and no size rollup when both are off - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                skip_final_qc_report = true
                enable_trace = false

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('GENERATE_QC_REPORT') }.size() == 0 },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('AGGREGATE_SIZE_LOGS') }.size() == 0 },
                // The rest of the pipeline is unaffected.
                { assert path("$outputDir/csv/postprocessed.csv").exists() }
            )
        }
    }

    /*
     * The samplesheet is read once, by INPUT_CHECK, with the column fixed by --start.
     * Starting mid-pipeline must read the checkpoint's own column (registered_image).
     */
    test("Should read the entry step's image column, once - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_segmented.csv"
                outdir = "$outputDir"
                start = "postprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // One patient, two registered images -> two SPLIT_CHANNELS and one per-patient
                // merge. A second read of the sheet or a lost images_count would change these.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:SPLIT_CHANNELS') }.size() == 2 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:MERGE_QUANT_CSVS') }.size() == 1 },
                // --start postprocessing reuses the checkpoint's masks; re-segmenting would
                // silently discard them.
                { assert workflow.trace.tasks().findAll {
                    it.name.contains(':SEGMENT') }.size() == 0 },
                { assert path("$outputDir/csv/postprocessed.csv").exists() }
            )
        }
    }

    test("Should name the trace path it looked for when no report can be made") {

        // trace_dir is relative on purpose: the leading slash in the asserted path proves
        // ResourceReport.tracePath resolved it against launchDir.
        tag "stub"
        options "-stub"

        when {
            params {
                input       = "$projectDir/tests/testdata/single_sample.csv"
                outdir      = "$outputDir"
                start       = "preprocessing"
                stop        = "preprocessing"
                seg_gpu     = false
                enable_trace = false
                trace_dir   = 'plan10_relative_trace_dir'
            }
        }

        then {
            // Also read meta/nextflow.log: without nf-test --verbose, Nextflow runs with -quiet
            // and log.warn never reaches stdout/stderr.
            def runLog = new File("${launchDir}/meta/nextflow.log")
            def said = workflow.stdout + workflow.stderr +
                       (runLog.exists() ? runLog.readLines() : [])
            assertAll(
                { assert workflow.success },
                { assert said.any { it.contains('/plan10_relative_trace_dir/trace.txt') },
                    "the diagnostic did not name an ABSOLUTE trace path: " + said.join(' | ') },
                { assert said.any { it.contains('enable_trace') },
                    "the diagnostic did not say whether tracing was on: " + said.join(' | ') },
                // Nothing is written: an empty report page that says "not available"
                // is worse than no page, because it looks like a report.
                { assert !new File("$outputDir/qc/mirage_resource_report.html").exists() }
            )
        }
    }

    test("Should write the resource report when the trace is where it says it is") {

        // When a trace file exists at the resolved path, the report is produced.
        //
        // The trace is pre-seeded under $outputDir because nf-test adds its own `-with-trace`
        // to every run, which overrides trace.file, and a second `-with-trace` is rejected.
        // CI's nf-test run has the same flag, so this is the real CI shape.
        tag "stub"
        options "-stub"

        when {
            new File("$outputDir/faketrace").mkdirs()
            new File("$outputDir/faketrace/trace.txt").text =
                "task_id\tprocess\ttag\tname\tstatus\texit\tsubmit\tstart\tcomplete\t" +
                "duration\trealtime\t%cpu\tcpus\tmemory\tpeak_rss\tpeak_vmem\trchar\twchar\n" +
                "1\tMIRAGE:PREPROCESSING:CONVERT_IMAGE\tP001\t" +
                "MIRAGE:PREPROCESSING:CONVERT_IMAGE (P001)\tCOMPLETED\t0\t" +
                "2026-09-02 00:00:00.000\t2026-09-02 00:00:00.100\t2026-09-02 00:00:00.200\t" +
                "200ms\t100ms\t50.0%\t1\t2 GB\t500 MB\t1 GB\t10 MB\t5 MB\n"
            params {
                input     = "$projectDir/tests/testdata/single_sample.csv"
                outdir    = "$outputDir"
                start     = "preprocessing"
                stop      = "preprocessing"
                seg_gpu   = false
                trace_dir = "$outputDir/faketrace"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/qc/mirage_resource_report.html").exists() },
                { assert path("$outputDir/qc/mirage_resource_report.html").text
                         .contains("MIRAGE Computational Resource Report") }
            )
        }
    }

    test("Should refuse --start registration when a checkpoint path no longer exists") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/invalid_checkpoint_dangling_path.csv"
                outdir = "$outputDir"
                start = "registration"
            }
        }

        then {
            assert workflow.failed
            def report = (workflow.stdout + workflow.stderr).join('\n') + (workflow.errorReport ?: '') + (workflow.errorMessage ?: '')
            assert report.contains('P001_deleted_after_the_run.ome.tiff') : "the refusal must name the missing file: " + report
        }
    }

    test("Should reject a samplesheet whose is_reference is yes/no rather than true/false") {
        tag "stub"
        options "-stub"
        when {
            params {
                input = "$projectDir/tests/testdata/invalid_is_reference_yes.csv"
                outdir = "$outputDir"
                start = "preprocessing"
            }
        }
        then {
            assert workflow.failed
            def report = (workflow.stdout + workflow.stderr).join('\n') + (workflow.errorReport ?: '') + (workflow.errorMessage ?: '')
            assert report.contains("Must be 'true' or 'false'") : report
            assert report.contains("'yes'") : "the offending value is named: " + report
        }
    }

    test("Should publish the segmented checkpoint and geojson when starting at segmentation - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_postprocessing.csv"
                outdir = "$outputDir"
                start = "segmentation"
            }
        }

        then {
            assert workflow.success
            assert new File("$outputDir/csv/segmented.csv").exists() : "segmented.csv is the step's checkpoint"
            assert new File("$outputDir/csv/postprocessed.csv").exists() : "the run continued to the end"
            assert new File("$outputDir/P001/geojson").isDirectory()
        }
    }

    test("Should publish quantification, geojson and the zarr when starting at postprocessing - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_segmented.csv"
                outdir = "$outputDir"
                start = "postprocessing"
            }
        }

        then {
            assert workflow.success
            assert new File("$outputDir/P001/quantification").isDirectory()
            assert new File("$outputDir/P001/geojson").isDirectory()
            assert new File("$outputDir/P001/spatialdata/P001.zarr").isDirectory()
            assert !new File("$outputDir/csv/registered.csv").exists() : "no registration ran, so no registration checkpoint may be written"
        }
    }

    // The fixture repeats both DAPI (nuclear, legal) and PANCK (illegal) across P001's
    // slides. `trace.tasks().size() == 0` is the subject: the rule must fire in
    // samplesheet validation, before any process runs.
    test("Should refuse a non-nuclear channel shared by two slides of one patient, before any process runs") {
        tag "stub"
        options "-stub"
        when {
            params {
                input = "$projectDir/tests/testdata/invalid_duplicate_channel.csv"
                outdir = "$outputDir"
                start = "preprocessing"
            }
        }
        then {
            assert workflow.failed
            def report = (workflow.stdout + workflow.stderr).join('\n') + (workflow.errorReport ?: '') + (workflow.errorMessage ?: '')
            assert report.contains('PANCK') : "the refusal must name the offending channel: " + report
            assert report.contains('P001') : "the refusal must name the patient: " + report
            assert report.contains('nuclear_markers') : "the refusal must name the remedy: " + report
            assert workflow.trace.tasks().size() == 0 : "the refusal is at LAUNCH: no process may have been instantiated"
            assert !report.contains('Error executing process') : "the run must not have reached a process: " + report
        }
    }

}
