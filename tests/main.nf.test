nextflow_pipeline {

    name "Test full MIRAGE pipeline"
    script "main.nf"

    tag "pipeline"
    tag "pipeline_mirage"

    //==========================================================================
    // NF-CORE STANDARD TESTS - Essential pipeline behavior
    //==========================================================================

    test("Should fail with missing required --input param") {
        tag "stub"

        when {
            params {
                outdir = "$outputDir"
                start = "preprocessing"
                // Note: --input is NOT set
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("Should fail with missing required --outdir param") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                start = "preprocessing"
                // outdir is explicitly nulled out here: the "test,docker" profile
                // (nf-test.config) includes conf/test.config, which sets a default
                // outdir = "test_results". Simply omitting `outdir` from this block
                // would inherit that default and never exercise a null outdir, so
                // this test-params override (highest precedence) sets it to null
                // directly to reproduce the missing-flag case.
                outdir = null
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                // nf-schema reports "Missing required parameter(s): outdir" on
                // stderr, while the Groovy fallback (ParamUtils.validateOutdir)
                // surfaces via stdout/errorReport — search all three so this
                // asserts the operator is told *which* parameter is missing,
                // whichever layer catches it.
                { assert (workflow.stdout + workflow.stderr).any { it.contains("outdir") } ||
                         (workflow.errorReport ?: '').contains("outdir") }
            )
        }
    }

    test("Should fail with empty samplesheet") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/empty_samplesheet.csv"
                outdir = "$outputDir"
                start = "preprocessing"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("Should handle single-sample samplesheet - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/single_sample.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir").exists() }
            )
        }
    }

    test("Should not drop rows whose patient_id has surrounding whitespace") {
        tag "stub"
        options "-stub"

        when {
            params {
                input  = "$projectDir/tests/testdata/whitespace_patient_id.csv"
                outdir = "$outputDir"
                start  = "preprocessing"
                stop   = "preprocessing"
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // both rows must reach preprocessing, not zero and not one
                { assert path("$outputDir/csv/preprocessed.csv").readLines().size() == 3 }  // header + 2
            )
        }
    }

    test("Should complete dry_run with zero process executions") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                dry_run = true
            }
        }

        then {
            assert workflow.success
        }
    }

    //==========================================================================
    // TEST PROFILE TESTS - Quick validation
    //==========================================================================

    test("Should run with test profile") {
        tag "real"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assert workflow.success
            assert path("$outputDir/csv/preprocessed.csv").exists()
        }
    }

    test("Should run with test profile - stub mode") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assert workflow.success
            assert path("$outputDir").exists()
        }
    }

    //==========================================================================
    // PREPROCESSING STEP TESTS
    //==========================================================================

    test("Should run preprocessing step - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false

                preproc_tile_size = 64
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir").exists() }
            )
        }
    }

    test("Should run preprocessing with multi-patient data") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_preprocessing.csv"
                outdir = "$outputDir"
                start = "preprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/csv").exists() }
            )
        }
    }

    //==========================================================================
    // REGISTRATION STEP TESTS
    //==========================================================================

    test("Should run registration from checkpoint") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                outdir = "$outputDir"
                start = "registration"

                max_cpus = 2
                max_memory = '6.GB'
                skip_registration_qc = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir").exists() }
            )
        }
    }

    test("Should run registration with VALIS method - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                outdir = "$outputDir"
                start = "registration"
                max_cpus = 2
                max_memory = '6.GB'
                skip_registration_qc = true
            }
        }

        then {
            assert workflow.success
        }
    }

    // Legacy registration methods (gpu, cpu, valis_pairs, cpu_tiled) moved to legacy/.
    // A "Should run registration with padding - stub" test used to live here; `padding`
    // was dropped along with PAD_IMAGES (e8c10b4) and nothing in the pipeline has read
    // `params.padding` since, so the test had become a byte-for-byte duplicate of
    // "Should run registration with VALIS method - stub" above, plus one dead param.
    // `validation.logging.unrecognisedParams = 'error'` in nextflow.config (task 1.5)
    // turned that dead param from silently-ignored into a launch failure, which is what
    // surfaced it -- removed rather than kept, since VALIS coverage above is identical.

    //==========================================================================
    // POSTPROCESSING STEP TESTS
    //==========================================================================

    test("Should run postprocessing from checkpoint - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_segmented.csv"
                outdir = "$outputDir"
                start = "postprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assert workflow.success
        }
    }

    //==========================================================================
    // VALIDATION TESTS - Input validation
    //==========================================================================

    test("Should fail with invalid start") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "invalid_step_name"
            }
        }

        then {
            assert workflow.failed
            assert workflow.errorMessage != null
        }
    }

    test("Should fail with invalid registration method") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                outdir = "$outputDir"
                start = "registration"
                registration_method = "invalid_method"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("Should reject missing DAPI channel") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/invalid_no_dapi.csv"
                outdir = "$outputDir"
                start = "preprocessing"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("VALIS refuses, at launch, a patient whose two slides share one channel set") {
        tag "stub"
        tag "channel_set"

        // RegisteredMatch pairs VALIS's renamed outputs back to their metas by channel
        // SET, so two slides with the same set are indistinguishable after REGISTER.
        // That was discovered by RegisteredMatch.pair -- after REGISTER had run the
        // whole 12-slide group (head_neck patient 046, 2026-09-11). dry_run proves the
        // refusal now happens in CsvUtils.validateInputSemantics, before any task.
        when {
            params {
                input = "$projectDir/tests/testdata/duplicate_channel_set.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                registration_method = "valis"
                dry_run = true
            }
        }

        then {
            assert workflow.failed
            def log = new File("${launchDir}/meta/nextflow.log").text
            assert log.contains("share the same channel set")
            assert log.contains("cd3|cd8|dapi")     // the signature, lower-cased and sorted
            assert log.contains("patient P001")
            assert log.contains("row 3") && log.contains("row 4")
        }
    }

    test("the tiled backend accepts the same duplicate-channel-set sheet") {
        tag "stub"
        tag "channel_set"

        // The constraint is VALIS's, not the pipeline's: the tiled adapter keeps each
        // slide's meta through its fan-out and never pairs by signature
        // (RegBackends.of('tiled').pairsOutputsBySignature is false).
        when {
            params {
                input = "$projectDir/tests/testdata/duplicate_channel_set.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                registration_method = "tiled"
                dry_run = true
            }
        }

        then {
            assert workflow.success
        }
    }

    test("a segmentation re-entry never applies the VALIS channel-set rule") {
        tag "stub"
        tag "channel_set"

        // --start segmentation reads a registered.csv this pipeline wrote; REGISTER does
        // not run, so the rule has nothing to protect and must not refuse the sheet.
        when {
            params {
                input = "$projectDir/tests/testdata/duplicate_channel_set_registered.csv"
                outdir = "$outputDir"
                start = "segmentation"
                registration_method = "valis"
                dry_run = true
            }
        }

        then {
            assert workflow.success
        }
    }

    test("Should reject a samplesheet that marks no reference") {
        tag "stub"

        // Unconditional now. This used to be half of a pair -- the other half asserted
        // that `allow_auto_reference = true` made the same sheet ACCEPTABLE by promoting
        // the patient's first row. That flag and that promotion are gone, so a sheet
        // naming no reference is refused on every path but add_cycle's, whose reference
        // is the prior run's and never a row in its own sheet.
        when {
            params {
                input = "$projectDir/tests/testdata/invalid_no_ref.csv"
                outdir = "$outputDir"
                start = "preprocessing"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("per-patient group sizes are not miscounted when the reference keeps its nuclear channel") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // The per-patient groupKey sizes come from
                // CsvUtils.countChannelsPerPatient, which drops the nuclear channel for
                // NON-reference rows. The REFERENCE keeps its own, so P001 counts
                // {DAPI,PANCK,SMA} + {CD3,CD8} = 5, not 4. (This case used to reach the
                // same 5 through --allow_auto_reference promoting an unmarked row; that
                // flag is gone, so it now runs the shipped path -- a declared reference --
                // and pins the same arithmetic.) Counting 4 instead would make
                // groupTuple emit at size and then emit the surplus as a SECOND group —
                // and the two per-patient consumers do NOT fail the same way:
                // MERGE_QUANT_CSVS's `.join(ch_morphology, by: 0)` (postprocess.nf) is a
                // keyed inner join, so the surplus group would be silently DISCARDED
                // (merged_quant.csv loses markers, no error); MERGE_AND_PYRAMID's
                // sized-group + remainder (postprocess.nf's ch_split_grouped) would instead
                // trip the memory closure (conf/modules.config:330-337) on the one-file
                // surplus and ABORT the run. See QUANTIFY_MARKERS' GROUP comment
                // (subworkflows/local/quantify_markers.nf) for the full account.
                // `assert workflow.success` alone does not see any of that, hence the
                // explicit task counts below, which pin the correct (non-miscounted) run.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }.size() == 5 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:MERGE_QUANT_CSVS') }.size() == 1 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:ASSEMBLE_EXPORT:MERGE_AND_PYRAMID') }.size() == 1 }
            )
        }
    }

    test("a non-reference CELLTOX slide is counted as one dropped nuclear channel") {

        tag "stub"
        options "-stub"

        when {
            params {
                // NOTE: nuclear_markers is deliberately NOT overridden. This runs on the
                // SHIPPED DEFAULT ['DAPI','CELLTOX'], whose CELLTOX half was unreachable
                // while every consumer hardcoded the literal 'DAPI'.
                input  = "$projectDir/tests/testdata/celltox_nonreference.csv"
                outdir = "$outputDir"
                start  = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Reference keeps {DAPI,PANCK,SMA}. The non-reference slide keeps
                // {CELLTOX,CD3,CD8}: CELLTOX matches params.nuclear_markers but the
                // REFERENCE never carried it, so nothing has claimed that name and it
                // survives. Six markers, six QUANTIFY tasks, ONE per-patient consumer.
                //
                // This assertion read 5 until the keep-set moved to
                // CsvUtils.resolveKeptChannelsPerSlide. The old rule dropped every
                // channel matching the configured nuclear list from every non-reference
                // slide, which silently discarded a cohort's second nuclear stain --
                // DAPI and CellTox Green measure different things, so they are not the
                // redundant copies that rule assumed.
                //
                // This is the count HALF of the invariant. The other half --
                // bin/split_multichannel.py emitting exactly these six in a real run --
                // is pinned by tests/unit/test_nuclear_markers.py, because the stub
                // block reads meta.keep_channels and so cannot see a Python-side
                // disagreement. Keep the two expectations in step.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }.size() == 6 },
                // This assertion would NOT catch an under-count by going to 2: this
                // MERGE_QUANT_CSVS is fed via postprocess.nf's `.join(ch_morphology, by: 0)`,
                // a keyed inner join, so an under-count's surplus groupTuple emission would
                // be silently DISCARDED (merged_quant.csv loses markers, no error, no second
                // task) rather than producing a second MERGE_QUANT_CSVS run. See
                // QUANTIFY_MARKERS' GROUP comment (subworkflows/local/quantify_markers.nf)
                // for the full per-caller account of what an under-count actually does.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:MERGE_QUANT_CSVS') }.size() == 1 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:ASSEMBLE_EXPORT:MERGE_AND_PYRAMID') }.size() == 1 }
            )
        }
    }

    test("a slide whose every channel is already claimed splits nothing") {

        tag "stub"
        options "-stub"

        when {
            params {
                // P001_ref carries DAPI|PANCK|SMA and is the reference; the moving slide
                // carries ONLY DAPI. CsvUtils.resolveKeptChannelsPerSlide therefore
                // resolves that slide's keep-set to the EMPTY list -- a legitimate answer
                // ("contributes no new markers"), which countChannelsPerPatient counts as
                // ZERO, giving the patient a channels_count of 3.
                input  = "$projectDir/tests/testdata/keepset_exhausted.csv"
                outdir = "$outputDir"
                start  = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // THE regression. While the lookup used `?:` (Groovy treats [] as falsy)
                // the empty keep-set was indistinguishable from an absent one, so the
                // slide was injected with its FULL declared list and DAPI was split and
                // quantified a SECOND time -- 4 QUANTIFY tasks against a channels_count of
                // 3, exit 0, and which slide's DAPI reached merged_quant.csv and the
                // pyramid decided by arrival order at the `.unique()` calls in
                // quantify_markers.nf / postprocess.nf. Watched failing at exactly 4
                // before the fix.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }.size() == 3 },
                // And the empty-keep-set slide is not split at all: ONE SPLIT_CHANNELS
                // task, not two. SPLIT_CHANNELS declares `path("*.tiff")` as a MANDATORY
                // output -- kept mandatory deliberately, since it is a real guard that a
                // genuinely failed split still trips -- so the slide is filtered out of
                // the process's input by postprocess.nf instead.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:SPLIT_CHANNELS') }.size() == 1 },
                // Exactly one DAPI, and the three names are the reference's panel.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }
                        .collect { it.name.replaceAll(/^.*\(P001 - (.*)\)$/, '$1') }.toSorted() ==
                        ['DAPI', 'PANCK', 'SMA'] },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:ASSEMBLE_EXPORT:MERGE_AND_PYRAMID') }.size() == 1 }
            )
        }
    }

    test("two slides sharing an image basename keep distinct keep-sets") {

        tag "stub"
        options "-stub"

        when {
            params {
                // cycle1/slide.ome.tiff (DAPI|CD3, reference) + cycle2/slide.ome.tiff
                // (DAPI|CD8). One directory per cycle is the ordinary cyclic-IF layout, so
                // a shared BASENAME across a patient's rows is not a pathological input.
                //
                // reg_qc=0 and skip_preprocess_qc are set because this sheet also trips a
                // SEPARATE, PRE-EXISTING defect that this branch does not fix: meta.id is
                // built from the image's simpleName, so both rows are `P001_slide` and the
                // per-slide QC artifacts collide by filename (WARP_SEG_QC at reg_qc=2,
                // else GENERATE_QC_REPORT's preprocess_qc PNGs). That late guard is NOT a
                // defence against the keep-set defect below -- it fires only after
                // postprocessing has already published a wrong pyramid and quant table --
                // which is exactly why this test disables the paths that carry it and
                // asserts on the keep-set directly.
                input  = "$projectDir/tests/testdata/duplicate_basename.csv"
                outdir = "$outputDir"
                start  = "preprocessing"
                reg_qc = 0
                skip_preprocess_qc = true
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Patient total is 3: the reference claims DAPI+CD3, cycle2 keeps CD8.
                // While resolveKeptChannelsPerSlide keyed its inner map on the BASENAME the
                // two rows overwrote each other, both looked up the single surviving entry,
                // and the run ABORTED with "No such file or directory: channels" after
                // publishing CD8.tiff alone and running ZERO QUANTIFY tasks. Watched
                // failing in exactly that way before the fix.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }.size() == 3 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }
                        .collect { it.name.replaceAll(/^.*\(P001 - (.*)\)$/, '$1') }.toSorted() ==
                        ['CD3', 'CD8', 'DAPI'] },
                // Both slides still split -- neither keep-set is empty here.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:SPLIT_CHANNELS') }.size() == 2 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:ASSEMBLE_EXPORT:MERGE_AND_PYRAMID') }.size() == 1 }
            )
        }
    }

    test("a CELLTOX-only samplesheet runs end to end under --nuclear_markers CELLTOX") {

        tag "stub"
        options "-stub"

        when {
            params {
                // No DAPI channel anywhere. CsvUtils used to reject this sheet before the
                // run started ("DAPI channel not found") and SEGMENT rejected it again at
                // runtime, so the marker list was configurable in name only.
                input           = "$projectDir/tests/testdata/celltox_only.csv"
                nuclear_markers = ['CELLTOX']
                outdir          = "$outputDir"
                start           = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // {CELLTOX,PANCK,SMA} from the reference + {CD3,CD8} from the moving
                // slide = 5, exactly as for the DAPI-configured sheet.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }.size() == 5 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:MERGE_QUANT_CSVS') }.size() == 1 }
            )
        }
    }

    test("a scalar --nuclear_markers is not iterated character by character") {

        tag "stub"
        options "-stub"

        when {
            params {
                // Nextflow hands `--nuclear_markers CELLTOX` through as a bare String.
                // Iterating it as a List yields the CHARACTERS C,E,L,L,T,O,X, and then
                // 'PANCK' matches on 'C' and is classified nuclear -- dropping a real
                // marker from every non-reference slide. MarkerUtils.markerList coerces
                // the scalar instead, so this must count the same 5 markers as the List
                // spelling above.
                input           = "$projectDir/tests/testdata/celltox_only.csv"
                nuclear_markers = 'CELLTOX'
                outdir          = "$outputDir"
                start           = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }.size() == 5 }
            )
        }
    }

    test("a comma-joined nuclear_markers element is split, not taken as one marker") {

        tag "stub"
        options "-stub"

        when {
            params {
                // The shape a params file produces when the list is written as a single
                // string. It is a valid Collection, so nothing coerces it -- unsplit, the
                // one marker 'CELLTOX,DAPI' matches NO channel, every channel is
                // classified non-reference-safe, and SPLIT_CHANNELS keeps the nuclear
                // channel on the moving slide. That emits SIX files against a groupTuple
                // sized 5 (the union dedupes CELLTOX, so the count is unchanged), which
                // is the surplus-second-group case: 6 QUANTIFY and TWO MERGE_QUANT_CSVS
                // writing the same merged_quant.csv. Silent -- no error anywhere.
                input           = "$projectDir/tests/testdata/celltox_only.csv"
                nuclear_markers = ['CELLTOX,DAPI']
                outdir          = "$outputDir"
                start           = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }.size() == 5 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:MERGE_QUANT_CSVS') }.size() == 1 }
            )
        }
    }

    test("Should reject missing checkpoint columns") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/invalid_checkpoint_missing_col.csv"
                outdir = "$outputDir"
                start = "registration"
            }
        }

        then {
            assert workflow.failed
        }
    }

