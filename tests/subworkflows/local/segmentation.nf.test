// SEGMENTATION and READ_SEGMENTED_CHECKPOINT take compartment_mode as input[1]. The
// "compartments off"/"no compartments" tests pass a literal map that conflicts with
// params (left at the true default), proving the workflow honours the argument rather
// than re-reading params.quantify_compartments. The other tests use
// ParamUtils.compartmentMode(params) as the baseline.

nextflow_workflow {

    name "Test SEGMENTATION subworkflow"
    script "subworkflows/local/segmentation.nf"
    workflow "SEGMENTATION"

    tag "subworkflow"
    tag "segmentation"

    test("Should segment the reference and write one checkpoint row per slide - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                seg_gpu = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001', is_reference: true,  channels: ['DAPI', 'PANCK', 'SMA']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', id: 'P001', is_reference: false, channels: ['DAPI', 'CD3', 'CD8']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')],
                    [[patient_id: 'P001', id: 'P001', is_reference: false, channels: ['DAPI', 'VIMENTIN', 'CD45']],
                     file('$projectDir/tests/testdata/P001_mov2.ome.tiff')]
                ])
                input[1] = ParamUtils.compartmentMode(params)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.cell_mask },
                { assert workflow.out.nuclei_mask },
                { assert workflow.out.contours },
                { assert workflow.out.checkpoint_csv },
                // One row per SLIDE (denormalised masks), not one per patient --
                // see segmentation.nf's own comment on ch_checkpoint_csv.
                { with(workflow.out.checkpoint_csv) {
                    def csv = get(0)
                    def lines = file(csv).readLines()
                    // 'id' is column 1; 'pixel_size' is appended last.
                    assert lines[0] == 'patient_id,id,registered_image,is_reference,channels,cell_mask,nuclei_mask,contours,nucleus_contours,pixel_size'
                    assert lines.drop(1).findAll { it.trim() }.size() == 3
                }}
            )
        }
    }

    test("Should record nuclei_mask unconditionally when --quantify_compartments is false - stub") {

        // SEGMENT always emits nuclei_mask regardless of --quantify_compartments, and
        // postprocess.nf's `ch_cell_mask.join(ch_nuclei_mask, by: 0)` is a plain join on
        // that invariant: withholding nuclei_mask empties it for every patient and
        // --start postprocessing exits 0 with no output. Only nucleus_contours may be
        // empty under this flag.

        tag "stub"
        options "-stub"

        when {
            params {
                // quantify_compartments/expanded_quantification left at their true
                // defaults; input[1] is a literal with compartments: false, so this
                // proves SEGMENTATION honours the argument. No module downstream reads
                // the raw param, so nothing else needs it to agree.
                outdir = "$outputDir"
                seg_gpu = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')]
                ])
                input[1] = [compartments: false, expanded: false, embedMasks: false]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { with(workflow.out.checkpoint_csv) {
                    def csv = get(0)
                    def row = file(csv).readLines()[1].split(',')
                    // patient_id, id, registered_image, is_reference, channels, cell_mask,
                    // nuclei_mask, contours, nucleus_contours
                    assert row[5] : "cell_mask must never be empty"
                    assert row[6] : "nuclei_mask must be populated even with --quantify_compartments false -- SEGMENT always produces it, and postprocess.nf's mask join depends on that"
                    assert row[7] : "contours must never be empty"
                    assert row.size() == 8 || row[8] == '' : "nucleus_contours is the one column allowed to be empty here"
                }}
            )
        }
    }

    test("Should error when no reference image is present - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                seg_gpu = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001', is_reference: false, channels: ['DAPI', 'CD3', 'CD8']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                input[1] = ParamUtils.compartmentMode(params)
                """
            }
        }

        then {
            assert !workflow.success
        }
    }
}

nextflow_workflow {

    name "Test READ_SEGMENTED_CHECKPOINT subworkflow"
    script "subworkflows/local/segmentation.nf"
    workflow "READ_SEGMENTED_CHECKPOINT"

    tag "subworkflow"
    tag "segmentation"
    tag "read_segmented_checkpoint"

    test("Should read samples and re-derive contours/morphology from checkpoint masks - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                seg_gpu = false
            }
            workflow {
                """
                input[0] = "$projectDir/tests/testdata/valid_checkpoint_segmented.csv"
                input[1] = ParamUtils.compartmentMode(params)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Two rows in the fixture (reference + one moving slide) -> two samples.
                { with(workflow.out.samples) { assert size() == 2 } },
                // Mask/contour/morphology channels are per-PATIENT (reference row
                // only), so exactly one each for the single-patient fixture.
                { with(workflow.out.cell_mask)   { assert size() == 1 } },
                { with(workflow.out.nuclei_mask) { assert size() == 1 } },
                { with(workflow.out.contours)    { assert size() == 1 } },
                { with(workflow.out.morphology)  { assert size() == 1 } },
                { assert workflow.out.versions },
                { assert workflow.out.size_logs }
            )
        }
    }

    test("Should keep nuclei_mask populated but nucleus_contours empty when the checkpoint recorded no compartments - stub") {

        // Read-side twin of the case above: a checkpoint written with
        // --quantify_compartments false still has a populated nuclei_mask column, and
        // the reader must not drop it because nucleus_contours is blank.
        tag "stub"
        options "-stub"

        when {
            params {
                // Params left at their true defaults; input[1] is a literal with
                // compartments: false, proving READ_SEGMENTED_CHECKPOINT honours the
                // argument (which gates whether EXTRACT_NUCLEI_PROPERTIES runs).
                outdir = "$outputDir"
                seg_gpu = false
            }
            workflow {
                """
                input[0] = "$projectDir/tests/testdata/valid_checkpoint_segmented_no_compartments.csv"
                input[1] = [compartments: false, expanded: false, embedMasks: false]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { with(workflow.out.cell_mask)   { assert size() == 1 } },
                { with(workflow.out.nuclei_mask) { assert size() == 1 } },
                // quantify_compartments false -> EXTRACT_NUCLEI_PROPERTIES never runs,
                // so nucleus_contours is empty (Channel.empty()), not merely unfiltered.
                { with(workflow.out.nucleus_contours) { assert size() == 0 } }
            )
        }
    }
}
