/*
========================================================================================
    Process-specific Resource Configuration
========================================================================================
    Resource allocation for each process.
    Error strategy and maxRetries are inherited from conf/base.config.
========================================================================================
*/

// Shared logic is inlined at each call site: Nextflow 26's strict parser rejects a `def`
// or a top-level closure in a config file, and conf/*.config cannot see lib/*.groovy
// classes (the name resolves silently against ConfigObject and fails when the closure runs).

/*
================================================================================
    STARE (tiled) per-task memory, derived from the parameter that sets it
================================================================================
    Each tiled task reads a bounded window, so peak RSS depends on the window parameter,
    not on the slide. Measured peak RSS (uint16, one channel per task) is linear in window
    megapixels over a ~0.3-0.6 GB baseline:
      REG_TILE ~= 0.5 GB + 0.13 GB/Mpx   (window = tile + 2*max(halo, 3*stride))
      STITCH   ~= 0.6 GB + 0.17 GB/Mpx   (window = out_tile)
    Each request is that line doubled, floored at 4 GB. `-stub` never runs these closures;
    check a change with a real run and the trace's memory column.
*/

process {

    /*
    ================================================================================
        Default Publishing Settings
    ================================================================================
    */

    // Every process sets its own publishDir below. This default catches one that does not:
    // tests/test_layout.py fails the build if anything reaches _UNROUTED_PUBLISH.
    publishDir = [
        path: { "${params.outdir}/_UNROUTED_PUBLISH/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    /*
    ================================================================================
        Resource Labels (used by processes)
    ================================================================================
    */

    withLabel: 'process_single' {
        cpus   = { 1                   }
        memory = { 12.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }

    withLabel: 'process_low' {
        cpus   = { 2                     }
        memory = { 32.GB * task.attempt  }
        time   = { 2.h   * task.attempt  }
    }

    withLabel: 'process_medium' {
        cpus   = { 4                               }
        memory = { 100.GB + 100.GB * task.attempt  }
        time   = { 4.h   * task.attempt            }
    }

    withLabel: 'process_high' {
        cpus   = { 8                               }
        memory = { 200.GB + 100.GB * task.attempt  }
        time   = { 12.h  * task.attempt            }
    }

    /*
    ================================================================================
        Pipeline Info
    ================================================================================
    */

    /*
    ================================================================================
        QC processes: retry signals, then fail the run
    ================================================================================
        A missing QC output never deadlocks the DAG, but a broken QC task still fails
        the run so a green run implies a complete output tree. 'finish' lets in-flight
        tasks drain. maxRetries is pinned to match the closure's cutoff.
    */
    withName: 'GENERATE_PREPROCESS_QC|GENERATE_REGISTRATION_QC|GENERATE_POSTPROCESSING_QC|GENERATE_QC_REPORT|SEG_QC_SEGMENT|SEG_QC_GEOJSON|WARP_SEG_QC' {
        maxRetries    = 3
        // POLICY: retry-then-fail (tests/test_error_strategy_policy.py).
        // 130..145 is the whole killed-by-signal range; 140 is SLURM's pre-walltime SIGUSR2.
        errorStrategy = { task.exitStatus in ((130..145) + 104) && task.attempt <= 3 ? 'retry' : 'finish' }
    }

    /*
    ================================================================================
        Pipeline Processes
    ================================================================================
    */

    withName: 'PREFLIGHT_SCALE' {
        // publishDir only: resources come from the module's label.
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: 'copy',
            pattern: "preflight_scale_report.json"
        ]
    }

    withName: 'CONVERT_IMAGE' {
        cpus   = 1
        memory = {
            def file_gb = (image_file.size() >> 30) ?: 1
            (file_gb < 4 ? 64.GB : file_gb < 12 ? 88.GB : file_gb < 80 ? 96.GB : 160.GB) + 24.GB * task.attempt
        }
        time   = { 2.h  * task.attempt }
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/converted" },
            // Intermediate: published only at --cleanup_level=none (Layout.FINAL_KINDS owns
            // the split; tests/test_cleanup_publish_gates.py checks every copy).
            // Gate in `saveAs:`, never `enabled:`: a closure there is coerced to false, and a
            // plain boolean freezes before profiles and `-c` files are merged.
            saveAs: { fn -> params.cleanup_level == 'none' ? fn : null },
            mode: 'copy',
            pattern: "*.ome.tif"
        ]
    }

    withName: 'TILE_FOR_BASIC' {
        cpus   = 2
        // Streams one pseudo-FOV at a time: O(preproc_tile_size^2), independent of slide size
        // and channel count. Assumes a tiled input OME-TIFF; an untiled one (e.g. an older
        // --prior_outdir) decodes whole planes and relies on the retry ramp.
        memory = {
            def tile    = (params.preproc_tile_size as long)
            def buffers = 4d * tile * tile * 8d / (1024d * 1024d * 1024d)
            (Math.ceil(Math.max(6d, buffers)) as int).GB * task.attempt
        }
        time   = { 2.h * task.attempt }
        ext.args = ''
        // Intermediates consumed by BASICPY and APPLY_PROFILES.
        publishDir = [ enabled: false ]
    }

    /*
        BASICPY is modules/nf-core/basicpy, vendored unmodified (see its MIRAGE-NOTES.md).

        `ext.args` is empty on purpose: BASICPY runs at UPSTREAM DEFAULTS. Do not restore
        mirage's earlier parameters. Upstream sets get_darkfield to False, so no darkfield
        is estimated; the emitted darkfield file is all zeros and bin/apply_basic_profiles.py
        logs that. Autotune is off by default, and its CLI flag is inverted (passing it turns
        autotune ON), so pass nothing.
    */
    withName: 'BASICPY' {
        // Partial override: the module's label owns cpus and time. The Bio-Formats JVM plus
        // one channel's tile stack does not fit 12 GB on a real slide.
        memory = { 32.GB * task.attempt }
        // Empty on purpose: upstream defaults. See the block comment above.
        ext.args = ''
        // Same image the vendored module names, pinned by digest only (Singularity mishandles
        // tag@digest). Overridden here so the vendored module.nf stays byte-for-byte upstream.
        container = 'docker.io/labsyspharm/basicpy-docker-mcmicro@sha256:355b14e2ec80b7b152272f333afd47234f007d0d37633b3ec948e87ec2c8e9b4'
        publishDir = [ enabled: false ]
    }

    withName: 'APPLY_PROFILES' {
        cpus   = 2
        // Streams one 2048 px output tile at a time (bin/apply_basic_profiles.py; its
        // maxworkers=1 write pin keeps tifffile from queueing tiles). Two terms:
        //  * profile planes: 2 * C * preproc_tile_size^2 * 8 bytes (float64 flat + dark),
        //    with C assumed 16; a wider panel relies on the retry ramp.
        //  * write-tile buffers, O(2048^2).
        // Same tiled-input assumption as TILE_FOR_BASIC.
        memory = {
            def tile     = (params.preproc_tile_size as long)
            def profiles = 2d * 16d * tile * tile * 8d / (1024d * 1024d * 1024d)
            def buffers  = 4d * 2048d * 2048d * 8d / (1024d * 1024d * 1024d)
            (Math.ceil(Math.max(8d, profiles + buffers)) as int).GB * task.attempt
        }
        time   = { 3.h * task.attempt }
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/preprocessed" },
            // Intermediate — see tests/test_cleanup_publish_gates.py.
            saveAs: { fn -> params.cleanup_level == 'none' ? fn : null },
            mode: 'copy',
            pattern: "*_corrected.ome.tif"
        ]
    }

    withName: 'GENERATE_PREPROCESS_QC' {
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/qc/preprocess" },
            mode: 'copy',
            pattern: "qc/*.png"
        ]
    }

    withName: 'GENERATE_POSTPROCESSING_QC' {
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/qc/postprocessing" },
            mode: 'copy',
            pattern: "qc/*.png"
        ]
    }

    withName: 'GENERATE_QC_REPORT' {
        // Never cacheable: its inputs come from collectFile(), which writes fresh files every
        // run, and run_summary.json embeds a timestamp.
        cache = false
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'REGISTER' {
        cpus   = 8
        // valis-wsi rewrites a file inside its package on every JVM start, and Singularity
        // mounts the image read-only; --writable-tmpfs gives it a throwaway overlay.
        containerOptions = { workflow.containerEngine in ['singularity', 'apptainer'] ? '--writable-tmpfs' : '' }
        // First attempt sized per VALIS mode, then doubled per attempt. Measured peak RSS on
        // the regbench cohort: default max 51.4 GB -> 64 GB; hires max 106.4 GB -> 128 GB.
        // maxRetries is pinned so the ramp is the same on every profile; resourceLimits clamps.
        maxRetries = 3
        memory = {
            (params.reg_valis_mode == 'hires' ? 128.GB : 64.GB) * (2 ** (task.attempt - 1))
        }
        time   = { 24.h * task.attempt }
        // POLICY: retry-exit1-then-fail. VALIS tile-read failures and JVM OOMs exit 1,
        // so the cause selector cannot be narrowed.
        errorStrategy = {
            task.exitStatus in [1, 104, 134, 135, 137, 139, 140, 143] ? 'retry' : 'finish'
        }

        publishDir = [
            [
                path: { "${params.outdir}/${meta.patient_id}/registered" },
                // Intermediate — see tests/test_cleanup_publish_gates.py.
                saveAs: { fn -> params.cleanup_level == 'none' ? fn : null },
                mode: 'copy',
                pattern: "registered_slides/*_registered.ome.tiff"
            ],
            [
                path: { "${params.outdir}/${meta.patient_id}/registered/summary" },
                mode: 'copy',
                pattern: "preprocessed/data/*.csv"
            ],
            [
                // The VALIS registrar pickle: the whole transform for this backend (the
                // counterpart of TILED_SOLVE's manifest), needed to score a run externally.
                path: { "${params.outdir}/${meta.patient_id}/registered/transform" },
                mode: 'copy',
                pattern: "preprocessed/data/*_registrar.pickle"
            ]
        ]
        // maxForks is set in nextflow.config's "Concurrency" block.
    }

    // STARE (tiled) processes, all JVM-free. TILED_COARSE's anchor JSON is intermediate and
    // unpublished. TILED_REG_TILE's per-tile control-point JSON is published: it is the only
    // record of the per-tile window vectors and their peak ratios (a few KB per tile).
    withName: 'TILED_REG_TILE' {
        // Peak is the read window, never the slide. Measured: stride 64 -> 2432^2 window,
        // 1.27 GB; stride 128 -> 1.65 GB; stride 256 -> 2.17 GB.
        memory = {
            // window = tile + 2*max(halo, 3*stride), in Mpx; GB = 2 * (0.5 + 0.13*Mpx), floor 4.
            def _tile = params.reg_tiled_tile as int
            def _halo = params.reg_tiled_halo as int
            def _margin = Math.max(_halo, 3 * (params.reg_tiled_stride as int))
            def win = ((_tile + 2 * _margin) as long)
            def mpx = (win * win) / 1_000_000d
            (Math.ceil(Math.max(4d, (0.5d + 0.13d * mpx) * 2d)) as int).GB * task.attempt
        }
        // maxForks is set in nextflow.config's "Concurrency" block.
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/registered/controls" },
            mode: 'copy',
            pattern: "*_ctrl.json"
        ]
    }
    /*
        TILED_COARSE estimates M0 on a thumbnail bounded by params.reg_tiled_coarse_max_dim,
        read in row bands, so its peak is set by that bound. Measured peak of the whole stage:
        0.25-0.43 GB at 512-2048 px. The request is 2 x (0.5 + 0.1 * Mpx) GB, floored at
        2 GB (5 GB at 4096 px). The retry ramp is linear because the peak is already bounded.
    */
    withName: 'TILED_COARSE' {
        memory = {
            // Values below 256 are refused at launch (ParamUtils.validateStareKnobs).
            def _dim = params.reg_tiled_coarse_max_dim as int
            def mpx  = ((_dim as long) * (_dim as long)) / 1_000_000d
            (Math.ceil(Math.max(2d, (0.5d + 0.1d * mpx) * 2d)) as int).GB * task.attempt
        }
        // maxForks is set in nextflow.config's "Concurrency" block.
        // Nothing to publish: TILED_SOLVE consumes the anchor JSON.
        publishDir = [ enabled: false ]
    }
    withName: 'TILED_SOLVE' {
        // Measured solve peak 0.19-1.20 GB on the regbench cohort; 1 GB OOMed on attempt 1.
        memory = { 2.GB * task.attempt }
        // Range gate on the window vectors. reg_tiled_max_disp = null derives it from
        // reg_tiled_halo. Explicit null test, not `?:`: 0 is a valid value and falsy in Groovy.
        ext.args = {
            def _halo = params.reg_tiled_halo as int
            def maxDisp = params.reg_tiled_max_disp != null ? params.reg_tiled_max_disp : _halo
            "--max-disp ${maxDisp}"
        }
        publishDir = [
            [
                path: { "${params.outdir}/${meta.patient_id}/registered/manifest" },
                mode: 'copy',
                pattern: "*_manifest.json"
            ],
            [
                path: { "${params.outdir}/${meta.patient_id}/qc/registration" },
                mode: 'copy',
                pattern: "*_tre.json"
            ]
        ]
    }
    withName: 'TILED_STITCH' {
        // Peak is one output tile plus its source crop. Measured 1.42 GB at the 1024^2 default.
        memory = {
            // window = out_tile, in Mpx; GB = 2 * (0.6 + 0.17*Mpx), floor 4.
            def _out = params.reg_tiled_out_tile as int
            def win = (_out as long)
            def mpx = (win * win) / 1_000_000d
            (Math.ceil(Math.max(4d, (0.6d + 0.17d * mpx) * 2d)) as int).GB * task.attempt
        }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/registered" },
            // Intermediate — see tests/test_cleanup_publish_gates.py.
            saveAs: { fn -> params.cleanup_level == 'none' ? fn : null },
            mode: 'copy',
            pattern: "registered/*_registered.ome.tiff"
        ]
        // maxForks is set in nextflow.config's "Concurrency" block.
    }

    withName: 'GENERATE_REGISTRATION_QC' {
        cpus   = 1
        memory = {
            // All three input images are held at once, so all three are summed.
            def input_gb = ((registered.size() + native_image.size() + reference.size()) >> 30) ?: 1
            (input_gb < 20 ? 64.GB : input_gb < 50 ? 150.GB : 200.GB) * task.attempt
        }
        publishDir = [
            [
                path: { "${params.outdir}/${meta.patient_id}/qc/registration" },
                mode: 'copy',
                pattern: "qc/*_QC_RGB.{png,tif}"
            ],
            [
                path: { "${params.outdir}/${meta.patient_id}/qc/registration" },
                mode: 'copy',
                pattern: "qc/*_QC_RGB_fullres.tif"
            ]
        ]
    }

    // reg_qc=2: cell-mask label image -> cell GeoJSON (CPU-only contour tracing).
    withName: 'SEG_QC_GEOJSON' {
        // Must equal EXTRACT_CELL_PROPERTIES' tolerance: WARP_SEG_QC compares the two.
        ext.args = { "--tolerance ${params.simplify_tolerance}" }
        // Same one-mask working set as EXTRACT_CELL_PROPERTIES.
        cpus   = 1
        memory = { 64.GB * task.attempt }
        time   = { 4.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/qc/registration/geojson" },
            mode: 'copy',
            pattern: "*.geojson"
        ]
    }

    // reg_qc=2: warp cell polygons through each registration stage and score fixed cell pairs.
    // IoU is computed per pair in its own bounding box, so memory does not scale with slide
    // area; 32 GB covers the JVM heap, the valis import and the vertex arrays. One process
    // serves both backends (lib/WarpBackends.groovy), so it is sized for VALIS. A per-backend
    // split must key off the `method` input, never params.registration_method.
    withName: 'WARP_SEG_QC' {
        cpus   = 2
        memory = { 32.GB * (2 ** (task.attempt - 1)) }   // 32 / 64 / 128 / 256
        time   = { 3.h * task.attempt }                   // 3 / 6 / 9 / 12 h
        // See REGISTER: the VALIS backend's JVM needs a writable image. Harmless on tiled.
        containerOptions = { workflow.containerEngine in ['singularity', 'apptainer'] ? '--writable-tmpfs' : '' }
        // Backend-independent tunables only. VALIS-only flags come from lib/WarpBackends.groovy,
        // keyed on the `method` input.
        ext.args = { "--pairing ${params.seg_qc_pairing} --match-radius-factor ${params.seg_qc_match_radius_factor}" }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/qc/registration" },
            mode: 'copy',
            pattern: "*_seg_qc.json"
        ]
    }

    /*
    ================================================================================
        Reference-free cell-segmentation quality scoring (CSE, 2D) — OPT-IN
    ================================================================================
        Not in the QC selector above. CSE is opt-in, usually fails on memory, and its
        absence degrades the QC report only, so it retries whatever the cause and then
        drops. main.nf's onComplete reports the dropped-task count.
    */
    withName: 'SEG_QUALITY_EVAL' {
        // No label: this block owns cpus, memory and time.
        cpus   = 8
        memory = {
            // Peak is driven by CSE's per-pixel index structures on the decompressed masks,
            // not the compressed file size, so the first attempt is sized generously.
            def file_gb = (image.size() >> 30) ?: 1
            (file_gb < 10 ? 128.GB : file_gb < 30 ? 256.GB : 448.GB) * task.attempt
        }
        time   = { 4.h * task.attempt }
        maxRetries = 3
        // POLICY: retry-then-drop. Do not log from here: `log` is unbound in config scope on
        // Nextflow 25 and throws, aborting the run.
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        ext.when = { !params.skip_seg_quality_eval }
        // Cap scored pixels so CSE fits its memory/time budget on full-WSI masks.
        ext.args = { params.cse_max_pixels ? "--max-pixels ${params.cse_max_pixels}" : '' }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/qc/segmentation" },
            mode: 'copy',
            pattern: "*_seg_eval.json"
        ]
    }

    withName: 'MERGE_SEG_EVAL' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
        maxRetries = 3
        // POLICY: retry-then-drop. Only collates per-patient CSE scores already published
        // under qc/segmentation/; nothing downstream reads it. Do not log from here.
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        ext.when = { !params.skip_seg_quality_eval }
        publishDir = [
            path: { "${params.outdir}/qc/segmentation" },
            mode: 'copy',
            pattern: "*.csv"
        ]
    }

    // NOTE: mode=add_cycle reuses EXPORT_GEOJSON / MERGE_AND_PYRAMID / MERGE_QUANT_CSVS
    // publishDir rules below. Run add_cycle with a fresh --outdir; combined outputs
    // (all cycles) are written there, leaving the prior run's outdir intact as the
    // --prior_outdir checkpoint source.
    withName: 'MERGE_AND_PYRAMID' {
        cpus   = 2
        // Streams tiles and never assembles the (C, H, W) stack (bin/merge_channels_pyramid.py,
        // including its maxworkers=1 write pin). Terms, with plane = one decoded channel:
        //  * 3.25 planes for one float32 base plane and its downsampling transients (measured
        //    intercept 3.21). Irreducible: a pyramid level must come from a whole plane.
        //  * levels 2+ for every channel, held while tifffile fills the SubIFDs; geometric in
        //    pyramid_scale, zero at pyramid_resolutions <= 2.
        //  * one 64 MiB read band, the write-tile buffers and one uint32 mask band (+1 GB).
        //
        // plane = 4 x the largest channel file. 4:1 is a low guess, not a bound: measured
        // compression runs from 1x (noise) to ~4x (mostly black) and far higher for an empty
        // channel. The exit-137 retry ramp (conf/base.config) covers up to a 4x shortfall;
        // beyond that the task fails loudly. Measure r = (H*W*2)/file_size on real slides to
        // raise the coefficient.
        memory = {
            // A one-file group binds a bare Path, not a List; normalise before collecting.
            def files    = (split_channels instanceof Collection) ? split_channels : [split_channels]
            def sizes    = files.collect { it.size() }
            def largest  = sizes ? sizes.max() : 0L
            def plane    = (largest * 4d) / (1024d * 1024d * 1024d)
            def scale    = (params.pyramid_scale as double)
            def ratio    = 1d / (scale * scale)
            // Sum of the stashed levels as a geometric series taken to its limit: an upper
            // bound on the finite sum, tight to within `ratio ** (levels - 2)`.
            def stash    = (params.pyramid_resolutions as int) > 2 ?
                           sizes.size() * plane * ratio * ratio / (1d - ratio) : 0d
            (Math.ceil(Math.max(8d, plane * 3.25d + stash + 1d)) as int).GB * task.attempt
        }
        time   = { 8.h * task.attempt }

        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/pyramid" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Also matches SEG_QC_SEGMENT, the reg_qc=2 alias of this process: a selector matches an
    // alias' own name and its original process name. Everything here is shared with the alias
    // except publishDir, which the SEG_QC_SEGMENT block below overrides.
    withName: 'SEGMENT' {
        // Per-backend tool arguments, keyed on params.seg_method. Backend identity and resolved
        // flags (prefix, nuclear index) live in lib/SegBackends.groovy.
        ext.args = {
            def flags = [
                // tests/modules/segment.nf.test pins the rendered flag string.
                stardist  : [
                    // The default model is a pinned Hugging Face snapshot, downloaded into
                    // --model-dir (or the task dir) and used offline if already there. A plain
                    // name is a folder under --model-dir or a StarDist built-in.
                    params.segmentation_model_dir ? "--model-dir ${params.segmentation_model_dir}" : '',
                    "--model-name ${params.segmentation_model}",
                    "--n-tiles ${params.seg_n_tiles_y} ${params.seg_n_tiles_x}",
                    "--expand-distance ${params.seg_expand_distance}",
                    "--pmin ${params.seg_pmin}",
                    "--pmax ${params.seg_pmax}",
                    // Detection probability threshold (lower = detect fainter nuclei).
                    // null -> use the model's built-in default.
                    params.seg_prob_thresh != null ? "--prob-thresh ${params.seg_prob_thresh}" : '',
                ],
                instantseg: [
                    "--model-name ${params.seg_instantseg_model}",
                    "--target ${params.seg_instantseg_target}",
                    // meta.pixel_size (resolved by PREFLIGHT_SCALE), not params.pixel_size,
                    // which may be the string 'auto'.
                    "--pixel-size ${meta.pixel_size}",
                    "--tile-size ${params.seg_instantseg_tile_size}",
                    "--batch-size ${params.seg_instantseg_batch_size}",
                ],
                cellsam   : [
                    "--expand-distance ${params.seg_expand_distance}",
                    "--bbox-threshold ${params.seg_cellsam_bbox_threshold}",
                    "--block-size ${params.seg_cellsam_block_size}",
                    "--overlap ${params.seg_cellsam_overlap}",
                    // use_wsi toggles CellSAM's native tiling; model_path points at
                    // pre-downloaded weights (omit -> auto-download, needs a token).
                    params.seg_cellsam_use_wsi ? '--use-wsi' : '',
                    params.cellsam_model_path ? "--model-path ${params.cellsam_model_path}" : '',
                ],
            ]
            // All three entry points take --use-gpu, so it is shared rather than repeated.
            ((flags[params.seg_method] ?: []) + [params.seg_gpu ? '--use-gpu' : ''])
                .findAll { it }.join(' ')
        }
        // 8 CPUs so a CPU path (or CPU-bound pre/post steps like label expansion
        // and Dask tiling) is tolerable; GPU inference is unaffected by this.
        cpus   = 8
        memory = {
            def file_gb = (merged_file.size() >> 30) ?: 1
            (file_gb < 10 ? 32.GB : file_gb < 30 ? 64.GB : 128.GB) * task.attempt
        }
        time   = { 4.h * task.attempt }
        // This replaces the slurm profile's clusterOptions, so --account/--qos are repeated
        // here. Cannot compose via task.clusterOptions (it recurses).
        // tests/test_cluster_options_compose.py keeps the two in step.
        clusterOptions   = {
            def opts = []
            if (params.slurm_account && params.slurm_account != '') opts << "--account=${params.slurm_account}"
            if (params.slurm_qos && params.slurm_qos != '')         opts << "--qos=${params.slurm_qos}"
            if (params.seg_gpu)                                     opts << "--gres=gpu:${params.gpu_type}"
            return opts ? opts.join(' ') : null
        }
        // GPU: Singularity needs --nv, Docker --gpus all; without it the GPU is not visible.
        // CellSAM on Docker forwards DEEPCELL_ACCESS_TOKEN by name only, so its value never
        // lands in .command.run (Singularity does the same via singularity.envWhitelist).
        containerOptions = {
            def opts = []
            if (params.seg_gpu) opts << (workflow.containerEngine == 'docker' ? '--gpus all' : '--nv')
            if (params.seg_method == 'cellsam' && workflow.containerEngine == 'docker' && System.getenv('DEEPCELL_ACCESS_TOKEN')) {
                opts << '-e DEEPCELL_ACCESS_TOKEN'
            }
            opts.join(' ')
        }
        // Publish masks where the postprocessing checkpoint CSV records them.
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/segmentation" },
            // Intermediate — see tests/test_cleanup_publish_gates.py.
            mode: 'copy',
            saveAs: { fn -> (params.cleanup_level == 'none' && !fn.equals('versions.yml')) ? fn : null }
        ]
    }

    // The reg_qc=2 QC segmentation (SEGMENT as SEG_QC_SEGMENT). Overrides two fields of the
    // SEGMENT block; must stay textually after it (later selectors win per field).
    withName: 'SEG_QC_SEGMENT' {
        // Per-slide QC masks from the native images, consumed by SEG_QC_GEOJSON. Not published:
        // <pid>/segmentation/ is indexed by csv/segmented.csv, one mask per patient.
        publishDir = [ enabled: false ]
        // Per-slide prefix, so the slides of one patient get distinct size logs and masks.
        ext.prefix = { "${meta.qc_slide}" }
    }

    withName: 'SPLIT_CHANNELS' {
        cpus   = 1
        memory = {
            def file_gb = (registered_image.size() >> 30) ?: 1
            (file_gb < 5 ? 32.GB : file_gb < 15 ? 64.GB : 128.GB) * task.attempt
        }
        time   = { 2.h * task.attempt }
        // Per-patient: outputs are named by channel alone ('PANCK.tiff').
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/split_channels" },
            // Intermediate — see tests/test_cleanup_publish_gates.py.
            mode: 'copy',
            saveAs: { fn -> (params.cleanup_level == 'none' && !fn.equals('versions.yml')) ? fn : null }
        ]
    }

    // add_cycle's SPLIT_PRIOR_PYRAMID alias of SPLIT_CHANNELS also matches the block above.
    // This block gives it its own directory so the two do not overwrite each other's
    // channel files. Must stay after the SPLIT_CHANNELS block; resources stay inherited.
    withName: 'SPLIT_PRIOR_PYRAMID' {
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/split_channels/prior" },
            // Intermediate — see tests/test_cleanup_publish_gates.py.
            mode: 'copy',
            saveAs: { fn -> (params.cleanup_level == 'none' && !fn.equals('versions.yml')) ? fn : null }
        ]
    }

    withName: 'EXTRACT_MASK_SERIES' {
        // add_cycle only: reads the mask series out of a prior run's pyramid. Unprefixed
        // filenames, so publish per patient. Sharing segmentation/ with SEGMENT is safe:
        // add_cycle never runs SEGMENT and requires a fresh --outdir.
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/segmentation" },
            // Intermediate — see tests/test_cleanup_publish_gates.py.
            mode: 'copy',
            saveAs: { fn -> (params.cleanup_level == 'none' && !fn.equals('versions.yml')) ? fn : null }
        ]
    }

    withName: 'EXTRACT_CELL_PROPERTIES' {
        cpus   = 1
        memory = { 64.GB * task.attempt }
        time   = { 12.h * task.attempt }
        // Slimmer GeoJSON (faster QuPath import); polygons are display-only.
        ext.args = { "--simplify_tolerance ${params.simplify_tolerance} --coord_precision ${params.geojson_coord_precision}" }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/cell_properties" },
            // Intermediate — see tests/test_cleanup_publish_gates.py.
            mode: 'copy',
            saveAs: { fn -> (params.cleanup_level == 'none' && !fn.equals('versions.yml')) ? fn : null }
        ]
    }

    withName: 'EXTRACT_NUCLEI_PROPERTIES' {
        cpus   = 1
        memory = { 64.GB * task.attempt }
        time   = { 12.h * task.attempt }
        // Same slimmer contour settings for the nucleus polygons.
        ext.args = { "--simplify_tolerance ${params.simplify_tolerance} --coord_precision ${params.geojson_coord_precision}" }
        // The process writes into a nuclei/ subdirectory, which publishDir preserves:
        // files land in .../cell_properties/nuclei/.
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/cell_properties" },
            // Intermediate — see tests/test_cleanup_publish_gates.py.
            mode: 'copy',
            saveAs: { fn -> (params.cleanup_level == 'none' && !fn.equals('versions.yml')) ? fn : null }
        ]
    }

    withName: 'QUANTIFY' {
        cpus   = 1
        memory = { 150.GB * task.attempt }
        time   = { 12.h * task.attempt }
        // Median is always computed. --expanded adds Mean + Sum per compartment;
        // independent of quantify_compartments.
        ext.args = { params.expanded_quantification ? '--expanded' : '' }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/quantify" },
            // Intermediate — see tests/test_cleanup_publish_gates.py.
            mode: 'copy',
            saveAs: { fn -> (params.cleanup_level == 'none' && !fn.equals('versions.yml')) ? fn : null }
        ]
    }

    withName: 'NUCLEAR_RETENTION' {
        // Same footprint as one QUANTIFY task: one full-resolution plane plus both masks.
        cpus   = 1
        memory = { 128.GB * task.attempt }
        time   = { 12.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/quantify" },
            // Intermediate — see tests/test_cleanup_publish_gates.py.
            mode: 'copy',
            saveAs: { fn -> (params.cleanup_level == 'none' && !fn.equals('versions.yml')) ? fn : null }
        ]
    }

    withName: 'EXPORT_GEOJSON' {
        cpus   = 1
        memory = { 32.GB * task.attempt }
        time   = { 2.h * task.attempt }
        // Rendered after the script's own --pixel_size, and argparse keeps the last one, so
        // this must carry the resolved meta.pixel_size, not params.pixel_size ('auto').
        ext.args = { "--pixel_size ${meta.pixel_size}" }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/geojson" },
            mode: 'copy'
        ]
    }

    withName: 'EXPORT_SPATIALDATA' {
        // The process already emits under spatialdata/, so publish at the patient root.
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}" },
            mode: 'copy',
            pattern: "spatialdata/**"
        ]
        time   = { 4.h * task.attempt }
    }

    /*
    ================================================================================
        Pixie Clustering Processes
    ================================================================================
    */

    withName: 'MERGE_QUANT_CSVS' {
        // Superseded by CELL_QC, which republishes this table augmented with the
        // "QC: ..." columns under the SAME name. Publishing both would race on one path.
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/quantification" },
            mode: 'copy',
            saveAs: { filename -> null }
        ]
    }

    withName: 'CELL_QC' {
        // Residual join radius: the same param EXPORT_SPATIALDATA uses, so both
        // outputs pair a QC nucleus to the same cell.
        ext.args = { "--join-max-px ${params.spatialdata_residual_join_max_px}" }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/quantification" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Unlike every other block, no versions.yml filter: <outdir>/size_logs/versions.yml is
    // published and its contents are part of the shipped output.
    withName: 'AGGREGATE_SIZE_LOGS' {
        // Never cacheable: its inputs come from collectFile(), which writes fresh files every run.
        cache = false
        publishDir = [
            path: { "${params.outdir}/size_logs" },
            mode: 'copy'
        ]
    }

}
